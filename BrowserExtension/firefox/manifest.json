{
  "manifest_version": 3,
  "name": "Plex Requests Browser Capture",
  "short_name": "PR Capture",
  "version": "1.1.0",
  "description": "Captures 1337x listings you browse and safely resolves their release details for Plex Requests.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-capture@plexrequests.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "searchTerms"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://1337x.to/*",
    "*://*.1337x.to/*",
    "*://1337x.st/*",
    "*://*.1337x.st/*",
    "*://1337x.ws/*",
    "*://*.1337x.ws/*",
    "*://1337x.eu/*",
    "*://*.1337x.eu/*",
    "*://1337x.se/*",
    "*://*.1337x.se/*",
    "*://1337x.so/*",
    "*://*.1337x.so/*",
    "*://1337x.is/*",
    "*://*.1337x.is/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["hydration.js", "background.js"]
  },
  "action": {
    "default_title": "Plex Requests Browser Capture",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/capture.svg"
  },
  "icons": {
    "48": "icons/capture.svg",
    "96": "icons/capture.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://1337x.to/*",
        "*://*.1337x.to/*",
        "*://1337x.st/*",
        "*://*.1337x.st/*",
        "*://1337x.ws/*",
        "*://*.1337x.ws/*",
        "*://1337x.eu/*",
        "*://*.1337x.eu/*",
        "*://1337x.se/*",
        "*://*.1337x.se/*",
        "*://1337x.so/*",
        "*://*.1337x.so/*",
        "*://1337x.is/*",
        "*://*.1337x.is/*"
      ],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
