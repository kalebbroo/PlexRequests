<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PlexRequests.Downloader</RootNamespace>
    <AssemblyName>PlexRequests.Downloader</AssemblyName>
    <!-- Required by the [LibraryImport] source generator (libc link() for hardlinks). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <!-- Result caching per (indexer, query), so a re-search or an admin hammering the search button
         doesn't re-hit every site. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
    <!-- Retry/circuit-breaking for indexer HTTP calls. There was none: a single transient 503 or DNS
         blip was a hard per-indexer failure for that whole search pass. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <!-- Small managed tag writer for Plex-grade M4A metadata and embedded artwork. This avoids
         pulling ffmpeg into the runtime or transcoding YouTube's native AAC stream. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/PlexRequests.Shared.csproj" />
  </ItemGroup>

</Project>
