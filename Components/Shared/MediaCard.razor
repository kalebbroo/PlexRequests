@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@using PlexRequestsHosted.Shared.Media
@using PlexRequestsHosted.Shared.Navigation
@inject PlexRequestsHosted.Services.Abstractions.IMediaModuleRegistry MediaModules
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService MusicSettings

@* The full-card details target is a real anchor, not a Blazor-only click handler. It therefore remains
   navigable after reconnects, supports open-in-new-tab, and cannot silently dump a user at the home page
   when a circuit is stale. Quick actions sit above the anchor. *@
<div class="@CardClass" title="@Media.Title">
    <a class="mcard-detail-link" href="@DetailsHref" aria-label="View details for @Media.Title"></a>
    <div class="mcard-poster">
        @if (!string.IsNullOrEmpty(Media.PosterUrl))
        {
            <img src="@Media.PosterUrl" alt="@Media.Title" loading="lazy"
                 onerror="this.onerror=null;this.src='/img/poster-placeholder.svg'" />
        }
        else
        {
            <div class="mcard-placeholder"><MudIcon Icon="@GetMediaIcon()" Size="Size.Large" /></div>
        }

        @if (Media.IsAvailable)
        {
            <div class="mcard-badge available" title="Available on Plex"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /></div>
        }
        else if (Media.RequestStatus == RequestStatus.Pending)
        {
            <div class="mcard-badge pending" title="Requested"><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" /></div>
        }
        else if (Media.RequestStatus == RequestStatus.Approved || Media.RequestStatus == RequestStatus.Processing)
        {
            <div class="mcard-badge approved" title="Approved / downloading"><MudIcon Icon="@Icons.Material.Filled.Downloading" Size="Size.Small" /></div>
        }

        @if (Media.MediaType == MediaType.TvShow && Media.TotalSeasons > 0)
        {
            <div class="mcard-seasons">@Media.TotalSeasons @(Media.TotalSeasons == 1 ? "Season" : "Seasons")</div>
        }

        <div class="mcard-overlay">
            <div class="mcard-overlay-top">
                @if (Media.Rating.HasValue && Media.Rating.Value > 0)
                {
                    <span class="mcard-rating"><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" /> @Media.Rating.Value.ToString("0.0")</span>
                }
            </div>
            <div class="mcard-overlay-body">
                <div class="mcard-title">@Media.Title</div>
                @if (!string.IsNullOrWhiteSpace(Media.Subtitle))
                {
                    <div class="mcard-subtitle">@Media.Subtitle</div>
                }
                <div class="mcard-meta">
                    @if (Media.Year.HasValue) { <span>@Media.Year</span> }
                    <span class="mcard-type">@GetTypeLabel()</span>
                </div>
                <div class="mcard-actions">
                    @if (Media.IsAvailable)
                    {
                        <button class="mcard-btn primary" @onclick:stopPropagation="true" @onclick="HandlePlay">
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> @(Media.MediaType == MediaType.Music ? "Listen" : "Play")
                        </button>
                    }
                    else if (CanRequest && Media.RequestStatus == RequestStatus.None)
                    {
                        <button class="mcard-btn primary" title="@RequestButtonTitle" aria-label="@RequestButtonAriaLabel"
                                @onclick:stopPropagation="true" @onclick="HandleRequest">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /> @RequestButtonLabel
                        </button>
                    }
                    else if (!CanRequest)
                    {
                        <button class="mcard-btn muted" disabled>Browse only</button>
                    }
                    else
                    {
                        <button class="mcard-btn muted" disabled>@GetStatusText()</button>
                    }
                    <a class="mcard-btn icon" title="Details" href="@DetailsHref" aria-label="View details for @Media.Title">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                    </a>
                    @if (OnRemove.HasDelegate)
                    {
                        <button class="mcard-btn icon danger" title="Remove" @onclick:stopPropagation="true" @onclick="HandleRemove">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MediaCardDto Media { get; set; } = default!;
    [Parameter] public EventCallback<MediaCardDto> OnRequest { get; set; }
    [Parameter] public EventCallback<MediaCardDto> OnPlay { get; set; }
    [Parameter] public EventCallback<MediaCardDto> OnRemove { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }
    [Parameter] public string? ReturnLabel { get; set; }

    private bool _musicRequestsEnabled;

    private string CardClass => Media.MediaType == MediaType.Music
        ? "mcard mcard-music"
        : "mcard";

    protected override async Task OnParametersSetAsync()
    {
        if (Media.MediaType == MediaType.Music)
            _musicRequestsEnabled = (await MusicSettings.GetAsync()).RequestsEnabled;
    }

    private async Task HandleRequest() { if (OnRequest.HasDelegate) await OnRequest.InvokeAsync(Media); }
    private async Task HandlePlay() { if (OnPlay.HasDelegate) await OnPlay.InvokeAsync(Media); }
    private async Task HandleRemove() { if (OnRemove.HasDelegate) await OnRemove.InvokeAsync(Media); }

    private bool CanRequest => MediaModules.IsEnabled(Media.MediaType)
        && MediaModules.Get(Media.MediaType).Capabilities.HasFlag(MediaModuleCapabilities.Request)
        && (Media.MediaType != MediaType.Music || _musicRequestsEnabled);

    private bool IsSeries => Media.ResolveMediaRef().Kind == MediaKind.Series;
    private string RequestButtonLabel => IsSeries ? "Request series" : "Request";
    private string RequestButtonTitle => IsSeries ? "Request the full series" : $"Request {Media.Title}";
    private string RequestButtonAriaLabel => IsSeries
        ? $"Request the full series {Media.Title}"
        : $"Request {Media.Title}";

    private string DetailsHref
    {
        get
        {
            var mediaRef = Media.ResolveMediaRef();
            var href = mediaRef.TryGetTmdbId(out var tmdbId)
                ? $"/media/{Media.MediaType.ToString().ToLowerInvariant()}/{tmdbId}"
                : $"/media/{Media.MediaType.ToString().ToLowerInvariant()}/{mediaRef.Kind.ToString().ToLowerInvariant()}/{Uri.EscapeDataString(mediaRef.Provider)}/{Uri.EscapeDataString(mediaRef.Id)}";
            return MusicNavigationContext.AddReturnContext(href, ReturnUrl, ReturnLabel);
        }
    }

    private string GetMediaIcon() => Media.MediaType switch
    {
        MediaType.Movie => Icons.Material.Filled.Movie,
        MediaType.TvShow => Icons.Material.Filled.Tv,
        MediaType.Music => Media.ResolveMediaRef().Kind == MediaKind.Artist
            ? Icons.Material.Filled.Person
            : Icons.Material.Filled.LibraryMusic,
        _ => Icons.Material.Filled.VideoLibrary
    };

    private string GetTypeLabel() => Media.MediaType switch
    {
        MediaType.TvShow => "TV",
        MediaType.Music => Media.ResolveMediaRef().Kind.ToString(),
        MediaType.Anime => "Anime",
        _ => "Movie"
    };

    private string GetStatusText() => Media.RequestStatus switch
    {
        RequestStatus.Pending => "Pending",
        RequestStatus.Approved => "Approved",
        RequestStatus.Processing => "Downloading",
        RequestStatus.Available => "Available",
        RequestStatus.PartiallyAvailable => "Partially available",
        RequestStatus.Rejected => "Denied",
        _ => "Requested"
    };
}
