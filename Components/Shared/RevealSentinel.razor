@implements IAsyncDisposable
@inject IJSRuntime JS

@* Marks the point where the next batch of a row or grid should render. The marker re-arms after every render, so a
   batch that leaves it still in view keeps revealing until the window fills or the marker scrolls out of reach. *@
<div class="reveal-sentinel" @ref="_marker" aria-hidden="true"></div>

@code {
    // Selector for a scroll container to watch (a row track). Null watches the viewport.
    [Parameter] public string? RootSelector { get; set; }
    [Parameter] public string RootMargin { get; set; } = "0px";
    // Changes whenever the parent reveals another batch, so this marker re-renders and re-arms.
    [Parameter] public int Revealed { get; set; }
    [Parameter] public EventCallback OnVisible { get; set; }

    private ElementReference _marker;
    private DotNetObjectReference<RevealSentinel>? _self;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("plexui.armReveal", _marker, RootSelector, RootMargin, _self);
        }
        catch
        {
            // JS is unavailable or the circuit is closing. The window keeps the batch it already shows.
        }
    }

    [JSInvokable]
    public async Task OnRevealAsync()
    {
        if (OnVisible.HasDelegate) await OnVisible.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await JS.InvokeVoidAsync("plexui.disarmReveal", _marker); }
        catch { /* the circuit may already be gone */ }
        _self?.Dispose();
    }
}
