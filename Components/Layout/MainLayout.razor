@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject PlexRequestsHosted.Services.Abstractions.INotificationBroker Broker
@inject PlexRequestsHosted.Services.Abstractions.INotificationService Notifications
@inject PlexRequestsHosted.Services.Abstractions.INotificationPreferenceService NotificationPreferences
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService MusicSettings
@inject IJSRuntime JS
@implements IDisposable

    
    <div class="app-container">
    @if (!_isLoginPage)
    {
    <header class="app-header @(_isHomepage && !_scrolled ? "transparent" : "") @(_scrolled ? "scrolled" : "")" @onscroll="HandleScroll">
        <div class="header-content">
            <div class="header-left">
                <a href="/browse" class="brand-logo">
                    <MudText Typo="Typo.h5" Class="brand-text">PLEX REQUESTS</MudText>
                </a>
                <nav class="main-nav desktop-only">
                    <NavLink href="/browse/movie" class="nav-item">Movies</NavLink>
                    <NavLink href="/browse/tvshow" class="nav-item">TV Shows</NavLink>
                    @if (_musicEnabled)
                    {
                        <NavLink href="/music" class="nav-item">Music</NavLink>
                    }
                    <NavLink href="/requests" class="nav-item">My Requests</NavLink>
                    <NavLink href="/watchlist" class="nav-item">My List</NavLink>
                    @if (_isAdmin)
                    {
                        <NavLink href="/admin" class="nav-item">Admin</NavLink>
                    }
                </nav>
            </div>
            
            <div class="header-right">
                <div class="search-container desktop-only">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" Size="Size.Small" />
                    <input type="text" class="search-input" placeholder="Titles, genres, people" @onkeydown="HandleSearchKeyDown" @bind-value="_searchQuery" @bind-value:event="oninput" />
                </div>

                <MudBadge Content="_unreadCount" Color="Color.Error" Overlap="true" Bordered="true"
                          Visible="@(_unreadCount > 0)" Class="desktop-only notification-btn">
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                             PopoverClass="notification-popover" ListClass="notification-list"
                             OpenChanged="NotificationMenuOpenChanged">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"
                                           aria-label="@(_unreadCount > 0 ? $"Notifications, {_unreadCount} unread" : "Notifications")" />
                        </ActivatorContent>
                        <ChildContent>
                            <div class="notification-header">
                                <div>
                                    <MudText Typo="Typo.subtitle1">Notifications</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary">
                                        @(_unreadCount == 0 ? "You're caught up" : $"{_unreadCount} unread")
                                    </MudText>
                                </div>
                                @if (_unreadCount > 0)
                                {
                                    <button type="button" class="notification-mark-all" @onclick="MarkAllRead">Mark all read</button>
                                }
                            </div>
                            @if (_notifications.Any())
                            {
                                @foreach (var notification in _notifications)
                                {
                                    <article class="@("notification-item" + (notification.IsRead ? "" : " unread"))">
                                        <button type="button" class="notification-open" @onclick="() => OpenNotification(notification)">
                                            <MudIcon Icon="@GetNotificationIcon(notification.Type)" Color="@GetNotificationColor(notification.Type)" Size="Size.Small" Class="notification-icon" />
                                            <div class="notification-body">
                                                <MudText Typo="Typo.subtitle2" Class="notification-title">@notification.Title</MudText>
                                                <MudText Typo="Typo.body2" Class="notification-message">@notification.Message</MudText>
                                                <MudText Typo="Typo.caption" Class="notification-time">@RelativeTime(notification.CreatedAt)</MudText>
                                            </div>
                                            @if (!notification.IsRead)
                                            {
                                                <span class="unread-dot" aria-hidden="true"></span>
                                            }
                                        </button>
                                        @if (!notification.IsRead)
                                        {
                                            <MudTooltip Text="Mark read">
                                                <MudIconButton Icon="@Icons.Material.Filled.Done" Size="Size.Small"
                                                               Class="notification-read-one"
                                                               OnClick="() => MarkRead(notification)"
                                                               aria-label="@($"Mark {notification.Title} read")" />
                                            </MudTooltip>
                                        }
                                    </article>
                                }
                            }
                            else
                            {
                                <div class="notification-empty">
                                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Default" />
                                    <MudText Typo="Typo.body2">No notifications yet</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary">Updates you opt into will appear here.</MudText>
                                </div>
                            }
                            <a class="notification-settings-link" href="/profile#notification-settings">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /> Notification settings
                            </a>
                        </ChildContent>
                    </MudMenu>
                </MudBadge>
                
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudAvatar Size="Size.Small" Class="user-avatar">
                            <MudImage Src="@(_userAvatar ?? "/default-avatar.svg")" />
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/profile">Profile</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="SignOut">Sign Out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
                
                <span class="mobile-only mobile-menu-trigger">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleMobileMenu" />
                </span>
            </div>
        </div>
    </header>
    }

    @if (_mobileMenuOpen && !_isLoginPage)
    {
        <div class="mobile-menu-backdrop" @onclick="CloseMobileMenu"></div>
        <div class="mobile-menu">
            <nav class="mobile-nav">
                <NavLink href="/browse/movie" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" />
                    <span>Movies</span>
                </NavLink>
                <NavLink href="/browse/tvshow" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Tv" Size="Size.Small" />
                    <span>TV Shows</span>
                </NavLink>
                @if (_musicEnabled)
                {
                    <NavLink href="/music" class="mobile-nav-item" Match="NavLinkMatch.Prefix" @onclick="CloseMobileMenu">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryMusic" Size="Size.Small" />
                        <span>Music</span>
                    </NavLink>
                }
                <NavLink href="/requests" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" />
                    <span>My Requests</span>
                </NavLink>
                <NavLink href="/watchlist" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Bookmark" Size="Size.Small" />
                    <span>My List</span>
                </NavLink>
                @if (_isAdmin)
                {
                    <NavLink href="/admin" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" />
                        <span>Admin</span>
                    </NavLink>
                }
                <NavLink href="/search" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    <span>Search</span>
                </NavLink>
                <MudDivider Class="mobile-nav-divider" />
                <NavLink href="/profile" class="mobile-nav-item" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    <span>Profile</span>
                </NavLink>
            </nav>
        </div>
    }

    <main class="main-content @(_isLoginPage ? "full-bleed" : "")">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
                    <MudAlert Severity="Severity.Error">
                        Something went wrong. Please refresh the page or try again later.
                    </MudAlert>
                </MudContainer>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    @if (!_isLoginPage)
    {
        <footer class="app-footer">
            <MudContainer MaxWidth="MaxWidth.Large">
                <div class="footer-content">
                    <div class="footer-links">
                        <a href="/about">About</a>
                        <a href="/help">Help Center</a>
                        <a href="/terms">Terms of Service</a>
                        <a href="/privacy">Privacy</a>
                    </div>
                    <MudText Typo="Typo.caption" Class="footer-copyright">
                        @DateTime.Now.Year Plex Requests. All rights reserved.
                    </MudText>
                </div>
            </MudContainer>
        </footer>
    }
</div>

@* Blazor writes the unhandled-circuit-error message into this element and unhides it. It was dropped when
   this layout was rewritten, while its stylesheet rule in MainLayout.razor.css survived — so the rule
   styled nothing and a circuit that threw showed the user NOTHING AT ALL: the page simply stopped
   responding to clicks, with no message and no hint that reloading would fix it. There is an ErrorBoundary
   above for render exceptions, but it cannot catch a dead circuit, which is the case this covers. *@
<div id="blazor-error-ui" data-nosnippet>
    Something went wrong on the server and this page has stopped responding.
    <a href="." class="reload">Reload</a>
    @* Plain multiplication sign, not the template's 🗙 (U+1F5D9) — that codepoint has no glyph in a lot of
       font stacks and renders as a tofu box. *@
    <span class="dismiss" title="Dismiss" role="button" aria-label="Dismiss">&#215;</span>
</div>

@code {
    private bool _scrolled = false;
    private bool _mobileMenuOpen = false;
    private bool _isHomepage = false;
    private bool _isLoginPage = false;
    private string? _userAvatar;
    private string _searchQuery = string.Empty;
    private int _unreadCount = 0;
    private List<NotificationDto> _notifications = new();
    private int _userId;
    private bool _isAuthenticated = false;
    private bool _isAdmin = false;
    private bool _musicEnabled;
    private string? _currentUsername;
    private NotificationReadBehavior _readBehavior = NotificationReadBehavior.Manual;
    private int _autoReadSeconds = 30;
    private int _readPreferenceVersion;
    private readonly CancellationTokenSource _notificationLifetime = new();

    protected override async Task OnInitializedAsync()
    {
        DetermineRouteContext();
        Navigation.LocationChanged += HandleLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;
        NotificationPreferences.Changed += OnNotificationPreferencesChanged;

        // Get authentication state
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ApplyAuthenticationState(authState);

        if (_isAuthenticated)
        {
            try { _musicEnabled = (await MusicSettings.GetAsync()).CatalogEnabled; }
            catch { _musicEnabled = false; /* the shell must survive a transient settings/DB failure */ }
            // Get avatar from claims (cheap; no network)
            _userAvatar = authState.User.FindFirst("avatar_url")?.Value;
            int.TryParse(authState.User.FindFirst("user_id")?.Value, out _userId);

            // Subscribe early so live events aren't missed; the actual notification fetch is deferred
            // to OnAfterRender so it never blocks the first paint of the page.
            if (_userId > 0) Broker.Notified += OnNotified;
        }
    }

    private void ApplyAuthenticationState(AuthenticationState authState)
    {
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        _currentUsername = authState.User.Identity?.Name;
        _isAdmin = authState.User.IsInRole("Admin");
        _userAvatar = authState.User.FindFirst("avatar_url")?.Value;
        int.TryParse(authState.User.FindFirst("user_id")?.Value, out _userId);
    }

    private async void HandleAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        try
        {
            var wasAdmin = _isAdmin;
            var wasAuthenticated = _isAuthenticated;
            var authState = await stateTask;
            ApplyAuthenticationState(authState);
            await InvokeAsync(StateHasChanged);
            if (wasAuthenticated && !_isAuthenticated)
            {
                var status = authState.User.FindFirst(PlexRequestsHosted.Services.Auth.UserAccessClaimsTransformation.AccountStatusClaim)?.Value;
                var error = status is "suspended" or "disabled" ? $"account_{status}" : "auth_failed";
                Navigation.NavigateTo($"/login?error={error}", forceLoad: true);
                return;
            }
            if (wasAdmin && !_isAdmin && Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo("/browse");
        }
        catch
        {
            // The circuit may be disposing while the authentication notification is in flight.
        }
    }

    private bool _notificationsLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("plexui.initHeaderMetrics", ".app-header");
            }
            catch
            {
                // JS interop is intentionally tolerant here because header metrics are a resilience enhancement,
                // not a hard app dependency.
            }
        }

        if (!firstRender || _userId <= 0 || _notificationsLoaded) return;
        _notificationsLoaded = true;
        var preferences = await NotificationPreferences.GetCurrentAsync();
        ApplyNotificationPreferences(preferences);
        if (_readBehavior == NotificationReadBehavior.AfterDelay)
            await Notifications.MarkCreatedBeforeReadAsync(_userId, DateTime.UtcNow.AddSeconds(-_autoReadSeconds));

        // Load persisted notifications after the shell has painted, both queries in parallel.
        var listTask = Notifications.GetForUserAsync(_userId, 20);
        var countTask = Notifications.GetUnreadCountAsync(_userId);
        await Task.WhenAll(listTask, countTask);
        _notifications = listTask.Result;
        _unreadCount = countTask.Result;
        foreach (var notification in _notifications.Where(x => !x.IsRead)) ScheduleAutoRead(notification);
        await InvokeAsync(StateHasChanged);
    }

    private async void OnNotified(NotificationDto n)
    {
        if (n.UserId != _userId) return;
        try
        {
            _notifications.Insert(0, n);
            if (_notifications.Count > 20) _notifications = _notifications.Take(20).ToList();
            _unreadCount++;
            ScheduleAutoRead(n);
            await InvokeAsync(StateHasChanged);
        }
        catch { /* component may be disposing */ }
    }

    private async Task MarkAllRead()
    {
        if (_userId <= 0) return;
        await Notifications.MarkAllReadAsync(_userId);
        foreach (var n in _notifications) n.IsRead = true;
        _unreadCount = 0;
        StateHasChanged();
    }

    private async Task MarkRead(NotificationDto notification)
    {
        if (_userId <= 0 || notification.IsRead) return;
        await Notifications.MarkReadAsync(notification.Id, _userId);
        notification.IsRead = true;
        _unreadCount = Math.Max(0, _unreadCount - 1);
        StateHasChanged();
    }

    private async Task NotificationMenuOpenChanged(bool open)
    {
        if (!open || _userId <= 0) return;
        if (_readBehavior == NotificationReadBehavior.WhenCenterOpened && _unreadCount > 0)
            await MarkAllRead();
    }

    private async Task OpenNotification(NotificationDto notification)
    {
        if (_readBehavior == NotificationReadBehavior.WhenNotificationOpened)
            await MarkRead(notification);
        Navigation.NavigateTo(NotificationNavigation.Destination(notification.Type));
    }

    private void OnNotificationPreferencesChanged(NotificationPreferencesDto preferences)
    {
        ApplyNotificationPreferences(preferences);
        if (_readBehavior == NotificationReadBehavior.AfterDelay)
            foreach (var notification in _notifications.Where(x => !x.IsRead)) ScheduleAutoRead(notification);
        InvokeAsync(StateHasChanged);
    }

    private void ApplyNotificationPreferences(NotificationPreferencesDto preferences)
    {
        _readBehavior = preferences.ReadBehavior;
        _autoReadSeconds = Math.Clamp(preferences.AutoReadSeconds, 10, 3600);
        _readPreferenceVersion++;
    }

    private void ScheduleAutoRead(NotificationDto notification)
    {
        if (_readBehavior != NotificationReadBehavior.AfterDelay || notification.IsRead) return;
        _ = AutoReadAsync(notification.Id, notification.CreatedAt, _autoReadSeconds, _readPreferenceVersion);
    }

    private async Task AutoReadAsync(int notificationId, DateTime createdAt, int delaySeconds, int preferenceVersion)
    {
        try
        {
            var dueAt = createdAt.ToUniversalTime().AddSeconds(delaySeconds);
            var delay = dueAt - DateTime.UtcNow;
            if (delay > TimeSpan.Zero) await Task.Delay(delay, _notificationLifetime.Token);
            if (_notificationLifetime.IsCancellationRequested) return;
            await InvokeAsync(async () =>
            {
                var notification = _notifications.FirstOrDefault(x => x.Id == notificationId);
                if (notification is not null && !notification.IsRead
                    && _readBehavior == NotificationReadBehavior.AfterDelay
                    && preferenceVersion == _readPreferenceVersion)
                    await MarkRead(notification);
            });
        }
        catch (OperationCanceledException) { }
        catch { /* notification auto-read must never tear down the layout circuit */ }
    }

    private static string RelativeTime(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt.ToUniversalTime();
        if (elapsed.TotalSeconds < 45) return "Just now";
        if (elapsed.TotalMinutes < 60) return $"{Math.Max(1, (int)elapsed.TotalMinutes)}m ago";
        if (elapsed.TotalHours < 24) return $"{Math.Max(1, (int)elapsed.TotalHours)}h ago";
        if (elapsed.TotalDays < 7) return $"{Math.Max(1, (int)elapsed.TotalDays)}d ago";
        return createdAt.ToLocalTime().ToString("MMM d");
    }

    private void HandleScroll()
    {
        // Header gains a solid background once the page is scrolled past the hero.
        _scrolled = true;
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(_searchQuery)}");
            _searchQuery = string.Empty;
        }
        else if (e.Key == "Escape")
        {
            _searchQuery = string.Empty;
        }
    }

    private static string GetNotificationIcon(NotificationType type) => type switch
    {
        NotificationType.RequestApproved => Icons.Material.Filled.CheckCircle,
        NotificationType.RequestAvailable => Icons.Material.Filled.PlayCircle,
        NotificationType.RequestRejected => Icons.Material.Filled.Cancel,
        NotificationType.RequestCreated => Icons.Material.Filled.AddCircle,
        NotificationType.MediaIssueReported => Icons.Material.Filled.ReportProblem,
        NotificationType.MediaIssueApproved => Icons.Material.Filled.Downloading,
        NotificationType.RequestReplaced or NotificationType.MediaIssueResolved => Icons.Material.Filled.TaskAlt,
        NotificationType.MediaIssueDismissed => Icons.Material.Filled.RemoveCircleOutline,
        NotificationType.Error => Icons.Material.Filled.ErrorOutline,
        NotificationType.Warning => Icons.Material.Filled.WarningAmber,
        NotificationType.Success => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.Info
    };

    private static Color GetNotificationColor(NotificationType type) => type switch
    {
        NotificationType.RequestApproved or NotificationType.RequestAvailable or NotificationType.RequestReplaced
            or NotificationType.MediaIssueResolved or NotificationType.Success => Color.Success,
        NotificationType.RequestRejected or NotificationType.Error => Color.Error,
        NotificationType.MediaIssueDismissed or NotificationType.Warning => Color.Warning,
        _ => Color.Info
    };

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }

    private async Task SignOut()
    {
        // Cast to CustomAuthStateProvider to access SignOutAsync
        if (AuthStateProvider is PlexRequestsHosted.Services.Auth.CustomAuthStateProvider customProvider)
        {
            await customProvider.SignOutAsync();
        }
        Navigation.NavigateTo("/", true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
        Broker.Notified -= OnNotified;
        NotificationPreferences.Changed -= OnNotificationPreferencesChanged;
        _notificationLifetime.Cancel();
        _notificationLifetime.Dispose();
    }

    protected override void OnParametersSet()
    {
        DetermineRouteContext();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        DetermineRouteContext();
        InvokeAsync(StateHasChanged);
    }

    private void DetermineRouteContext()
    {
        // Compare the path only — query strings (e.g. /login?returnUrl=...) must not change the result.
        var path = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        _isHomepage = path.Equals("/browse", StringComparison.OrdinalIgnoreCase)
            || path.Equals("/dashboard", StringComparison.OrdinalIgnoreCase);
        _isLoginPage = path.Length == 0
            || path.Equals("/login", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/auth/callback", StringComparison.OrdinalIgnoreCase);
    }
}
