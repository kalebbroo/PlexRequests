@page "/search"
@attribute [Authorize]
@inject PlexRequestsHosted.Services.Abstractions.IPlexApiService PlexApiService
@inject PlexRequestsHosted.Services.Abstractions.IMediaRequestService MediaRequestService
@inject PlexRequestsHosted.Services.Abstractions.IToastService ToastService
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService MusicSettings
@inject PlexRequestsHosted.Services.Implementations.IPlexMusicService PlexMusic
@inject NavigationManager Navigation
@using PlexRequestsHosted.Shared.Media
@using PlexRequestsHosted.Shared.Navigation
@implements IDisposable

<PageTitle>@(MusicOnlyMode ? "Music Search" : "Search") - Plex Requests</PageTitle>

<div class="search-page">
    <div class="search-header">
        <MudContainer MaxWidth="MaxWidth.Large">
            @if (MusicOnlyMode)
            {
                <a class="search-back" href="/music"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> Music</a>
                <div class="search-context">
                    <span>Music catalog</span>
                    <h1>Search music</h1>
                </div>
            }
            <div class="search-input-container">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" />
                <input type="text" 
                       class="search-input" 
                       placeholder="@(MusicOnlyMode ? "Search albums, artists, and tracks…" : _musicCatalogEnabled ? "Search movies, TV, albums, artists, and tracks…" : "Search for movies, TV shows, genres…")"
                       @bind="_searchQuery"
                       @bind:event="oninput"
                       @onkeyup="HandleKeyUp"
                       autofocus />
                @if (!string.IsNullOrEmpty(_searchQuery))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" 
                                   Size="Size.Small" 
                                   Class="clear-button"
                                   OnClick="ClearSearch" />
                }
            </div>
            
            @if (_showFilters)
            {
                @if (!MusicOnlyMode)
                {
                    <div class="search-filters">
                        <MudChip T="PlexRequestsHosted.Shared.Enums.MediaType?"
                                 Variant="@(_filterType == null ? Variant.Filled : Variant.Outlined)"
                                 OnClick="() => SetTypeFilter(null)">
                            All
                        </MudChip>
                        <MudChip T="PlexRequestsHosted.Shared.Enums.MediaType?"
                                 Variant="@(_filterType == PlexRequestsHosted.Shared.Enums.MediaType.Movie ? Variant.Filled : Variant.Outlined)"
                                 OnClick="() => SetTypeFilter(PlexRequestsHosted.Shared.Enums.MediaType.Movie)">
                            Movies
                        </MudChip>
                        <MudChip T="PlexRequestsHosted.Shared.Enums.MediaType?"
                                 Variant="@(_filterType == PlexRequestsHosted.Shared.Enums.MediaType.TvShow ? Variant.Filled : Variant.Outlined)"
                                 OnClick="() => SetTypeFilter(PlexRequestsHosted.Shared.Enums.MediaType.TvShow)">
                            TV Shows
                        </MudChip>
                        @if (_musicCatalogEnabled)
                        {
                            <MudChip T="PlexRequestsHosted.Shared.Enums.MediaType?"
                                     Variant="@(_filterType == PlexRequestsHosted.Shared.Enums.MediaType.Music ? Variant.Filled : Variant.Outlined)"
                                     OnClick="() => SetTypeFilter(PlexRequestsHosted.Shared.Enums.MediaType.Music)">
                                Music
                            </MudChip>
                        }
                    </div>
                }
                @if (MusicOnlyMode || _filterType == PlexRequestsHosted.Shared.Enums.MediaType.Music)
                {
                    <div class="search-filters music-kinds" aria-label="Music result type">
                        @foreach (var kind in MusicKinds)
                        {
                            <MudChip T="MediaKind"
                                     Variant="@(_musicKind == kind.Kind ? Variant.Filled : Variant.Outlined)"
                                     OnClick="() => SetMusicKind(kind.Kind)">@kind.Label</MudChip>
                        }
                    </div>
                }
            }
        </MudContainer>
    </div>

    <div class="search-content">
        <MudContainer MaxWidth="MaxWidth.Large">
            @if (string.IsNullOrEmpty(_searchQuery))
            {
                <div class="suggestions-section">
                    <h2>@(MusicOnlyMode ? "Try an artist or album" : "Popular Searches")</h2>
                    <div class="suggestion-grid">
                        @foreach (String suggestion in ActiveSuggestions)
                        {
                            <button class="suggestion-tile" @onclick="() => SearchFor(suggestion)">
                                <span>@suggestion</span>
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                            </button>
                        }
                    </div>
                    
                    <h2>Browse by Genre</h2>
                    <div class="genre-grid">
                        @foreach (String genre in ActiveGenres)
                        {
                            <button class="genre-tile" @onclick="() => BrowseGenre(genre)">
                                @genre
                            </button>
                        }
                    </div>
                </div>
            }
            else if (_isSearching)
            {
                <!-- Loading State -->
                <div class="search-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.body1">Searching...</MudText>
                </div>
            }
            else if (_searchResults?.Any() == true)
            {
                <!-- Search Results -->
                <div class="results-header">
                    <h2>Results for "@_searchQuery"</h2>
                    <MudText Typo="Typo.body2" Class="text-secondary">
                        @_searchResults.Count results found
                    </MudText>
                </div>
                
                <div class="results-grid">
                    @foreach (PlexRequestsHosted.Shared.DTOs.MediaCardDto result in _searchResults)
                    {
                        <PlexRequestsHosted.Components.Shared.MediaCard Media="result" OnRequest="RequestMedia" OnPlay="PlayMedia" />
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(_searchQuery))
            {
                <!-- No Results -->
                <div class="no-results">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 4rem;" />
                    <h2>No results found for "@_searchQuery"</h2>
                    <MudText Typo="Typo.body1" Class="text-secondary">
                        Try different keywords or browse our categories
                    </MudText>
                    <div class="no-results-suggestions">
                        <MudText Typo="Typo.h6">You might like:</MudText>
                        <div class="suggestion-chips">
                            @foreach (String suggestion in ActiveAlternatives)
                            {
                                <MudChip T="string" OnClick="() => SearchFor(suggestion)">@suggestion</MudChip>
                            }
                        </div>
                    </div>
                </div>
            }
        </MudContainer>
    </div>
</div>

@code {
    private String _searchQuery = "";
    private List<PlexRequestsHosted.Shared.DTOs.MediaCardDto>? _searchResults;
    private PlexRequestsHosted.Shared.Enums.MediaType? _filterType;
    private MediaKind _musicKind = MediaKind.Album;
    private bool _musicCatalogEnabled;
    private Boolean _isSearching = false;
    private Boolean _showFilters = false;
    private System.Timers.Timer? _debounceTimer;
    private int _searchVersion;

    private static readonly (MediaKind Kind, string Label)[] MusicKinds =
    {
        (MediaKind.Album, "Albums"), (MediaKind.Artist, "Artists"), (MediaKind.Track, "Tracks")
    };

    private readonly List<String> _popularSearches = new()
    {
        "Action Movies", "Comedy Shows", "New Releases", "Top Rated",
        "Marvel", "Star Wars", "Horror", "Documentary"
    };

    private readonly List<String> _genres = new()
    {
        "Action", "Adventure", "Animation", "Comedy", "Crime", "Documentary",
        "Drama", "Family", "Fantasy", "Horror", "Mystery", "Romance",
        "Sci-Fi", "Thriller", "War", "Western"
    };

    private readonly List<String> _alternativeSuggestions = new()
    {
        "Trending Now", "Popular Movies", "Award Winners", "Classic Films"
    };

    private static readonly string[] MusicSuggestions =
    [
        "Beyoncé", "Kendrick Lamar", "Taylor Swift", "Daft Punk", "Bad Bunny", "SZA", "The Weeknd", "Charli xcx"
    ];

    private static readonly string[] MusicGenres =
    [
        "Pop", "Hip-Hop", "Rock", "R&B", "Electronic", "Jazz", "Country", "Latin", "Metal", "Classical"
    ];

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? QueryKind { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? QuerySource { get; set; }
    private string? _lastQ;
    private string? _lastMode;

    private PlexRequestsHosted.Shared.Enums.MediaType? RouteMediaType
        => SearchNavigationContext.ParseMediaType(QueryType);
    private bool MusicOnlyMode => RouteMediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music;
    private IEnumerable<string> ActiveSuggestions => MusicOnlyMode ? MusicSuggestions : _popularSearches;
    private IEnumerable<string> ActiveGenres => MusicOnlyMode ? MusicGenres : _genres;
    private IEnumerable<string> ActiveAlternatives => MusicOnlyMode ? MusicSuggestions.Take(4) : _alternativeSuggestions;

    protected override async Task OnParametersSetAsync()
    {
        var routeMediaType = RouteMediaType;
        var mode = $"{routeMediaType}:{QueryKind}:{QuerySource}";
        var modeChanged = !string.Equals(mode, _lastMode, StringComparison.Ordinal);
        var incomingQuery = Q?.Trim() ?? string.Empty;
        var queryChanged = !string.Equals(incomingQuery, _lastQ, StringComparison.Ordinal);
        if (modeChanged)
        {
            _lastMode = mode;
            if (routeMediaType.HasValue)
            {
                _filterType = routeMediaType.Value;
                if (routeMediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music)
                {
                    if (Enum.TryParse<MediaKind>(QueryKind, true, out var kind)
                        && kind is MediaKind.Album or MediaKind.Artist or MediaKind.Track)
                        _musicKind = kind;
                    else
                        _musicKind = MediaKind.Album;
                }
                _showFilters = true;
            }
            else
            {
                _filterType = null;
            }
        }

        // Query-string navigation can reuse this component instance. Reset stale results whenever
        // either the query or route type changes so cards from the previous media mode cannot leak in.
        if (queryChanged || modeChanged)
        {
            _debounceTimer?.Stop();
            Interlocked.Increment(ref _searchVersion);
            _lastQ = incomingQuery;
            _searchQuery = incomingQuery;
            _searchResults = null;
            _isSearching = false;
            _showFilters = RouteMediaType.HasValue || !string.IsNullOrEmpty(_searchQuery);
            if (!string.IsNullOrEmpty(_searchQuery))
                await PerformSearch();
        }
    }

    protected override void OnInitialized()
    {
        // One reusable debounce timer. AutoReset=false so it fires once per pause;
        // each keystroke restarts it. (The old code allocated a new timer per keystroke
        // and never disposed them, and AutoReset defaulted to true = repeated firing.)
        _debounceTimer = new System.Timers.Timer(300) { AutoReset = false };
        _debounceTimer.Elapsed += (_, _) => _ = InvokeAsync(RunDebouncedSearchAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        _musicCatalogEnabled = (await MusicSettings.GetAsync()).CatalogEnabled;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
        _showFilters = RouteMediaType.HasValue || !string.IsNullOrEmpty(_searchQuery);
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            Interlocked.Increment(ref _searchVersion);
            _searchResults = null;
            _isSearching = false;
            StateHasChanged();
            return;
        }

        var version = Interlocked.Increment(ref _searchVersion);
        var query = _searchQuery.Trim();
        var type = _filterType;
        var kind = type == PlexRequestsHosted.Shared.Enums.MediaType.Music ? _musicKind : (MediaKind?)null;
        _isSearching = true;
        StateHasChanged();

        try
        {
            var results = await PlexApiService.SearchMediaAsync(new MediaSearchQuery
            {
                Query = query,
                MediaType = type,
                Kind = kind,
                Provider = MusicOnlyMode ? QuerySource : null,
                PageSize = 40
            });
            if (version != _searchVersion) return;

            // Treat provider output as untrusted. The route is strict even if a provider returns
            // malformed or mixed cards, and a selected music kind cannot leak another music kind.
            if (type.HasValue)
            {
                results = results.Where(r => r.MediaType == type.Value).ToList();
            }
            if (type == PlexRequestsHosted.Shared.Enums.MediaType.Music)
            {
                results = results.Where(r => r.ResolveMediaRef().Kind == _musicKind).ToList();
            }

            // Mark availability and overlay my request statuses
            if (results.Count > 0)
            {
                await PlexApiService.AnnotateAvailabilityAsync(results);
                await PlexMusic.AnnotatePresenceAsync(results);
                if (version != _searchVersion) return;
                var statuses = await MediaRequestService.GetMyRequestStatusesAsync(
                    results.Select(m => m.ResolveMediaRef()));
                if (version != _searchVersion) return;
                foreach (var m in results)
                {
                    var k = m.ResolveMediaRef().StableKey;
                    if (statuses.TryGetValue(k, out var st)) m.RequestStatus = st;
                }
            }
            _searchResults = results;
        }
        catch (Exception ex)
        {
            if (version != _searchVersion) return;
            // Never let a search error tear down the circuit; show empty results + a toast.
            _searchResults = null;
            PlexRequestsHosted.Utils.Logs.Warning($"Search failed for '{query}': {ex.Message}");
            await ToastService.ShowErrorAsync("Search failed. Please try again.");
        }
        finally
        {
            if (version == _searchVersion)
            {
                _isSearching = false;
                StateHasChanged();
            }
        }
    }

    private void SearchFor(String query)
    {
        if (MusicOnlyMode)
        {
            Navigation.NavigateTo(BuildMusicSearchUri(_musicKind, query));
            return;
        }
        _searchQuery = query;
        _ = PerformSearch();
    }

    private void BrowseGenre(String genre)
    {
        if (MusicOnlyMode)
        {
            Navigation.NavigateTo(BuildMusicSearchUri(_musicKind, genre));
            return;
        }
        // The typed grid reads ?genre=; plain /browse (Home) ignores it.
        Navigation.NavigateTo($"/browse/movie?genre={Uri.EscapeDataString(genre)}");
    }

    private void ClearSearch()
    {
        if (MusicOnlyMode)
        {
            _debounceTimer?.Stop();
            Navigation.NavigateTo(BuildMusicSearchUri(_musicKind), replace: true);
            return;
        }
        Interlocked.Increment(ref _searchVersion);
        _searchQuery = "";
        _searchResults = null;
        _isSearching = false;
        _showFilters = RouteMediaType.HasValue;
    }

    private void SetTypeFilter(PlexRequestsHosted.Shared.Enums.MediaType? type)
    {
        if (MusicOnlyMode) return;
        _filterType = type;
        _ = PerformSearch();
    }

    private void SetMusicKind(MediaKind kind)
    {
        if (MusicOnlyMode)
        {
            _debounceTimer?.Stop();
            Navigation.NavigateTo(BuildMusicSearchUri(kind, _searchQuery));
            return;
        }
        _filterType = PlexRequestsHosted.Shared.Enums.MediaType.Music;
        _musicKind = kind;
        _ = PerformSearch();
    }

    private Task RunDebouncedSearchAsync()
    {
        if (!MusicOnlyMode) return PerformSearch();

        var target = BuildMusicSearchUri(_musicKind, _searchQuery);
        var current = $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
        if (string.Equals(current, target, StringComparison.Ordinal))
            return PerformSearch();

        // Replace while typing so one search does not create a browser-history entry per pause.
        // OnParametersSetAsync owns the resulting search and cancels any stale provider response.
        Navigation.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    private string BuildMusicSearchUri(MediaKind kind, string? query = null)
    {
        var parameters = new List<string>
        {
            "type=music",
            $"kind={kind.ToString().ToLowerInvariant()}"
        };
        if (!string.IsNullOrWhiteSpace(QuerySource))
            parameters.Add($"source={Uri.EscapeDataString(QuerySource.Trim())}");
        if (!string.IsNullOrWhiteSpace(query))
            parameters.Add($"q={Uri.EscapeDataString(query.Trim())}");
        return $"/search?{string.Join('&', parameters)}";
    }

    private async Task RequestMedia(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        PlexRequestsHosted.Shared.DTOs.MediaRequestResult result = await MediaRequestService.RequestMediaAsync(media.ResolveMediaRef());
        if (result.Success)
        {
            media.RequestStatus = result.NewStatus ?? PlexRequestsHosted.Shared.Enums.RequestStatus.Pending;
            await ToastService.ShowSuccessAsync(MediaRequestFeedback.Success(media, result));
        }
        else
        {
            await ToastService.ShowErrorAsync(result.ErrorMessage ?? "Failed to request this title.");
        }
    }

    private void PlayMedia(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        if (!string.IsNullOrEmpty(media.PlexUrl))
            Navigation.NavigateTo(media.PlexUrl, true);
    }

    public void Dispose()
    {
        Interlocked.Increment(ref _searchVersion);
        _debounceTimer?.Dispose();
    }
}
