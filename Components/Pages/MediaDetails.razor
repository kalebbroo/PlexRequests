@page "/media/{type}/{id:int}"
@page "/media/{type}/{kind}/{provider}/{externalId}"
@attribute [Authorize]
@inject PlexRequestsHosted.Services.Abstractions.IPlexApiService PlexApiService
@inject PlexRequestsHosted.Services.Abstractions.IMediaRequestService MediaRequestService
@inject PlexRequestsHosted.Services.Abstractions.IToastService ToastService
@inject PlexRequestsHosted.Services.Implementations.IMediaIssueService IssueService
@inject PlexRequestsHosted.Services.Implementations.IQualityProfileService QualityProfiles
@inject PlexRequestsHosted.Services.Abstractions.IMediaModuleRegistry MediaModules
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService MusicSettings
@inject PlexRequestsHosted.Services.Implementations.IPlexMusicService PlexMusic
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@using PlexRequestsHosted.Shared.Media
@using PlexRequestsHosted.Shared.Navigation

<PageTitle>@(_media?.Title ?? "Loading...") - Plex Requests</PageTitle>

@if (_loading)
{
    <div class="loading-skeleton">
        <div class="skeleton-hero"></div>
        <div class="skeleton-content">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="300px" Height="60px" />
                <MudSkeleton SkeletonType="SkeletonType.Text" Width="500px" Height="30px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" />
            </MudContainer>
        </div>
    </div>
}
else if (_media == null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <div style="text-align: center; padding: 4rem 0;">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="font-size: 4rem;" />
            <MudText Typo="Typo.h4" Class="mt-4">Content Not Found</MudText>
            <MudText Typo="Typo.body1" Class="text-secondary">
                This title isn't available right now.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@(Type?.Equals("music", StringComparison.OrdinalIgnoreCase) == true ? "/music" : "/browse")" Class="mt-4">
                @(Type?.Equals("music", StringComparison.OrdinalIgnoreCase) == true ? "Back to Music" : "Browse Home")
            </MudButton>
        </div>
    </MudContainer>
}
else
{
    <div class="details-container @(_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music ? "music-details" : null)">
        <!-- Hero Section -->
        <section class="details-hero">
            <div class="hero-background">
                @if (!string.IsNullOrEmpty(_media.BackdropUrl))
                {
                    <img src="@_media.BackdropUrl" alt="" class="backdrop-image" />
                }
                <div class="hero-gradient"></div>
            </div>
            
            <div class="hero-content">
                <MudContainer MaxWidth="MaxWidth.Large">
                    @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music)
                    {
                        <a class="details-back" href="@BackUrl"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> @BackLabel</a>
                    }
                    <div class="hero-grid">
                        <div class="poster-section">
                            @if (!string.IsNullOrEmpty(_media.PosterUrl))
                            {
                                <img src="@_media.PosterUrl" alt="@_media.Title" class="poster" fetchpriority="high"
                                     onerror="this.onerror=null;this.src='/img/poster-placeholder.svg'" />
                            }
                            else
                            {
                                <div class="poster poster-placeholder" aria-label="No artwork available">
                                    <MudIcon Icon="@(_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music ? Icons.Material.Filled.LibraryMusic : Icons.Material.Filled.ImageNotSupported)" />
                                </div>
                            }
                            <div class="poster-actions mobile-only">
                                @if (_media.IsAvailable)
                                {
                                    <button class="action-btn primary full" @onclick="PlayNow">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                                        <span>@PrimaryPlayLabel</span>
                                    </button>
                                }
                                else if (CanRequest && _media.RequestStatus == PlexRequestsHosted.Shared.Enums.RequestStatus.None)
                                {
                                    <button class="action-btn primary full" @onclick="RequestMedia">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" />
                                        <span>Request</span>
                                    </button>
                                }
                                else if (!CanRequest)
                                {
                                    <button class="action-btn secondary full" disabled>
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                                        <span>Browse only</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="action-btn secondary full" disabled>
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                                        <span>@GetRequestStatusText()</span>
                                    </button>
                                }
                                @if ((_media.IsAvailable || _availableSeasons.Count > 0 ||
                                      _media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime) &&
                                     _media.MediaType != PlexRequestsHosted.Shared.Enums.MediaType.Music)
                                {
                                    <button class="action-btn secondary full" @onclick="OpenReport">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" />
                                        <span>Report a Problem</span>
                                    </button>
                                }
                            </div>
                        </div>
                        
                        <div class="info-section">
                            <h1 class="title">@_media.Title</h1>
                            @if (!string.IsNullOrWhiteSpace(_media.Subtitle))
                            {
                                <p class="tagline">@_media.Subtitle</p>
                            }

                            @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music && _media.Music is not null)
                            {
                                <div class="music-context" aria-label="Music relationships">
                                    <span class="music-kind-badge">@MusicKindLabel</span>
                                    @if (RelatedArtistHref is not null && !string.IsNullOrWhiteSpace(_media.Music.ArtistCredit))
                                    {
                                        <a href="@RelatedArtistHref"><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> @_media.Music.ArtistCredit</a>
                                    }
                                    @if (RelatedAlbumHref is not null && !string.IsNullOrWhiteSpace(_media.Music.AlbumTitle))
                                    {
                                        <a href="@RelatedAlbumHref"><MudIcon Icon="@Icons.Material.Filled.Album" Size="Size.Small" /> @_media.Music.AlbumTitle</a>
                                    }
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(_media.Tagline))
                            {
                                <p class="tagline">@_media.Tagline</p>
                            }
                            
                            <div class="metadata">
                                @if (_media.Rating.HasValue)
                                {
                                    <div class="meta-item rating">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" />
                                        <span>@_media.Rating.Value.ToString("0.0")</span>
                                    </div>
                                }
                                @if (_media.Year.HasValue)
                                {
                                    <span class="meta-item">@_media.Year</span>
                                }
                                @if ((_media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime) && _media.TotalSeasons > 0)
                                {
                                    <span class="meta-item">@_media.TotalSeasons Seasons</span>
                                }
                                @if (_media.Runtime.HasValue)
                                {
                                    <span class="meta-item">@FormatRuntime(_media.Runtime.Value)</span>
                                }
                                @if (!string.IsNullOrEmpty(_media.ContentRating))
                                {
                                    <span class="meta-badge">@_media.ContentRating</span>
                                }
                                @if (_media.MediaQuality is not null)
                                {
                                    <MudTooltip Text="@_media.MediaQuality.Detail">
                                        <span class="quality-badge @GetQualityClass()">@_media.MediaQuality.Label</span>
                                    </MudTooltip>
                                }
                                else if (!string.IsNullOrEmpty(_media.Quality))
                                {
                                    <span class="quality-badge @GetQualityClass()">@_media.Quality</span>
                                }
                            </div>
                            
                            <div class="actions desktop-only">
                                @if (_media.IsAvailable)
                                {
                                    <button class="action-btn primary large" @onclick="PlayNow">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                                        <span>@PrimaryPlayLabel</span>
                                    </button>
                                }
                                else if (CanRequest && _media.RequestStatus == PlexRequestsHosted.Shared.Enums.RequestStatus.None)
                                {
                                    <button class="action-btn primary large" @onclick="RequestMedia">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" />
                                        <span>Request</span>
                                    </button>
                                }
                                else if (!CanRequest)
                                {
                                    <button class="action-btn secondary large" disabled>
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                                        <span>Browse only</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="action-btn secondary large" disabled>
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                                        <span>@GetRequestStatusText()</span>
                                    </button>
                                }
                                
                                @if (_media.MediaType != PlexRequestsHosted.Shared.Enums.MediaType.Music)
                                {
                                    <button class="action-btn secondary large" @onclick="ToggleWatchlist">
                                        <MudIcon Icon="@(_inWatchlist ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)" />
                                        <span>@(_inWatchlist ? "In My List" : "My List")</span>
                                    </button>
                                }
                                
                                @if (!string.IsNullOrEmpty(_media.TrailerUrl))
                                {
                                    <button class="action-btn secondary" @onclick="PlayTrailer">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircleOutline" />
                                        <span>Trailer</span>
                                    </button>
                                }

                                @if ((_media.IsAvailable || _availableSeasons.Count > 0 ||
                                      _media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime) &&
                                     _media.MediaType != PlexRequestsHosted.Shared.Enums.MediaType.Music)
                                {
                                    <button class="action-btn secondary" @onclick="OpenReport">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" />
                                        <span>Report a Problem</span>
                                    </button>
                                }
                            </div>
                            
                            @if (!string.IsNullOrEmpty(_media.Overview))
                            {
                                <div class="overview">
                                    <p>@_media.Overview</p>
                                </div>
                            }
                            
                            @if (_media.Genres?.Any() == true)
                            {
                                <div class="genres">
                                    <span class="label">Genres:</span>
                                    @{
                                        var genreTypeLabel = (_media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime) ? "tvshow" : "movie";
                                    }
                                    @foreach (String genre in _media.Genres)
                                    {
                                        @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music)
                                        {
                                            <a href="@MusicNavigationContext.BuildSearchUrl(genre)" class="genre-link">@genre</a>
                                        }
                                        else
                                        {
                                            <a href="/browse/@genreTypeLabel?genre=@Uri.EscapeDataString(genre)" class="genre-link">@genre</a>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </MudContainer>
            </div>
        </section>

        <!-- Details Tabs -->
        <section class="details-tabs">
            <MudContainer MaxWidth="MaxWidth.Large">
                <MudTabs Elevation="0" Rounded="false" Centered="false" Color="Color.Default" SliderColor="Color.Primary" Class="custom-tabs">
                    @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music
                        && _media.Music?.Kind == MediaKind.Artist && _media.Music.Albums.Count > 0)
                    {
                        <MudTabPanel Text="Albums">
                            <div class="similar-section">
                                <div class="similar-grid">
                                    @foreach (var album in _media.Music.Albums)
                                    {
                                        <PlexRequestsHosted.Components.Shared.MediaCard Media="album" OnRequest="RequestSimilar" OnPlay="PlayCard"
                                            ReturnUrl="@CurrentDetailsUrl" ReturnLabel="@_media.Title" />
                                    }
                                </div>
                            </div>
                        </MudTabPanel>
                    }
                    @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music
                        && _media.Music?.Kind != MediaKind.Track && _media.Music?.Tracks.Count > 0)
                    {
                        <MudTabPanel Text="Tracks">
                            <div class="episodes-section">
                                @foreach (var disc in _media.Music.Tracks.GroupBy(t => t.DiscNumber).OrderBy(g => g.Key))
                                {
                                    @if (_media.Music.Tracks.Select(t => t.DiscNumber).Distinct().Count() > 1)
                                    {
                                        <MudText Typo="Typo.subtitle1" Class="mb-2 mt-3">Disc @disc.Key</MudText>
                                    }
                                    @foreach (var track in disc.OrderBy(t => t.TrackNumber))
                                    {
                                        var trackCard = _trackCards.GetValueOrDefault(track.RecordingId);
                                        <div class="episode-row music-track-row">
                                            <span class="music-track-number">@track.TrackNumber</span>
                                            <div class="music-track-name">
                                                @if (trackCard is not null)
                                                {
                                                    <a class="music-track-link" href="@MediaHref(trackCard)">@track.Title</a>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body1">@track.Title</MudText>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(track.ArtistCredit) && track.ArtistCredit != _media.Music.ArtistCredit)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@track.ArtistCredit</MudText>
                                                }
                                            </div>
                                            <div class="music-track-actions">
                                                @if (track.DurationMs is > 0)
                                                {
                                                    <span class="text-secondary">@FormatTrackDuration(track.DurationMs.Value)</span>
                                                }
                                                @if (trackCard is not null)
                                                {
                                                    @if (trackCard.IsAvailable)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                                   OnClick="() => PlayCard(trackCard)">Listen</MudButton>
                                                    }
                                                    else if (trackCard.RequestStatus == PlexRequestsHosted.Shared.Enums.RequestStatus.None && _musicRequestsEnabled)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                                   OnClick="() => RequestSimilar(trackCard)">Request</MudButton>
                                                    }
                                                    else if (trackCard.RequestStatus != PlexRequestsHosted.Shared.Enums.RequestStatus.None)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@TrackStatus(trackCard)</MudChip>
                                                    }
                                                    <a class="music-track-detail" href="@MediaHref(trackCard)" aria-label="View details for @track.Title">
                                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </MudTabPanel>
                    }
                    @if (_media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime)
                    {
                        <MudTabPanel Text="Seasons">
                            <div class="episodes-section">
                                @if (_media.Seasons?.Any() == true)
                                {
                                    <MudText Typo="Typo.body2" Class="mb-3">Expand a season to request or upgrade individual episodes. Episodes already on Plex include a report button for file-specific playback, audio, subtitle, or content problems.</MudText>
                                    <div class="seasons-list">
                                        @foreach (var season in _media.Seasons.Where(s => s.SeasonNumber > 0).OrderBy(s => s.SeasonNumber))
                                        {
                                            var seasonAvailable = _availableSeasons.Contains(season.SeasonNumber);
                                            <div class="season-block @(seasonAvailable ? "is-available" : "")">
                                                <div class="season-row">
                                                    <MudCheckBox T="bool" Value="@_selectedSeasons.Contains(season.SeasonNumber)"
                                                                 ValueChanged="@((bool v) => ToggleSeason(season.SeasonNumber, v))"
                                                                 Disabled="@seasonAvailable" dense="true" />
                                                    <div class="season-meta" @onclick="() => ToggleExpand(season.SeasonNumber)">
                                                        <MudText Typo="Typo.subtitle1">Season @season.SeasonNumber</MudText>
                                                        <MudText Typo="Typo.caption" Class="text-secondary">@season.EpisodeCount episodes</MudText>
                                                    </div>
                                                    @if (_seasonQuality.TryGetValue(season.SeasonNumber, out var sq))
                                                    {
                                                        <MudTooltip Text="@sq.Detail">
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@sq.Label</MudChip>
                                                        </MudTooltip>
                                                    }
                                                    @if (seasonAvailable)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">On Plex</MudChip>
                                                    }
                                                    <MudIconButton Icon="@(_expanded.Contains(season.SeasonNumber) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                                   Size="Size.Small" OnClick="() => ToggleExpand(season.SeasonNumber)" />
                                                </div>

                                                @if (_expanded.Contains(season.SeasonNumber))
                                                {
                                                    <div class="episode-list">
                                                        @if (!_episodes.ContainsKey(season.SeasonNumber))
                                                        {
                                                            <div class="episode-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> <span>Loading episodes…</span></div>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var ep in _episodes[season.SeasonNumber])
                                                            {
                                                                <div class="episode-row @(ep.IsAvailable ? "is-available" : "")">
                                                                    @* Episodes already on Plex are selectable now. They used to be disabled, which meant
                                                                       there was no way at all to ask for a better copy of something you already had — a
                                                                       720p episode of a show with plenty of 1080p releases was simply stuck. Unaired
                                                                       episodes stay disabled, because nothing exists to fetch. *@
                                                                    <MudTooltip Text="@(ep.IsAvailable ? "Already on Plex — tick to fetch a better version" : null)" Disabled="@(!ep.IsAvailable)">
                                                                        <MudCheckBox T="bool" Value="@_selectedEpisodes.Contains((ep.SeasonNumber, ep.EpisodeNumber))"
                                                                                     ValueChanged="@((bool v) => ToggleEpisode(ep.SeasonNumber, ep.EpisodeNumber, v))"
                                                                                     Color="@(ep.IsAvailable ? Color.Secondary : Color.Primary)"
                                                                                     Disabled="@(!ep.HasAired)" dense="true" />
                                                                    </MudTooltip>
                                                                    <span class="episode-num">E@(ep.EpisodeNumber)</span>
                                                                    <span class="episode-name">@ep.Name</span>
                                                                    @if (ep.IsAvailable)
                                                                    {
                                                                        @if (ep.MediaQuality is not null)
                                                                        {
                                                                            <MudTooltip Text="@ep.MediaQuality.Detail">
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@ep.MediaQuality.Label</MudChip>
                                                                            </MudTooltip>
                                                                        }
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">On Plex</MudChip>
                                                                    }
                                                                    else if (!ep.HasAired)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@(ep.AirDate?.ToString("MMM d, yyyy") ?? "Unaired")</MudChip>
                                                                    }
                                                                    @if (ep.IsAvailable)
                                                                    {
                                                                        <MudTooltip Text="@($"Report a problem with S{ep.SeasonNumber:D2}E{ep.EpisodeNumber:D2}")">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small"
                                                                                           Color="Color.Warning" Class="episode-report"
                                                                                           OnClick="@(() => OpenEpisodeReport(ep))"
                                                                                           aria-label="@($"Report a problem with episode {ep.EpisodeNumber}")" />
                                                                        </MudTooltip>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="season-actions">
                                        @* Upgrades re-download something you already have, so the button says so
                                           rather than looking identical to a normal request. *@
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(SelectionIsUpgrade ? Color.Secondary : Color.Primary)"
                                                   StartIcon="@(SelectionIsUpgrade ? Icons.Material.Filled.Upgrade : null)"
                                                   OnClick="RequestSelectedEpisodes" Disabled="@(_selectedEpisodes.Count == 0)">
                                            @(SelectionIsUpgrade ? "Upgrade" : "Request") @_selectedEpisodes.Count Episode@(_selectedEpisodes.Count == 1 ? "" : "s")
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RequestSelectedSeasons" Disabled="@(_selectedSeasons.Count == 0)">
                                            Request @_selectedSeasons.Count Season@(_selectedSeasons.Count == 1 ? "" : "s")
                                        </MudButton>
                                        @* Only worth showing when there's an actual choice; with one option
                                           the answer is already the default. *@
                                        @if (_profileOptions.Count > 1)
                                        {
                                            <MudSelect T="int?" Value="_selectedProfileId" Label="Quality"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Style="min-width:170px;"
                                                       ValueChanged="@(v => _selectedProfileId = v)">
                                                @foreach (var p in _profileOptions)
                                                {
                                                    <MudSelectItem T="int?" Value="@((int?)p.Id)">@p.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        }
                                        @if (!SeriesFullyOnPlex)
                                        {
                                            <MudTooltip Text="New episodes may be auto-downloaded as they air, depending on server settings">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RequestEntireSeries">Request Entire Series</MudButton>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CheckCircle">All aired seasons on Plex</MudChip>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">Season information not available</MudText>
                                }
                            </div>
                        </MudTabPanel>

                        @* Monitoring is per-series, so it belongs beside the seasons rather than in admin:
                           the panel self-hides its controls when the series hasn't been requested yet. *@
                        <MudTabPanel Text="Monitoring">
                            <div class="episodes-section">
                                <SeriesMonitoringPanel ShowTmdbId="@Id" />
                            </div>
                        </MudTabPanel>
                    }

                    <MudTabPanel Text="More Details">
                        <div class="more-details-grid">
                            @if (_media.Cast?.Any() == true)
                            {
                                <div class="detail-group">
                                    <h3>Cast</h3>
                                    <p>@string.Join(", ", _media.Cast.Take(10))</p>
                                </div>
                            }
                            @if (_media.Directors?.Any() == true)
                            {
                                <div class="detail-group">
                                    <h3>Directors</h3>
                                    <p>@string.Join(", ", _media.Directors)</p>
                                </div>
                            }
                            @if (_media.Writers?.Any() == true)
                            {
                                <div class="detail-group">
                                    <h3>Writers</h3>
                                    <p>@string.Join(", ", _media.Writers)</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_media.Studio) || !string.IsNullOrEmpty(_media.Network))
                            {
                                <div class="detail-group">
                                    <h3>Studio</h3>
                                    <p>@(_media.Studio ?? _media.Network)</p>
                                </div>
                            }
                            @if (_media.ReleaseDate.HasValue || _media.FirstAired.HasValue)
                            {
                                <div class="detail-group">
                                    <h3>Release Date</h3>
                                    <p>@((_media.ReleaseDate ?? _media.FirstAired)?.ToString("MMMM d, yyyy"))</p>
                                </div>
                            }
                            @if (_media.Languages?.Any() == true)
                            {
                                <div class="detail-group">
                                    <h3>Languages</h3>
                                    <p>@string.Join(", ", _media.Languages)</p>
                                </div>
                            }
                        </div>
                    </MudTabPanel>
                    
                    @if (_media.MediaType != PlexRequestsHosted.Shared.Enums.MediaType.Music)
                    {
                        <MudTabPanel Text="Similar">
                            <div class="similar-section">
                                @if (_similarMedia?.Any() == true)
                                {
                                    <div class="similar-grid">
                                        @foreach (PlexRequestsHosted.Shared.DTOs.MediaCardDto similar in _similarMedia)
                                        {
                                            <PlexRequestsHosted.Components.Shared.MediaCard Media="similar" OnRequest="RequestSimilar" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">No similar titles available</MudText>
                                }
                            </div>
                        </MudTabPanel>
                    }
                </MudTabs>
                @if (_media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music
                    && _similarMedia?.Any() == true)
                {
                    <section class="music-related-section">
                        <div class="music-related-head">
                            <div>
                                <span>Keep exploring</span>
                                <h2>@RelatedSectionTitle</h2>
                            </div>
                            @if (RelatedArtistHref is not null)
                            {
                                <a href="@RelatedArtistHref">View artist <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
                            }
                        </div>
                        <div class="similar-grid music-related-grid">
                            @foreach (var related in _similarMedia)
                            {
                                <PlexRequestsHosted.Components.Shared.MediaCard Media="related" OnRequest="RequestSimilar" OnPlay="PlayCard"
                                    ReturnUrl="@CurrentDetailsUrl" ReturnLabel="@_media.Title" />
                            }
                        </div>
                    </section>
                }
            </MudContainer>
        </section>
    </div>
}

<MudDialog @bind-Visible="_reportOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent><MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.ReportProblem" Class="mr-2" />Report a Problem</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Report the exact file that is wrong. The old copy stays in place until a verified replacement imports successfully.</MudText>
        <MudSelect T="string" @bind-Value="_reportReason" Label="What's wrong?" Variant="Variant.Outlined" dense="true" Class="mb-3">
            <MudSelectItem Value="@("Wrong episode")">Wrong episode / mislabeled file</MudSelectItem>
            <MudSelectItem Value="@("Bad quality")">Bad quality / low resolution</MudSelectItem>
            <MudSelectItem Value="@("Playback broken")">Won't play / playback error</MudSelectItem>
            <MudSelectItem Value="@("Wrong version")">Wrong version / cut / language</MudSelectItem>
            <MudSelectItem Value="@("Audio / language problem")">Wrong or missing audio / language</MudSelectItem>
            <MudSelectItem Value="@("Audio out of sync")">Audio is out of sync</MudSelectItem>
            <MudSelectItem Value="@("Subtitle problem")">Missing, wrong, or out-of-sync subtitles</MudSelectItem>
            <MudSelectItem Value="@("Corrupt / incomplete")">Corrupt or incomplete file</MudSelectItem>
            <MudSelectItem Value="@("Other")">Other</MudSelectItem>
        </MudSelect>
        @if (_media?.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime)
        {
            @if (_media.Seasons?.Any() == true)
            {
                <div class="d-flex gap-3 mb-3" style="flex-wrap:wrap;">
                    <MudSelect T="int?" Value="_reportSeason" ValueChanged="ReportSeasonChanged" Label="Season"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px;flex:1;">
                        @foreach (var season in _media.Seasons.Where(s => s.SeasonNumber >= 0))
                        {
                            <MudSelectItem T="int?" Value="@((int?)season.SeasonNumber)">@(season.SeasonNumber == 0 ? "Specials" : $"Season {season.SeasonNumber}")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?" Value="_reportEpisode" ValueChanged="ReportEpisodeChanged" Label="Episode" Disabled="@(_reportSeason is null || _reportEpisodesLoading)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:180px;flex:1;">
                        @foreach (var episode in _reportEpisodes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)episode.EpisodeNumber)">
                                E@(episode.EpisodeNumber)@(string.IsNullOrWhiteSpace(episode.Name) ? "" : $" · {episode.Name}")@(episode.IsAvailable ? " · On Plex" : "")
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" dense="true" Class="mb-2">Episode metadata is unavailable. Enter the Plex season and episode numbers shown in the player.</MudAlert>
                <div class="d-flex gap-3 mb-3" style="flex-wrap:wrap;">
                    <MudNumericField T="int?" @bind-Value="_reportSeason" Label="Season" Min="0"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px;flex:1;" />
                    <MudNumericField T="int?" Value="_reportEpisode" ValueChanged="ReportEpisodeChanged" Label="Episode" Min="1"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:140px;flex:1;" />
                </div>
            }
            @if (_reportSeason is int reportSeason && _reportEpisode is int reportEpisode)
            {
                <MudAlert Severity="Severity.Info" dense="true" Class="mb-3">
                    Reporting S@(reportSeason.ToString("D2"))E@(reportEpisode.ToString("D2"))@(!string.IsNullOrWhiteSpace(_reportEpisodeTitle) ? $" · {_reportEpisodeTitle}" : "").
                    The report will be tied to this episode's current imported file when an audit record is available.
                </MudAlert>
            }
        }
        <MudTextField @bind-Value="_reportDetail" Label="What did you see? (optional)" HelperText="Example: this plays episode 8 again instead of episode 9."
                      Variant="Variant.Outlined" Lines="3" Class="mb-3" />
        <MudCheckBox T="bool" @bind-Value="_reportReplacement" Color="Color.Primary"
                     Label="Request a replacement download" />
        <MudAlert Severity="@(_reporterIsAdmin ? Severity.Info : Severity.Normal)" dense="true" Class="mt-2">
            @if (_reporterIsAdmin)
            {
                <text>As an admin, this replacement is approved and queued automatically.</text>
            }
            else
            {
                <text>An admin will review and approve the replacement. You can still submit a report without requesting one.</text>
            }
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _reportOpen = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitReport" Disabled="@ReportSubmitDisabled">Submit report</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public String? Type { get; set; }
    [Parameter] public Int32 Id { get; set; }
    [Parameter] public String? Kind { get; set; }
    [Parameter] public String? Provider { get; set; }
    [Parameter] public String? ExternalId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "returnLabel")] public string? ReturnLabel { get; set; }

    private PlexRequestsHosted.Shared.DTOs.MediaDetailDto? _media;
    private List<PlexRequestsHosted.Shared.DTOs.MediaCardDto>? _similarMedia;
    private Dictionary<string, PlexRequestsHosted.Shared.DTOs.MediaCardDto> _trackCards =
        new(StringComparer.Ordinal);
    private PlexRequestsHosted.Shared.DTOs.SeasonDto? _selectedSeason;
    private Boolean _loading = true;
    private Boolean _inWatchlist = false;

    private bool _rendered = false;
    private bool _musicRequestsEnabled;
    private string BackUrl => MusicNavigationContext.ValidateReturnUrl(ReturnUrl);
    private string BackLabel => MusicNavigationContext.ResolveReturnLabel(ReturnUrl, ReturnLabel);
    private string CurrentDetailsUrl => $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
    private string MusicKindLabel => _media?.Music?.Kind switch
    {
        MediaKind.Artist => "Artist",
        MediaKind.Track => "Song",
        _ => _media?.Music?.PrimaryType ?? "Album"
    };
    private string? RelatedArtistHref => _media?.Music is { Kind: not MediaKind.Artist, ArtistId.Length: > 0 } music
        ? MusicDetailHref(MediaKind.Artist, music.ArtistId)
        : null;
    private string? RelatedAlbumHref => _media?.Music is { Kind: MediaKind.Track, ReleaseGroupId.Length: > 0 } music
        ? MusicDetailHref(MediaKind.Album, music.ReleaseGroupId)
        : null;
    private string RelatedSectionTitle => !string.IsNullOrWhiteSpace(_media?.Music?.ArtistCredit)
        ? $"More from {_media.Music.ArtistCredit}"
        : "Related music";
    private string? _loadedKey;
    private int _loadVersion;
    private bool CanRequest => _media is not null && MediaModules.IsEnabled(_media.MediaType)
        && MediaModules.Get(_media.MediaType).Capabilities.HasFlag(MediaModuleCapabilities.Request)
        && (_media.MediaType != PlexRequestsHosted.Shared.Enums.MediaType.Music || _musicRequestsEnabled);

    private string MusicDetailHref(MediaKind kind, string id)
    {
        var provider = _media?.ResolveMediaRef().Provider ?? Provider ?? "musicbrainz";
        var href = $"/media/music/{kind.ToString().ToLowerInvariant()}/{Uri.EscapeDataString(provider)}/{Uri.EscapeDataString(id)}";
        return MusicNavigationContext.AddReturnContext(href, CurrentDetailsUrl, _media?.Title);
    }

    // Load after first render (shell/skeleton paints instantly), and again when the route id/type
    // changes on the same component instance (e.g. clicking a "Similar" title).
    protected override async Task OnParametersSetAsync()
    {
        if (_rendered && RouteKey != _loadedKey)
            await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var routeKey = RouteKey;
        var mediaRef = ResolveRouteMediaRef();
        var version = Interlocked.Increment(ref _loadVersion);
        _loadedKey = routeKey;
        _loading = true;
        _media = null;
        _similarMedia = null;
        _trackCards = new(StringComparer.Ordinal);
        _availableSeasons = new();
        _seasonQuality = new();
        _selectedSeasons.Clear();
        _selectedEpisodes.Clear();
        _expanded.Clear();
        _episodes.Clear();
        _selectedProfileId = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var media = await PlexApiService.GetMediaDetailsAsync(mediaRef);
            if (version != _loadVersion) return;
            _media = media;
            if (media is null) return;
            _trackCards = BuildTrackCards(media, mediaRef.Provider);
            if (media.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music)
            {
                _musicRequestsEnabled = (await MusicSettings.GetAsync()).RequestsEnabled;
                await PlexMusic.AnnotatePresenceAsync([media]);
                if (version != _loadVersion) return;
            }

            // Phase 1: show the title/poster/overview immediately.
            if (media.Seasons?.Any() == true) _selectedSeason = media.Seasons.First();
            _loading = false;
            await InvokeAsync(StateHasChanged);

            // Phase 2: enrich (badges, watchlist, seasons, recommendations). The recommendations fetch
            // is a TMDB call (own HttpClient) so it can overlap the DB work; the DB calls themselves
            // run sequentially because scoped services share the circuit's single AppDbContext.
            var similarTask = mediaRef.Kind == MediaKind.Artist
                ? Task.FromResult(new List<PlexRequestsHosted.Shared.DTOs.MediaCardDto>())
                : PlexApiService.GetSimilarAsync(mediaRef, 12);

            await PlexApiService.AnnotateAvailabilityAsync(new List<PlexRequestsHosted.Shared.DTOs.MediaCardDto> { media });
            if (version != _loadVersion) return;
            var statusCards = new List<PlexRequestsHosted.Shared.DTOs.MediaCardDto> { media };
            if (media.Music?.Albums.Count > 0) statusCards.AddRange(media.Music.Albums);
            statusCards.AddRange(_trackCards.Values);
            await PlexMusic.AnnotatePresenceAsync(statusCards);
            if (version != _loadVersion) return;
            var statusMap = await MediaRequestService.GetMyRequestStatusesAsync(
                statusCards.Select(x => x.ResolveMediaRef()));
            if (version != _loadVersion) return;
            foreach (var card in statusCards)
                if (statusMap.TryGetValue(card.ResolveMediaRef().StableKey, out var status))
                    card.RequestStatus = status;
            if (mediaRef.TryGetTmdbId(out _))
            {
                var inWatchlist = await MediaRequestService.IsInWatchlistAsync(media.Id, media.MediaType);
                if (version != _loadVersion) return;
                _inWatchlist = inWatchlist;
            }
            if (media.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime)
            {
                var availableSeasons = (await PlexApiService.GetAvailableSeasonsAsync(media.Id)).ToHashSet();
                if (version != _loadVersion) return;
                var seasonQuality = await PlexApiService.GetSeasonQualitySummariesAsync(media.Id);
                if (version != _loadVersion) return;
                _availableSeasons = availableSeasons;
                _seasonQuality = seasonQuality;
                // Series-level header badge: dominant quality across all seasons on Plex.
                if (seasonQuality.Count > 0 && media.MediaQuality is null)
                {
                    var best = seasonQuality.Values
                        .OrderByDescending(q => q.Bitrate ?? 0)
                        .FirstOrDefault(q => !string.IsNullOrEmpty(q.Resolution)) ?? seasonQuality.Values.First();
                    media.MediaQuality = best;
                    media.Quality ??= best.Resolution;
                }
            }
            if (CanRequest)
            {
                var profileOptions = await GetProfileOptionsAsync(media.MediaType);
                if (version != _loadVersion) return;
                _profileOptions = profileOptions;
                _selectedProfileId ??= profileOptions.FirstOrDefault(p => p.IsDefault)?.Id;
            }
            await InvokeAsync(StateHasChanged);

            var similarMedia = (await similarTask)?.Where(m => m.ResolveMediaRef().StableKey != mediaRef.StableKey).Take(12).ToList();
            if (version != _loadVersion) return;
            _similarMedia = similarMedia;
            if (similarMedia?.Any() == true)
            {
                await PlexApiService.AnnotateAvailabilityAsync(similarMedia);
                await PlexMusic.AnnotatePresenceAsync(similarMedia);
                if (version != _loadVersion) return;
                var map = await MediaRequestService.GetMyRequestStatusesAsync(
                    similarMedia.Select(m => m.ResolveMediaRef()));
                if (version != _loadVersion) return;
                foreach (var m in similarMedia)
                    if (map.TryGetValue(m.ResolveMediaRef().StableKey, out var st2)) m.RequestStatus = st2;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            // A failure here (e.g. TMDB unreachable) must not escape into OnAfterRenderAsync,
            // which would be an unhandled circuit exception and kill the whole page. Fall back
            // to the "Content Not Found" state.
            if (version == _loadVersion)
            {
                _media = null;
                PlexRequestsHosted.Utils.Logs.Warning($"MediaDetails load failed for {routeKey}: {ex.Message}");
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string RouteKey => $"{Type}:{Kind}:{Provider}:{ExternalId}:{Id}";

    private MediaRef ResolveRouteMediaRef()
    {
        var mediaType = ParseType(Type);
        if (!string.IsNullOrWhiteSpace(ExternalId) && !string.IsNullOrWhiteSpace(Provider)
            && Enum.TryParse<MediaKind>(Kind, true, out var kind))
            return MediaRef.FromExternal(Provider, ExternalId, mediaType, kind);
        return MediaRef.FromTmdb(Id, mediaType);
    }

    private static PlexRequestsHosted.Shared.Enums.MediaType ParseType(String? type) => type?.ToLowerInvariant() switch
    {
        "tvshow" or "tv" => PlexRequestsHosted.Shared.Enums.MediaType.TvShow,
        "anime" => PlexRequestsHosted.Shared.Enums.MediaType.Anime,
        "music" => PlexRequestsHosted.Shared.Enums.MediaType.Music,
        _ => PlexRequestsHosted.Shared.Enums.MediaType.Movie
    };

    private async Task RequestMedia()
    {
        if (_media == null) return;
        
        PlexRequestsHosted.Shared.DTOs.MediaRequestResult result = await MediaRequestService.RequestMediaAsync(
            _media.ResolveMediaRef(), qualityProfileId: _selectedProfileId, isAnimeIntent: _media.IsAnime);
        if (result.Success)
        {
            _media.RequestStatus = result.NewStatus ?? PlexRequestsHosted.Shared.Enums.RequestStatus.Pending;
            await ToastService.ShowSuccessAsync(MediaRequestFeedback.Success(_media, result));
            StateHasChanged();
        }
        else
        {
            await ToastService.ShowErrorAsync(result.ErrorMessage ?? "Failed to request");
        }
    }

    private readonly HashSet<int> _selectedSeasons = new();

    // Quality profile the requester picked. Null = "decide for me", which lets the assignment rules and the
    // default profile apply. Only shown when there's an actual choice to make.
    private int? _selectedProfileId;
    private List<PlexRequestsHosted.Shared.DTOs.QualityProfileSummaryDto> _profileOptions = new();

    private async Task<List<PlexRequestsHosted.Shared.DTOs.QualityProfileSummaryDto>> GetProfileOptionsAsync(
        PlexRequestsHosted.Shared.Enums.MediaType mediaType)
    {
        try
        {
            return await QualityProfiles.GetSelectableProfilesAsync(null, mediaType);
        }
        catch { return new(); } // never block requesting on the picker failing to load
    }
    private readonly HashSet<(int season, int episode)> _selectedEpisodes = new();
    private readonly HashSet<int> _expanded = new();
    private readonly Dictionary<int, List<PlexRequestsHosted.Shared.DTOs.EpisodeDto>> _episodes = new();
    private HashSet<int> _availableSeasons = new();
    private Dictionary<int, PlexRequestsHosted.Shared.DTOs.MediaQualityDto> _seasonQuality = new();

    // Report-a-Problem dialog
    private bool _reportOpen;
    private bool _reportSubmitting;
    private string _reportReason = "Bad quality";
    private string _reportDetail = string.Empty;
    private bool _reportReplacement = true;
    private bool _reporterIsAdmin;
    private int? _reportSeason;
    private int? _reportEpisode;
    private string? _reportEpisodeTitle;
    private bool _reportEpisodesLoading;
    private List<PlexRequestsHosted.Shared.DTOs.EpisodeDto> _reportEpisodes = new();

    private bool ReportSubmitDisabled => _reportSubmitting ||
        (_reportReplacement &&
         (_media?.MediaType is PlexRequestsHosted.Shared.Enums.MediaType.TvShow or PlexRequestsHosted.Shared.Enums.MediaType.Anime) &&
         (_reportSeason is null || _reportEpisode is null));

    private async Task OpenReport()
    {
        _reportReason = "Wrong episode";
        _reportDetail = string.Empty;
        _reportReplacement = true;
        _reportSeason = null;
        _reportEpisode = null;
        _reportEpisodeTitle = null;
        _reportEpisodes.Clear();
        _reporterIsAdmin = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        _reportOpen = true;
    }

    private async Task OpenEpisodeReport(PlexRequestsHosted.Shared.DTOs.EpisodeDto episode)
    {
        _reportReason = "Playback broken";
        _reportDetail = string.Empty;
        _reportReplacement = true;
        _reportSeason = episode.SeasonNumber;
        _reportEpisode = episode.EpisodeNumber;
        _reportEpisodeTitle = episode.Name;
        _reportEpisodes = _episodes.GetValueOrDefault(episode.SeasonNumber)?.ToList() ?? [episode];
        _reporterIsAdmin = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.IsInRole("Admin");
        _reportOpen = true;
    }

    private async Task ReportSeasonChanged(int? season)
    {
        _reportSeason = season;
        _reportEpisode = null;
        _reportEpisodeTitle = null;
        _reportEpisodes.Clear();
        if (_media is null || season is null) return;
        _reportEpisodesLoading = true;
        try { _reportEpisodes = await PlexApiService.GetSeasonEpisodesAsync(_media.Id, season.Value); }
        finally { _reportEpisodesLoading = false; }
    }

    private void ReportEpisodeChanged(int? episode)
    {
        _reportEpisode = episode;
        _reportEpisodeTitle = episode is int number
            ? _reportEpisodes.FirstOrDefault(x => x.EpisodeNumber == number)?.Name
            : null;
    }

    private async Task SubmitReport()
    {
        if (_media is null) return;
        _reportSubmitting = true;
        try
        {
            var result = await IssueService.ReportIssueAsync(new PlexRequestsHosted.Shared.DTOs.MediaIssueReportDto
            {
                MediaId = _media.Id,
                MediaType = _media.MediaType,
                Title = _media.Title,
                PosterUrl = _media.PosterUrl,
                Reason = _reportReason,
                Detail = _reportDetail,
                SeasonNumber = _reportSeason,
                EpisodeNumber = _reportEpisode,
                EpisodeTitle = _reportEpisodeTitle,
                RequestReplacement = _reportReplacement
            });
            if (result.Success)
            {
                if (result.ReplacementQueued)
                    await ToastService.ShowSuccessAsync("Replacement approved and queued. The current file will remain until the new copy is safely imported.");
                else if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
                    await ToastService.ShowWarningAsync($"Your report was saved, but the replacement could not be queued: {result.ErrorMessage}");
                else
                    await ToastService.ShowSuccessAsync(_reportReplacement
                        ? "Your report and replacement request were sent to the admins."
                        : "Thanks — your report was sent to the admins.");
                _reportOpen = false;
                _reportDetail = string.Empty;
            }
            else await ToastService.ShowErrorAsync(result.ErrorMessage ?? "Couldn't submit the report.");
        }
        finally { _reportSubmitting = false; }
    }

    // True when every aired season of the show is already on Plex — so "Request Entire Series" would be
    // redundant. Unaired future seasons are ignored (the monitor handles those).
    private bool SeriesFullyOnPlex
    {
        get
        {
            var aired = _media?.Seasons?
                .Where(s => s.SeasonNumber > 0 && (!s.AirDate.HasValue || s.AirDate.Value.Date <= DateTime.UtcNow.Date))
                .ToList();
            return aired is { Count: > 0 } && aired.All(s => _availableSeasons.Contains(s.SeasonNumber));
        }
    }

    private async Task ToggleExpand(int season)
    {
        if (!_expanded.Add(season)) { _expanded.Remove(season); return; }
        if (_media is not null && !_episodes.ContainsKey(season))
        {
            var eps = await PlexApiService.GetSeasonEpisodesAsync(_media.Id, season);
            _episodes[season] = eps;
            StateHasChanged();
        }
    }

    private void ToggleSeason(int seasonNumber, bool selected)
    {
        if (selected) _selectedSeasons.Add(seasonNumber); else _selectedSeasons.Remove(seasonNumber);
    }

    private void ToggleEpisode(int season, int episode, bool selected)
    {
        if (selected) _selectedEpisodes.Add((season, episode)); else _selectedEpisodes.Remove((season, episode));
    }

    private async Task RequestSelectedSeasons()
    {
        if (_media is null || _selectedSeasons.Count == 0) return;
        var result = await MediaRequestService.RequestSeasonsAsync(_media.Id, _media.MediaType,
            _selectedSeasons.ToList(), _selectedProfileId, _media.IsAnime);
        await AfterTvRequest(result, $"Requested {_selectedSeasons.Count} season(s) of {_media.Title}!");
        if (result.Success) _selectedSeasons.Clear();
    }

    /// <summary>
    /// True when any selected episode is already on Plex, i.e. the user is asking for a better copy rather
    /// than a missing one. Mixed selections count as an upgrade: the request has to bypass the
    /// already-available guard or the on-Plex episodes in it would be silently dropped.
    /// </summary>
    private bool SelectionIsUpgrade =>
        _selectedEpisodes.Count > 0 && _episodes.Values.SelectMany(e => e)
            .Any(ep => ep.IsAvailable && _selectedEpisodes.Contains((ep.SeasonNumber, ep.EpisodeNumber)));

    private async Task RequestSelectedEpisodes()
    {
        if (_media is null || _selectedEpisodes.Count == 0) return;
        var upgrade = SelectionIsUpgrade;
        var count = _selectedEpisodes.Count;
        var result = await MediaRequestService.RequestEpisodesAsync(
            _media.Id, _media.MediaType, _selectedEpisodes.ToList(), _selectedProfileId,
            asUpgrade: upgrade, isAnimeIntent: _media.IsAnime);
        await AfterTvRequest(result, upgrade
            ? $"Looking for a better copy of {count} episode(s) of {_media.Title}."
            : $"Requested {count} episode(s) of {_media.Title}!");
        if (result.Success) _selectedEpisodes.Clear();
    }

    private async Task RequestEntireSeries()
    {
        if (_media is null) return;
        var result = await MediaRequestService.RequestSeriesAsync(_media.Id, _media.MediaType,
            _selectedProfileId, _media.IsAnime);
        await AfterTvRequest(result, MediaRequestFeedback.Success(_media, result));
    }

    private async Task AfterTvRequest(PlexRequestsHosted.Shared.DTOs.MediaRequestResult result, string successMessage)
    {
        if (result.Success)
        {
            if (_media is not null) _media.RequestStatus = result.NewStatus ?? PlexRequestsHosted.Shared.Enums.RequestStatus.Pending;
            await ToastService.ShowSuccessAsync(successMessage);
            StateHasChanged();
        }
        else await ToastService.ShowErrorAsync(result.ErrorMessage ?? "Failed to request");
    }

    private async Task RequestSimilar(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        var result = await MediaRequestService.RequestMediaAsync(media.ResolveMediaRef(),
            isAnimeIntent: media.IsAnime);
        if (result.Success)
        {
            media.RequestStatus = result.NewStatus ?? PlexRequestsHosted.Shared.Enums.RequestStatus.Pending;
            await ToastService.ShowSuccessAsync(MediaRequestFeedback.Success(media, result));
            StateHasChanged();
        }
        else await ToastService.ShowErrorAsync(result.ErrorMessage ?? "Failed to request");
    }

    private void PlayNow()
    {
        if (!string.IsNullOrEmpty(_media?.PlexUrl))
            Navigation.NavigateTo(_media.PlexUrl, true);
    }

    private void PlayCard(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        if (!string.IsNullOrWhiteSpace(media.PlexUrl))
            Navigation.NavigateTo(media.PlexUrl, true);
    }

    private string PrimaryPlayLabel => _media?.MediaType == PlexRequestsHosted.Shared.Enums.MediaType.Music
        ? "Listen in Plex"
        : "Play";

    private void PlayTrailer()
    {
        if (!string.IsNullOrEmpty(_media?.TrailerUrl))
            Navigation.NavigateTo(_media.TrailerUrl, true);
    }

    private async Task ToggleWatchlist()
    {
        if (_media == null) return;
        
        Boolean success = _inWatchlist
            ? await MediaRequestService.RemoveFromWatchlistAsync(_media.Id, _media.MediaType)
            : await MediaRequestService.AddToWatchlistAsync(_media.Id, _media.MediaType);
            
        if (success)
        {
            _inWatchlist = !_inWatchlist;
            String message = _inWatchlist ? "Added to My List" : "Removed from My List";
            await ToastService.ShowInfoAsync(message);
        }
    }

    private void NavigateToMedia(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        var mediaRef = media.ResolveMediaRef();
        if (mediaRef.TryGetTmdbId(out var tmdbId))
            Navigation.NavigateTo($"/media/{media.MediaType.ToString().ToLowerInvariant()}/{tmdbId}");
        else
            Navigation.NavigateTo($"/media/{media.MediaType.ToString().ToLowerInvariant()}/{mediaRef.Kind.ToString().ToLowerInvariant()}/{Uri.EscapeDataString(mediaRef.Provider)}/{Uri.EscapeDataString(mediaRef.Id)}");
    }

    private static Dictionary<string, PlexRequestsHosted.Shared.DTOs.MediaCardDto> BuildTrackCards(
        PlexRequestsHosted.Shared.DTOs.MediaDetailDto media, string provider)
    {
        if (media.Music?.Tracks.Count is not > 0 || string.IsNullOrWhiteSpace(provider))
            return new(StringComparer.Ordinal);
        return media.Music.Tracks
            .Where(x => !string.IsNullOrWhiteSpace(x.RecordingId))
            .DistinctBy(x => x.RecordingId, StringComparer.Ordinal)
            .ToDictionary(x => x.RecordingId, x =>
            {
                var mediaRef = MediaRef.FromExternal(provider, x.RecordingId,
                    PlexRequestsHosted.Shared.Enums.MediaType.Music, MediaKind.Track);
                return new PlexRequestsHosted.Shared.DTOs.MediaCardDto
                {
                    Title = x.Title,
                    Subtitle = x.ArtistCredit ?? media.Music.ArtistCredit,
                    Overview = $"Track from {media.Title}",
                    PosterUrl = media.PosterUrl,
                    BackdropUrl = media.BackdropUrl,
                    Year = media.Year,
                    MediaType = PlexRequestsHosted.Shared.Enums.MediaType.Music,
                    ExternalId = mediaRef.Id,
                    ExternalSource = mediaRef.Provider,
                    MediaRef = mediaRef
                };
            }, StringComparer.Ordinal);
    }

    private string MediaHref(PlexRequestsHosted.Shared.DTOs.MediaCardDto media)
    {
        var mediaRef = media.ResolveMediaRef();
        var href = $"/media/music/{mediaRef.Kind.ToString().ToLowerInvariant()}/{Uri.EscapeDataString(mediaRef.Provider)}/{Uri.EscapeDataString(mediaRef.Id)}";
        return MusicNavigationContext.AddReturnContext(href, CurrentDetailsUrl, _media?.Title);
    }

    private static string TrackStatus(PlexRequestsHosted.Shared.DTOs.MediaCardDto media) => media.RequestStatus switch
    {
        PlexRequestsHosted.Shared.Enums.RequestStatus.Available => "Available",
        PlexRequestsHosted.Shared.Enums.RequestStatus.Processing => "Downloading",
        PlexRequestsHosted.Shared.Enums.RequestStatus.Searching => "Searching",
        PlexRequestsHosted.Shared.Enums.RequestStatus.Approved => "Approved",
        PlexRequestsHosted.Shared.Enums.RequestStatus.Pending => "Pending",
        PlexRequestsHosted.Shared.Enums.RequestStatus.PartiallyAvailable => "Partial",
        _ => "Requested"
    };

    private String GetRequestStatusText() => _media?.RequestStatus switch
    {
        PlexRequestsHosted.Shared.Enums.RequestStatus.Pending => "Pending",
        PlexRequestsHosted.Shared.Enums.RequestStatus.Approved => "Approved",
        _ => "Requested"
    };

    private String GetQualityClass() => _media?.Quality?.ToUpper() switch
    {
        "4K" or "UHD" => "quality-4k",
        "1080P" or "FHD" => "quality-hd",
        _ => ""
    };

    private String FormatRuntime(Int32 minutes)
    {
        if (minutes < 60) return $"{minutes}m";
        Int32 hours = minutes / 60;
        Int32 mins = minutes % 60;
        return mins > 0 ? $"{hours}h {mins}m" : $"{hours}h";
    }

    private static string FormatTrackDuration(int milliseconds)
    {
        var duration = TimeSpan.FromMilliseconds(milliseconds);
        return $"{(int)duration.TotalMinutes}:{duration.Seconds:00}";
    }
}
