@page "/music/category"
@inject IMusicDiscoveryService Discovery
@inject NavigationManager Navigation
@inject ILogger<MusicCategory> Logger
@implements IDisposable

<PageTitle>@(Name ?? "Music category") - Plex Requests</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="music-subpage">
    <a class="back-link" href="/music"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" /> Music</a>
    <div class="subpage-heading">
        <span>Genre, mood, or moment</span>
        <h1>@(Name ?? "Curated playlists")</h1>
        <p>Open a playlist to browse its songs. Playlists are discovery containers; you can request individual tracks from inside.</p>
    </div>

    @if (_loading)
    {
        <PosterGridSkeleton Count="12" />
    }
    else if (_playlists.Count == 0)
    {
        <div class="subpage-empty">
            <MudIcon Icon="@Icons.Material.Filled.QueueMusic" />
            <h2>No playlists available</h2>
            <p>This category may be empty, temporarily unavailable, or may have changed upstream.</p>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ReloadAsync">Check again</MudButton>
        </div>
    }
    else
    {
        <div class="subpage-playlists">
            @foreach (var playlist in _playlists.Take(_visibleCount))
            {
                <MusicPlaylistCard Playlist="playlist" ReturnUrl="@CurrentCategoryUrl" ReturnLabel="@CategoryLabel" />
            }
        </div>
        @if (_visibleCount < _playlists.Count)
        {
            <div class="load-more">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           OnClick="ShowMore">Show more playlists</MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }
    private List<MusicPlaylistSummaryDto> _playlists = new();
    private bool _loading = true;
    private bool _hasLoaded;
    private string? _loadedToken;
    private int _visibleCount = 48;
    private int _loadVersion;
    private CancellationTokenSource? _loadCts;
    private string CurrentCategoryUrl => $"/{Navigation.ToBaseRelativePath(Navigation.Uri)}";
    private string CategoryLabel => string.IsNullOrWhiteSpace(Name) ? "Music category" : Name;

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoaded && Token == _loadedToken) return;
        _hasLoaded = true;
        _loadedToken = Token;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var version = Interlocked.Increment(ref _loadVersion);
        var cts = new CancellationTokenSource();
        var previous = Interlocked.Exchange(ref _loadCts, cts);
        previous?.Cancel();
        previous?.Dispose();
        _loading = true;
        _visibleCount = 48;
        await InvokeAsync(StateHasChanged);
        try
        {
            var playlists = string.IsNullOrWhiteSpace(Token)
                ? new()
                : await Discovery.GetCategoryAsync(Token, cts.Token);
            if (version == _loadVersion) _playlists = playlists;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { }
        catch (Exception ex)
        {
            if (version != _loadVersion) return;
            _playlists = new();
            Logger.LogWarning(ex, "Music category {Token} could not be loaded", Token);
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ShowMore() => _visibleCount = Math.Min(_visibleCount + 48, _playlists.Count);

    public void Dispose()
    {
        Interlocked.Increment(ref _loadVersion);
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
