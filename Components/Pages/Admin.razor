@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Nav

<PageTitle>@ActiveDestination.Label - Admin - Plex Requests</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="admin-page">
    <header class="admin-hero">
        <MudText Typo="Typo.overline" Class="admin-hero-kicker">Settings</MudText>
        <MudText Typo="Typo.h3" HtmlTag="h1">Admin</MudText>
        <MudText Typo="Typo.body1" Class="text-secondary admin-hero-copy">
            Configure requests, downloads, your library, and the services that keep everything running.
        </MudText>
    </header>

    <div class="admin-mobile-picker">
        <MudSelect T="string"
                   Label="Admin section"
                   Value="_activeKey"
                   ValueChanged="OnMobileSelectionChanged"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   aria-label="Admin section"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.Settings">
            @foreach (var group in NavigationGroups)
            {
                @foreach (var destination in group.Destinations)
                {
                    <MudSelectItem T="string" Value="@destination.Key">
                        @group.Label · @destination.Label
                    </MudSelectItem>
                }
            }
        </MudSelect>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar" aria-label="Admin settings">
            <div class="admin-sidebar-title">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                <span>Admin settings</span>
            </div>

            <nav>
                @foreach (var group in NavigationGroups)
                {
                    <section class="admin-nav-group" aria-labelledby="@($"admin-group-{group.Key}")">
                        <div id="@($"admin-group-{group.Key}")" class="admin-nav-group-label">@group.Label</div>
                        @foreach (var destination in group.Destinations)
                        {
                            <button type="button"
                                    class="@NavItemClass(destination)"
                                    aria-current="@(destination.Key == _activeKey ? "page" : null)"
                                    @onclick="() => NavigateTo(destination)">
                                <MudIcon Icon="@destination.Icon" Size="Size.Small" />
                                <span>@destination.Label</span>
                            </button>
                        }
                    </section>
                }
            </nav>
        </aside>

        <main class="admin-content" aria-labelledby="admin-content-title">
            <header class="admin-content-header">
                <div class="admin-breadcrumb">Admin <span aria-hidden="true">/</span> @ActiveDestination.Group</div>
                <div class="admin-content-heading">
                    <div class="admin-content-icon" aria-hidden="true">
                        <MudIcon Icon="@ActiveDestination.Icon" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h4" HtmlTag="h2" id="admin-content-title">@ActiveDestination.Label</MudText>
                        <MudText Typo="Typo.body2" Class="text-secondary admin-content-description">
                            @ActiveDestination.Description
                        </MudText>
                    </div>
                </div>
            </header>

            <div class="admin-content-body" @key="_activeKey">
                @switch (_activeKey)
                {
                    case "overview":
                        <AdminServerHealthPanel />
                        break;
                    case "requests":
                        <AdminApprovalsPanel />
                        break;
                    case "issues":
                        <AdminIssuesPanel />
                        break;
                    case "download-rules":
                        <AdminDownloadsPanel />
                        break;
                    case "quality-profiles":
                        <AdminQualityProfilesPanel />
                        break;
                    case "profile-assignment":
                        <AdminProfileAssignmentPanel />
                        break;
                    case "custom-formats":
                        <AdminCustomFormatsPanel />
                        break;
                    case "indexers":
                        <AdminIndexersPanel />
                        break;
                    case "organization":
                        <AdminLibraryOrganizationPanel />
                        break;
                    case "media-catalogs":
                        <AdminMediaCatalogPanel />
                        break;
                    case "network-shares":
                        <AdminNetworkSharesPanel />
                        break;
                    case "jobs":
                        <AdminJobsPanel />
                        break;
                    case "users":
                        <AdminUsersPanel />
                        break;
                    case "maintenance":
                        <AdminDatabasePanel />
                        break;
                }
            </div>
        </main>
    </div>
</MudContainer>

@code {
    private const string DefaultKey = "overview";

    private static readonly AdminNavGroup[] NavigationGroups =
    {
        new("overview", "Overview",
        [
            new("overview", "Overview", "System status", "See Plex connectivity, active streams, downloads, and library availability at a glance.", Icons.Material.Filled.Dashboard, "/admin?tab=overview")
        ]),
        new("moderation", "Request management",
        [
            new("requests", "Request management", "Request queue", "Review incoming requests and make approval decisions from one queue.", Icons.Material.Filled.Assignment, "/admin?tab=requests&sub=approvals"),
            new("issues", "Request management", "Reported issues", "Resolve playback problems and retry media that needs attention.", Icons.Material.Filled.ReportProblem, "/admin?tab=requests&sub=issues")
        ]),
        new("acquisition", "Acquisition",
        [
            new("download-rules", "Acquisition", "Download rules", "Set global release filters, series monitoring behavior, and pack preferences.", Icons.Material.Filled.Download, "/admin?tab=downloads&sub=preferences"),
            new("quality-profiles", "Acquisition", "Quality profiles", "Choose acceptable quality tiers, upgrade cutoffs, size limits, and format scores.", Icons.Material.Filled.HighQuality, "/admin?tab=downloads&sub=quality"),
            new("profile-assignment", "Acquisition", "Profile assignment", "Automatically apply quality profiles by media type, genre, or title.", Icons.Material.Filled.AutoAwesome, "/admin?tab=downloads&sub=assignment"),
            new("custom-formats", "Acquisition", "Custom formats", "Rank or reject releases using reusable matching rules and profile-specific scores.", Icons.Material.Filled.Tune, "/admin?tab=downloads&sub=formats"),
            new("indexers", "Acquisition", "Indexers", "Manage direct and release sources, priorities, categories, and connection health.", Icons.Material.Filled.TravelExplore, "/admin?tab=downloads&sub=indexers")
        ]),
        new("library", "Library",
        [
            new("media-catalogs", "Library", "Media catalogs", "Enable optional media types and inspect which parts of each end-to-end pipeline are ready.", Icons.Material.Filled.LibraryMusic, "/admin?tab=library&sub=catalogs"),
            new("organization", "Library", "Organization", "Control destination paths, naming templates, routing rules, and file transfers.", Icons.Material.Filled.Folder, "/admin?tab=library&sub=organization"),
            new("network-shares", "Library", "Network storage", "Add, test, and monitor NAS or other network-backed library locations.", Icons.Material.Filled.Storage, "/admin?tab=library&sub=network")
        ]),
        new("operations", "Operations",
        [
            new("jobs", "Operations", "Jobs and activity", "Inspect missing media, upcoming episodes, retries, upgrades, schedules, and run history.", Icons.Material.Filled.Schedule, "/admin?tab=jobs")
        ]),
        new("access", "Access",
        [
            new("users", "Access", "Users and permissions", "Assign reusable groups, request permissions, quality access, and rolling quotas.", Icons.Material.Filled.Group, "/admin?tab=users")
        ]),
        new("system", "System",
        [
            new("maintenance", "System", "Database and maintenance", "Back up data, clear stale state, repair indexes, or perform a controlled reset.", Icons.Material.Filled.SettingsBackupRestore, "/admin?tab=system")
        ])
    };

    private static readonly IReadOnlyDictionary<string, AdminDestination> Destinations = NavigationGroups
        .SelectMany(group => group.Destinations)
        .ToDictionary(destination => destination.Key, StringComparer.OrdinalIgnoreCase);

    private string _activeKey = DefaultKey;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "sub")]
    public string? Sub { get; set; }

    private AdminDestination ActiveDestination => Destinations[_activeKey];

    protected override void OnParametersSet() => _activeKey = ResolveKey(Tab, Sub);

    private static string ResolveKey(string? tab, string? sub)
    {
        var normalizedTab = tab?.Trim().ToLowerInvariant() ?? string.Empty;
        var normalizedSub = sub?.Trim().ToLowerInvariant() ?? string.Empty;

        return normalizedTab switch
        {
            "requests" => normalizedSub == "issues" ? "issues" : "requests",
            "downloads" or "acquisition" => normalizedSub switch
            {
                "quality" => "quality-profiles",
                "assignment" => "profile-assignment",
                "formats" => "custom-formats",
                "indexers" => "indexers",
                _ => "download-rules"
            },
            "library" => normalizedSub switch
            {
                "catalogs" or "media" => "media-catalogs",
                "network" => "network-shares",
                _ => "organization"
            },
            "jobs" or "operations" => "jobs",
            "users" => "users",
            "system" or "maintenance" => "maintenance",
            "approvals" => "requests",
            "issues" => "issues",
            "quality" => "quality-profiles",
            "assignment" => "profile-assignment",
            "formats" => "custom-formats",
            "indexers" => "indexers",
            "network" => "network-shares",
            "health" or "overview" or "platform" or "" => DefaultKey,
            _ => DefaultKey
        };
    }

    private string NavItemClass(AdminDestination destination) =>
        destination.Key == _activeKey ? "admin-nav-item active" : "admin-nav-item";

    private void OnMobileSelectionChanged(string key)
    {
        if (Destinations.TryGetValue(key, out var destination)) NavigateTo(destination);
    }

    private void NavigateTo(AdminDestination destination)
    {
        _activeKey = destination.Key;
        Nav.NavigateTo(destination.Url);
    }

    private sealed record AdminNavGroup(string Key, string Label, AdminDestination[] Destinations);
    private sealed record AdminDestination(string Key, string Group, string Label, string Description, string Icon, string Url);
}
