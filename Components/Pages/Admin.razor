@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Nav
@using PlexRequestsHosted.Shared.Navigation

<PageTitle>@ActiveDestination.Label - Admin - Plex Requests</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="admin-page">
    <header class="admin-hero">
        <MudText Typo="Typo.overline" Class="admin-hero-kicker">Settings</MudText>
        <MudText Typo="Typo.h3" HtmlTag="h1">Admin</MudText>
        <MudText Typo="Typo.body1" Class="text-secondary admin-hero-copy">
            Set up and manage Plex Requests by task. Start with media setup, then return here only when something needs attention.
        </MudText>
    </header>

    <div class="admin-mobile-picker">
        <MudSelect T="string"
                   Label="Admin section"
                   Value="_activeKey"
                   ValueChanged="OnMobileSelectionChanged"
                   Variant="Variant.Outlined"
                   FullWidth="true"
                   aria-label="Admin section"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.Settings">
            @foreach (var group in NavigationGroups)
            {
                @foreach (var destination in group.Destinations)
                {
                    <MudSelectItem T="string" Value="@destination.Key">
                        @group.Label · @destination.Label
                    </MudSelectItem>
                }
            }
        </MudSelect>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar" aria-label="Admin settings">
            <div class="admin-sidebar-title">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                <span>Admin settings</span>
            </div>

            <nav>
                @foreach (var group in NavigationGroups)
                {
                    <section class="admin-nav-group" aria-labelledby="@($"admin-group-{group.Key}")">
                        <div id="@($"admin-group-{group.Key}")" class="admin-nav-group-label">@group.Label</div>
                        @foreach (var destination in group.Destinations)
                        {
                            <button type="button"
                                    class="@NavItemClass(destination)"
                                    aria-current="@(destination.Key == _activeKey ? "page" : null)"
                                    @onclick="() => NavigateTo(destination)">
                                <MudIcon Icon="@destination.Icon" Size="Size.Small" />
                                <span>@destination.Label</span>
                            </button>
                        }
                    </section>
                }
            </nav>
        </aside>

        <main class="admin-content" aria-labelledby="admin-content-title">
            <header class="admin-content-header">
                <div class="admin-breadcrumb">Admin <span aria-hidden="true">/</span> @ActiveDestination.Group</div>
                <div class="admin-content-heading">
                    <div class="admin-content-icon" aria-hidden="true">
                        <MudIcon Icon="@ActiveDestination.Icon" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h4" HtmlTag="h2" id="admin-content-title">@ActiveDestination.Label</MudText>
                        <MudText Typo="Typo.body2" Class="text-secondary admin-content-description">
                            @ActiveDestination.Description
                        </MudText>
                    </div>
                </div>
            </header>

            <div class="admin-content-body" @key="_activeKey">
                @switch (_activeKey)
                {
                    case "overview":
                        <AdminServerHealthPanel />
                        break;
                    case "requests":
                        <AdminRequestManagementPanel Section="@_activeSection" />
                        break;
                    case "release-settings":
                        <AdminReleaseSettingsPanel Section="@_activeSection" />
                        break;
                    case "sources":
                        <AdminIndexersPanel />
                        break;
                    case "libraries":
                        <AdminLibrarySetupPanel Section="@_activeSection" />
                        break;
                    case "activity":
                        <AdminJobsPanel />
                        break;
                    case "users":
                        <AdminUsersPanel />
                        break;
                    case "maintenance":
                        <AdminDatabasePanel />
                        break;
                }
            </div>
        </main>
    </div>
</MudContainer>

@code {
    private const string DefaultKey = "overview";

    private static readonly AdminNavGroup[] NavigationGroups =
    {
        new("manage", "Manage",
        [
            new("overview", "Manage", "Overview", "See whether Plex, downloads, and library synchronization are healthy.", Icons.Material.Filled.Dashboard, "/admin?tab=overview"),
            new("requests", "Manage", "Requests & issues", "Approve requests and resolve reported playback, quality, or episode problems.", Icons.Material.Filled.Assignment, "/admin?tab=requests&sub=approvals")
        ]),
        new("media", "Media setup",
        [
            new("release-settings", "Media setup", "Release settings", "Choose acceptable releases, quality, language, and automatic profile rules.", Icons.Material.Filled.Tune, "/admin?tab=downloads&sub=preferences"),
            new("sources", "Media setup", "Download sources", "Connect the sites and feeds Plex Requests searches for releases.", Icons.Material.Filled.TravelExplore, "/admin?tab=downloads&sub=indexers"),
            new("libraries", "Media setup", "Libraries & importing", "Choose where completed media goes and how files are organized and transferred.", Icons.Material.Filled.VideoLibrary, "/admin?tab=library&sub=organization")
        ]),
        new("operations", "Operations",
        [
            new("activity", "Operations", "Activity", "Review missing media, upcoming episodes, retries, upgrades, and scheduled work.", Icons.Material.Filled.Schedule, "/admin?tab=jobs"),
            new("users", "Operations", "Users", "Control who can request what, whether approval is required, and how often.", Icons.Material.Filled.Group, "/admin?tab=users"),
            new("maintenance", "Operations", "Maintenance", "Back up or repair application data and clear stale operational state.", Icons.Material.Filled.SettingsBackupRestore, "/admin?tab=system")
        ])
    };

    private static readonly IReadOnlyDictionary<string, AdminDestination> Destinations = NavigationGroups
        .SelectMany(group => group.Destinations)
        .ToDictionary(destination => destination.Key, StringComparer.OrdinalIgnoreCase);

    private string _activeKey = DefaultKey;
    private string _activeSection = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "sub")]
    public string? Sub { get; set; }

    private AdminDestination ActiveDestination => Destinations[_activeKey];

    protected override void OnParametersSet()
    {
        var route = AdminNavigationContext.Resolve(Tab, Sub);
        _activeKey = Destinations.ContainsKey(route.Destination) ? route.Destination : DefaultKey;
        _activeSection = route.Section;
    }

    private string NavItemClass(AdminDestination destination) =>
        destination.Key == _activeKey ? "admin-nav-item active" : "admin-nav-item";

    private void OnMobileSelectionChanged(string key)
    {
        if (Destinations.TryGetValue(key, out var destination)) NavigateTo(destination);
    }

    private void NavigateTo(AdminDestination destination)
    {
        _activeKey = destination.Key;
        Nav.NavigateTo(destination.Url);
    }

    private sealed record AdminNavGroup(string Key, string Label, AdminDestination[] Destinations);
    private sealed record AdminDestination(string Key, string Group, string Label, string Description, string Icon, string Url);
}
