@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserProfileService UserProfileService
@inject IMediaRequestService MediaRequests
@inject IUserAccessService UserAccess
@inject IUserQuotaService UserQuotas
@inject AuthenticationStateProvider AuthStateProvider
@inject IDiscordLinkService DiscordLink
@inject INotificationPreferenceService NotificationPreferences

<PageTitle>My Profile - Plex Requests</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="false" Spacing="2">
                    <MudAvatar Size="Size.Large">
                        <MudImage Src="@(_profile?.AvatarUrl ?? "/default-avatar.svg")" />
                    </MudAvatar>
                    <MudText Typo="Typo.h5">@(_profile?.DisplayName ?? _profile?.Username)</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">@_profile?.Email</MudText>
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.caption">Plex: @_profile?.PlexUsername</MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4 access-card" Elevation="2">
                <div class="access-heading">
                    <div>
                        <MudText Typo="Typo.h6">My access</MudText>
                        <MudText Typo="Typo.caption" Class="text-secondary">
                            @(_access?.GroupName is { Length: > 0 } group ? $"Inherited from {group}" : "Custom account settings")
                        </MudText>
                    </div>
                    @if (_access?.IsAdmin == true)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.AdminPanelSettings">Administrator</MudChip>
                    }
                </div>

                @if (_access is null || _quota is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
                }
                else
                {
                    <div class="permission-summary">
                        <MudIcon Icon="@(_access.AutoApprove ? Icons.Material.Filled.Bolt : Icons.Material.Filled.Schedule)" Size="Size.Small" />
                        <MudText Typo="Typo.body2">
                            @(_access.AutoApprove ? "Requests are approved automatically." : "Requests wait for administrator approval.")
                        </MudText>
                    </div>
                    <div class="profile-quota-grid">
                        @QuotaCard("Movies", Icons.Material.Filled.Movie, UserPermission.RequestMovies, _quota.Movie)
                        @QuotaCard("TV & anime", Icons.Material.Filled.Tv, UserPermission.RequestTv, _quota.Tv)
                        @QuotaCard("Music", Icons.Material.Filled.LibraryMusic, UserPermission.RequestMusic, _quota.Music)
                    </div>
                    <MudText Typo="Typo.caption" Class="text-secondary access-note">
                        Rolling usage updates automatically as older requests leave each time window.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6">Activity</MudText>
                <MudTabs>
                    <MudTabPanel Text="My Requests">
                        @if (_myRequests == null)
                        {
                            <MudProgressCircular Indeterminate="true" />
                        }
                        else if (_myRequests.Count == 0)
                        {
                            <MudText>No requests yet.</MudText>
                        }
                        else
                        {
                            <MudTable Items="_myRequests" dense="true">
                                <HeaderContent>
                                    <MudTh>Title</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Requested</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Title">@context.Title</MudTd>
                                    <MudTd DataLabel="Type">@context.MediaType</MudTd>
                                    <MudTd DataLabel="Status">
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@context.Status.ToString()</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Requested">@context.RequestedAt.ToLocalTime().ToString("g")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="Stats">
                        <MudStack Row="true" Spacing="3">
                            <MudPaper Class="pa-3" Elevation="1"><MudText Typo="Typo.subtitle2">Total Requests</MudText><MudText Typo="Typo.h5">@_stats.TotalRequests</MudText></MudPaper>
                            <MudPaper Class="pa-3" Elevation="1"><MudText Typo="Typo.subtitle2">Approved</MudText><MudText Typo="Typo.h5">@_stats.ApprovedRequests</MudText></MudPaper>
                            <MudPaper Class="pa-3" Elevation="1"><MudText Typo="Typo.subtitle2">Pending</MudText><MudText Typo="Typo.h5">@_stats.PendingRequests</MudText></MudPaper>
                            <MudPaper Class="pa-3" Elevation="1"><MudText Typo="Typo.subtitle2">Available</MudText><MudText Typo="Typo.h5">@_stats.AvailableRequests</MudText></MudPaper>
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4 notification-settings" Elevation="2" id="notification-settings">
                <div class="notification-settings-heading">
                    <div>
                        <MudText Typo="Typo.h6" HtmlTag="h2">Notifications</MudText>
                        <MudText Typo="Typo.body2" Class="text-secondary">
                            Choose each update you want and where it should arrive. Everything is off until you opt in.
                        </MudText>
                    </div>
                    @if (_savingNotifications)
                    {
                        <span class="notification-save-state"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> Saving</span>
                    }
                    else if (_notificationPreferences is not null)
                    {
                        <span class="notification-save-state saved"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> Saved automatically</span>
                    }
                </div>

                @if (_notificationPreferences is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
                }
                else
                {
                    <div class="notification-channel-headings" aria-hidden="true">
                        <span>Update</span><span>Web</span><span>Discord DM</span>
                    </div>

                    @PreferenceGroup("My request updates", "Decisions and progress for media you requested.", RequestOptions)
                    @PreferenceGroup("My issue reports", "What happens after you report a bad file, episode, or playback problem.", IssueOptions)
                    @if (_access?.IsAdmin == true)
                    {
                        @PreferenceGroup("Administrator alerts", "New work or failures that may need an administrator.", AdminOptions)
                    }

                    <section class="notification-read-settings" aria-labelledby="notification-read-title">
                        <div>
                            <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="notification-read-title">When should web notifications count as read?</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">This only changes the unread badge. Notifications remain in the list.</MudText>
                        </div>
                        <div class="notification-read-controls">
                            <MudSelect T="NotificationReadBehavior" Value="_notificationPreferences.ReadBehavior"
                                       ValueChanged="ChangeReadBehavior" Label="Mark as read"
                                       Variant="Variant.Outlined" Disabled="@_savingNotifications">
                                <MudSelectItem Value="NotificationReadBehavior.Manual">Only when I choose Mark read</MudSelectItem>
                                <MudSelectItem Value="NotificationReadBehavior.WhenNotificationOpened">When I open each notification</MudSelectItem>
                                <MudSelectItem Value="NotificationReadBehavior.WhenCenterOpened">When I open the notification center</MudSelectItem>
                                <MudSelectItem Value="NotificationReadBehavior.AfterDelay">Automatically after a delay</MudSelectItem>
                            </MudSelect>
                            @if (_notificationPreferences.ReadBehavior == NotificationReadBehavior.AfterDelay)
                            {
                                <MudSelect T="int" Value="_notificationPreferences.AutoReadSeconds"
                                           ValueChanged="ChangeAutoReadSeconds" Label="Delay"
                                           Variant="Variant.Outlined" Disabled="@_savingNotifications">
                                    <MudSelectItem Value="10">10 seconds</MudSelectItem>
                                    <MudSelectItem Value="30">30 seconds</MudSelectItem>
                                    <MudSelectItem Value="60">1 minute</MudSelectItem>
                                    <MudSelectItem Value="300">5 minutes</MudSelectItem>
                                    <MudSelectItem Value="900">15 minutes</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                    </section>

                    <section class="discord-connection" aria-labelledby="discord-connection-title">
                        <div class="discord-mark"><MudIcon Icon="@Icons.Material.Filled.Forum" /></div>
                        <div class="discord-copy">
                            <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="discord-connection-title">Discord connection</MudText>
                            @if (_discordLinked)
                            {
                                <MudText Typo="Typo.body2" Class="text-secondary">
                                    Linked as <b>@_discordUsername</b>. Linking enables bot commands; only the DM switches above control messages.
                                </MudText>
                            }
                            else if (!string.IsNullOrEmpty(_linkCode))
                            {
                                <MudText Typo="Typo.body2" Class="text-secondary">Run <b>/request link @_linkCode</b> in Discord within 10 minutes.</MudText>
                                <div class="discord-link-code">@_linkCode</div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="text-secondary">
                                    Link Discord to use bot commands and make the DM choices above available. Linking does not turn any notification on.
                                </MudText>
                            }
                        </div>
                        <div class="discord-action">
                            @if (_discordLinked)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Unlink">Unlink</MudButton>
                            }
                            else if (string.IsNullOrEmpty(_linkCode))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" OnClick="GenerateCode">Link Discord</MudButton>
                            }
                        </div>
                    </section>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private UserDto? _profile;
    private List<MediaRequestDto>? _myRequests;
    private UserStatsDto _stats = new();
    private UserAccessSnapshot? _access;
    private UserQuotaOverviewDto? _quota;

    private int _userId;
    private bool _discordLinked;
    private string? _discordUsername;
    private string? _linkCode;
    private NotificationPreferencesDto? _notificationPreferences;
    private bool _savingNotifications;

    private static readonly NotificationOption[] RequestOptions =
    [
        new(NotificationType.RequestCreated, "Request submitted", "A Discord confirmation when your request enters the queue.", false, true),
        new(NotificationType.RequestApproved, "Request approved", "An administrator approved your request and searching can begin.", true, true),
        new(NotificationType.RequestRejected, "Request denied", "An administrator denied your request, including their reason.", true, true),
        new(NotificationType.RequestAvailable, "Ready to watch", "The requested title or episodes are available in Plex.", true, true),
        new(NotificationType.Warning, "Partially available", "Some requested episodes are ready while others are still missing.", true, true),
        new(NotificationType.RequestUpgraded, "Quality upgraded", "An available title was replaced with a preferred-quality copy.", true, true),
        new(NotificationType.RequestReplaced, "Reported file replaced", "A replacement for a file you requested or reported is ready.", true, false),
        new(NotificationType.RequestCancelled, "Request cancelled", "A Discord confirmation when a request is cancelled.", false, true)
    ];

    private static readonly NotificationOption[] IssueOptions =
    [
        new(NotificationType.MediaIssueApproved, "Replacement approved", "An administrator approved the replacement you requested.", true, false),
        new(NotificationType.MediaIssueResolved, "Report resolved", "An administrator marked your report resolved.", true, false),
        new(NotificationType.MediaIssueDismissed, "Report closed", "An administrator reviewed and closed your report.", true, false)
    ];

    private static readonly NotificationOption[] AdminOptions =
    [
        new(NotificationType.RequestCreated, "New request", "A user submitted a request that may need approval.", true, false),
        new(NotificationType.RequestSearchStalled, "Search needs attention", "A request has retried repeatedly without finding an acceptable release.", true, false),
        new(NotificationType.Error, "Download failure", "A request could not be fulfilled and needs investigation.", true, false),
        new(NotificationType.MediaIssueReported, "New media problem", "A user reported a playback, quality, file, or episode problem.", true, false)
    ];

    // Load after first render so the page shell paints immediately.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        int.TryParse(auth.User.FindFirst("user_id")?.Value, out _userId);
        _profile = await UserProfileService.GetProfileAsync();
        if (_userId > 0)
        {
            _access = await UserAccess.GetAccessAsync(_userId);
            _quota = await UserQuotas.GetUsageAsync(_userId, _access);
        }
        await InvokeAsync(StateHasChanged);
        // Sequential: these share the circuit's single AppDbContext (EF forbids concurrent ops).
        await LoadRequestsAndStats();
        await LoadDiscordStatus();
        _notificationPreferences = await NotificationPreferences.GetCurrentAsync();
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment QuotaCard(string title, string icon, UserPermission permission, RequestQuotaDto quota) => @<div class="profile-quota-card">
        <div class="quota-title-row">
            <span class="quota-icon"><MudIcon Icon="@icon" Size="Size.Small" /></span>
            <MudText Typo="Typo.subtitle2">@title</MudText>
        </div>
        @if (!_access!.Permissions.HasFlag(permission) && !_access.IsAdmin)
        {
            <MudText Typo="Typo.body2" Class="quota-blocked">Not enabled</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">Ask an administrator for access.</MudText>
        }
        else if (quota.Limit is null)
        {
            <MudText Typo="Typo.body2" Class="quota-unlimited">Unlimited</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">No request cap</MudText>
        }
        else
        {
            <div class="quota-numbers">
                <strong>@quota.Remaining</strong>
                <span>remaining</span>
            </div>
            <div class="quota-meter" role="progressbar" aria-valuemin="0" aria-valuemax="@quota.Limit" aria-valuenow="@Math.Min(quota.Used, quota.Limit.Value)">
                <span style="width:@QuotaPercent(quota)%"></span>
            </div>
            <MudText Typo="Typo.caption" Class="text-secondary">@quota.Used of @quota.Limit used in @quota.WindowDays days</MudText>
        }
    </div>;

    private static int QuotaPercent(RequestQuotaDto quota) => quota.Limit is > 0
        ? Math.Clamp((int)Math.Round(quota.Used * 100d / quota.Limit.Value), 0, 100)
        : 0;

    private async Task LoadDiscordStatus()
    {
        var status = await DiscordLink.GetCurrentStatusAsync();
        _discordLinked = status.Linked;
        _discordUsername = status.DiscordUsername;
    }

    private async Task GenerateCode() => _linkCode = await DiscordLink.GenerateLinkCodeAsync();

    private RenderFragment PreferenceGroup(string title, string description, IReadOnlyList<NotificationOption> options) => @<section class="notification-preference-group">
        <div class="notification-group-heading">
            <MudText Typo="Typo.subtitle1" HtmlTag="h3">@title</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">@description</MudText>
        </div>
        <div class="notification-option-list">
            @foreach (var option in options)
            {
                <div class="notification-option-row">
                    <div class="notification-option-copy">
                        <strong>@option.Label</strong>
                        <span>@option.Description</span>
                    </div>
                    <div class="notification-channel-toggle">
                        <span>Web</span>
                        @if (option.Web)
                        {
                            <MudSwitch T="bool" Value="@_notificationPreferences!.IsEnabled(NotificationChannel.Web, option.Type)"
                                       ValueChanged="@(v => ToggleNotification(NotificationChannel.Web, option.Type, v))"
                                       Color="Color.Primary" Disabled="@_savingNotifications"
                                       aria-label="@($"Web notification: {option.Label}")" />
                        }
                        else
                        {
                            <span class="channel-unavailable" aria-label="Not available on web">—</span>
                        }
                    </div>
                    <div class="notification-channel-toggle">
                        <span>Discord</span>
                        @if (option.Discord)
                        {
                            <MudSwitch T="bool" Value="@_notificationPreferences!.IsEnabled(NotificationChannel.Discord, option.Type)"
                                       ValueChanged="@(v => ToggleNotification(NotificationChannel.Discord, option.Type, v))"
                                       Color="Color.Primary" Disabled="@(_savingNotifications || !_discordLinked)"
                                       aria-label="@($"Discord notification: {option.Label}")" />
                        }
                        else
                        {
                            <span class="channel-unavailable" aria-label="Not available by Discord DM">—</span>
                        }
                    </div>
                </div>
            }
        </div>
    </section>;

    private async Task ToggleNotification(NotificationChannel channel, NotificationType type, bool enabled)
    {
        if (_notificationPreferences is null || _savingNotifications) return;
        var previousWeb = _notificationPreferences.WebTypeMask;
        var previousDiscord = _notificationPreferences.DiscordTypeMask;
        _notificationPreferences.SetEnabled(channel, type, enabled);
        _savingNotifications = true;
        try
        {
            if (!await NotificationPreferences.UpdateCurrentAsync(_notificationPreferences))
            {
                _notificationPreferences.WebTypeMask = previousWeb;
                _notificationPreferences.DiscordTypeMask = previousDiscord;
            }
        }
        finally
        {
            _savingNotifications = false;
        }
    }

    private async Task ChangeReadBehavior(NotificationReadBehavior behavior)
    {
        if (_notificationPreferences is null || _savingNotifications) return;
        var previous = _notificationPreferences.ReadBehavior;
        _notificationPreferences.ReadBehavior = behavior;
        _savingNotifications = true;
        try
        {
            if (!await NotificationPreferences.UpdateCurrentAsync(_notificationPreferences))
                _notificationPreferences.ReadBehavior = previous;
        }
        finally
        {
            _savingNotifications = false;
        }
    }

    private async Task ChangeAutoReadSeconds(int seconds)
    {
        if (_notificationPreferences is null || _savingNotifications) return;
        var previous = _notificationPreferences.AutoReadSeconds;
        _notificationPreferences.AutoReadSeconds = seconds;
        _savingNotifications = true;
        try
        {
            if (!await NotificationPreferences.UpdateCurrentAsync(_notificationPreferences))
                _notificationPreferences.AutoReadSeconds = previous;
        }
        finally
        {
            _savingNotifications = false;
        }
    }

    private async Task Unlink()
    {
        await DiscordLink.UnlinkCurrentUserAsync();
        _linkCode = null;
        await LoadDiscordStatus();
        if (_notificationPreferences is not null)
        {
            _notificationPreferences.DiscordTypeMask = 0;
            await NotificationPreferences.UpdateCurrentAsync(_notificationPreferences);
        }
    }

    private async Task LoadRequestsAndStats()
    {
        try
        {
            _stats = await MediaRequests.GetMyStatsAsync();
            _myRequests = (await MediaRequests.GetRequestsAsync(new MediaFilterDto
            {
                PageNumber = 1,
                PageSize = 25
            })).Items;
        }
        catch
        {
            _myRequests = new();
            _stats = new UserStatsDto();
        }
    }

    private sealed record NotificationOption(NotificationType Type, string Label, string Description, bool Web, bool Discord);
}
