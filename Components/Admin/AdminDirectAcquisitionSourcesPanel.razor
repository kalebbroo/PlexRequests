@using PlexRequestsHosted.Shared.DTOs
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService Settings
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast

<section class="direct-source-section">
    <MudText Typo="Typo.h6">Direct downloads</MudText>
    <MudText Typo="Typo.body2" Class="text-muted mb-2">
        Providers that deliver the media file themselves, without a torrent or Usenet client.
    </MudText>

    @if (_loading || _settings is null)
    {
        <MudPaper Class="pa-4 text-center" Outlined="true">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
        </MudPaper>
    }
    else
    {
        <MudPaper Class="direct-source-card" Outlined="true">
            <div class="direct-source-identity">
                <span class="direct-source-icon"><MudIcon Icon="@Icons.Material.Filled.LibraryMusic" /></span>
                <div>
                    <MudText Typo="Typo.subtitle1"><b>YouTube Music</b></MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">
                        Music downloads in native AAC with Plex metadata.
                    </MudText>
                </div>
            </div>
            <div class="direct-source-actions">
                <MudChip T="string" Size="Size.Small"
                         Color="@(_settings.DirectDownloadsEnabled ? Color.Success : Color.Default)"
                         Icon="@(_settings.DirectDownloadsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.PauseCircle)">
                    @(_settings.DirectDownloadsEnabled ? "Ready" : "Off")
                </MudChip>
                <MudSwitch T="bool" Color="Color.Primary" Value="@_settings.DirectDownloadsEnabled"
                           ValueChanged="SetEnabled" Disabled="_saving" Label="Use source"
                           aria-label="Enable YouTube Music direct acquisition" />
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Settings"
                           Href="/admin?tab=library&sub=catalogs">Music settings</MudButton>
            </div>
        </MudPaper>
    }
</section>

@code {
    private MusicSettingsDto? _settings;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try { _settings = await Settings.GetAsync(); }
        finally { _loading = false; }
    }

    private async Task SetEnabled(bool enabled)
    {
        if (_settings is null) return;
        var previous = _settings.DirectDownloadsEnabled;
        _settings.DirectDownloadsEnabled = enabled;
        _saving = true;
        try
        {
            await Settings.UpdateAsync(_settings);
            _settings = await Settings.GetAsync();
            await Toast.ShowSuccessAsync($"YouTube Music direct acquisition {(enabled ? "enabled" : "disabled")}.");
        }
        catch (InvalidOperationException ex)
        {
            _settings.DirectDownloadsEnabled = previous;
            await Toast.ShowErrorAsync(ex.Message);
        }
        catch
        {
            _settings.DirectDownloadsEnabled = previous;
            await Toast.ShowErrorAsync("YouTube Music could not be updated.");
        }
        finally { _saving = false; }
    }
}
