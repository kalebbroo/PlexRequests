@using PlexRequestsHosted.Shared.DTOs
@inject PlexRequestsHosted.Services.Abstractions.IMusicSettingsService Settings
@inject PlexRequestsHosted.Services.Implementations.MusicBrainzMetadataProvider MusicBrainz
@inject PlexRequestsHosted.Services.Implementations.YouTubeMusicMetadataProvider YouTubeMusic
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <MudText Typo="Typo.h6">Optional media catalogs</MudText>
        <MudText Typo="Typo.body2" Color="Color.Tertiary">Choose which complete metadata experiences appear to users.</MudText>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.WifiTethering" OnClick="Test" Disabled="_testing">@TestLabel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="_loading">Save</MudButton>
    </div>
</div>

@if (_loading || _settings is null)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-content-between align-items-start gap-4 flex-wrap">
            <div style="max-width:680px;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.LibraryMusic" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Music</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Keyless catalogs</MudChip>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Tertiary">
                    Adds albums, artists, and tracks to search. ListenBrainz supplies the listening-based Trending
                    Music row, while results and details are cached locally for fast, resilient browsing.
                </MudText>
            </div>
            <MudSwitch T="bool" @bind-Value="_settings.CatalogEnabled" Color="Color.Primary" Label="Show music catalog" />
        </div>

        <MudDivider Class="my-4" />
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="_settings.MetadataProvider" ValueChanged="ChangeProvider" Label="Search metadata source"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value='@("musicbrainz")'>MusicBrainz</MudSelectItem>
                    <MudSelectItem T="string" Value='@("youtube")'>YouTube Music</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    @ProviderDescription
                </MudAlert>
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3"><MediaReadinessItem Label="Metadata" Ready="true" Detail="@ProviderName" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MediaReadinessItem Label="Artwork" Ready="true" Detail="@ArtworkSource" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MediaReadinessItem Label="Acquisition" Ready="true" Detail="@AcquisitionLabel" /></MudItem>
            <MudItem xs="12" sm="6" md="3"><MediaReadinessItem Label="Plex verification" Ready="true" Detail="Confirmed before notification" /></MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
            <div>
                <MudText Typo="Typo.subtitle2">YouTube Music direct acquisition</MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                    @(_settings.DirectDownloadsEnabled ? "Enabled as a built-in direct audio source." : "Disabled; configured release indexers remain available.")
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TravelExplore"
                       Href="/admin?tab=downloads&sub=indexers">Manage sources</MudButton>
        </div>
        <MudSwitch T="bool" @bind-Value="_settings.RequestsEnabled" Color="Color.Primary"
                   Label="Enable music requests and automatic fulfillment" Disabled="_settings.ReadinessIssues.Count > 0" />
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
            Before enabling requests, set a writable Music library path under Library → Organization and
            enable Music on an indexer. When YouTube Music is the selected catalog, direct acquisition can
            serve as the sole source; MusicBrainz keeps an indexer fallback for titles that cannot be mapped safely.
            A request is not marked Available until Plex confirms it.
        </MudAlert>
        @foreach (var issue in _settings.ReadinessIssues)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true" Class="mt-2">@issue</MudAlert>
        }

        @if (_testResult is not null)
        {
            <MudAlert Severity="@(_testResult.Value ? Severity.Success : Severity.Error)" Class="mt-3">
                @(_testResult.Value ? $"{ProviderName} is reachable and returned valid metadata." : $"{ProviderName} could not be reached. Check DNS and outbound HTTPS access.")
            </MudAlert>
        }
    </MudPaper>
}

@code {
    private MusicSettingsDto? _settings;
    private bool _loading = true;
    private bool _testing;
    private bool? _testResult;
    private string ProviderName => _settings?.MetadataProvider == "youtube" ? "YouTube Music" : "MusicBrainz";
    private string ArtworkSource => _settings?.MetadataProvider == "youtube" ? "YouTube Music" : "Cover Art Archive";
    private string AcquisitionLabel => _settings?.DirectDownloadsEnabled == true
        ? "YouTube direct + indexers" : "Modular indexers";
    private string TestLabel => $"Test {ProviderName}";
    private string ProviderDescription => _settings?.MetadataProvider == "youtube"
        ? "YouTube Music gives users its familiar catalog and artwork. Direct audio is optional; configured music indexers remain an independent fallback."
        : "MusicBrainz is the open, standards-based catalog and uses Cover Art Archive artwork. Exact matches can also use optional YouTube direct audio.";

    protected override async Task OnInitializedAsync()
    {
        try { _settings = await Settings.GetAsync(); }
        finally { _loading = false; }
    }

    private async Task Save()
    {
        if (_settings is null) return;
        try
        {
            await Settings.UpdateAsync(_settings);
            await Toast.ShowSuccessAsync(_settings.RequestsEnabled
                ? "Music catalog settings saved; requests are enabled."
                : "Music catalog settings saved.");
        }
        catch (InvalidOperationException ex)
        {
            await Toast.ShowErrorAsync(ex.Message);
            _settings = await Settings.GetAsync();
        }
    }

    private void ChangeProvider(string provider)
    {
        if (_settings is null) return;
        _settings.MetadataProvider = provider;
        _testResult = null;
    }

    private async Task Test()
    {
        _testing = true;
        _testResult = null;
        try
        {
            _testResult = _settings?.MetadataProvider == "youtube"
                ? await YouTubeMusic.CheckHealthAsync()
                : await MusicBrainz.CheckHealthAsync();
        }
        catch { _testResult = false; }
        finally { _testing = false; }
    }

}
