@using PlexRequestsHosted.Shared
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@using PlexRequestsHosted.Shared.Media
@implements IDisposable
@inject PlexRequestsHosted.Services.Implementations.IStorageOptimizationService Optimizer
@inject PlexRequestsHosted.Services.Implementations.IMediaMetadataScanService MetadataScans
@inject PlexRequestsHosted.Services.Implementations.ICustomFormatService Formats
@inject PlexRequestsHosted.Services.Abstractions.IPlexApiService Plex
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toasts
@inject IDialogService Dialogs

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <div class="optimizer-intro">
        <div>
            <MudText Typo="Typo.subtitle1"><b>Optimize storage safely</b></MudText>
            <MudText Typo="Typo.body2" Class="text-muted">
                Pick one title and combine only the goals you want. Plex Requests previews the exact files,
                verifies the downloaded media, then atomically replaces the old copy.
            </MudText>
        </div>
        <MudChip T="string" Icon="@Icons.Material.Filled.Security" Color="Color.Success" Variant="Variant.Outlined">Original stays until verified</MudChip>
    </div>

    <div class="optimizer-workspace">
    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true"
             ActivePanelIndex="_workspaceTab" ActivePanelIndexChanged="WorkspaceTabChanged"
             SliderColor="Color.Primary" Class="custom-tabs custom-subtabs" PanelClass="optimizer-workspace-panel">
    <MudTabPanel Text="Library report" Icon="@Icons.Material.Filled.Assessment">
    <MudPaper Outlined="true" Class="pa-4 efficiency-report">
        <div class="efficiency-heading">
            <div>
                <MudText Typo="Typo.subtitle1"><b>Library efficiency report</b></MudText>
                <MudText Typo="Typo.caption" Class="text-muted">@ReportSourceText Candidate storage is not an estimate of space saved.</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Disabled="_reportLoading"
                           OnClick="LoadEfficiencyReportAsync" aria-label="Refresh library efficiency report" />
        </div>

        @if (_reportLoading && _report.Titles.Count == 0)
        {
            <div class="d-flex justify-content-center py-5"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else if (_report.Titles.Count == 0)
        {
            <div class="activity-empty compact"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /><strong>No video inventory yet</strong><span>The report appears after a Plex inventory scan or a successful import.</span></div>
        }
        else
        {
            <div class="efficiency-filters">
                <MudTextField T="string" @bind-Value="_reportSearch" Label="Find a title" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
                <MudSelect T="string" @bind-Value="_reportLibrary" Label="Library" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@AllLibraries">All libraries</MudSelectItem>
                    @foreach (var library in ReportLibraries)
                    {
                        <MudSelectItem Value="@library">@library</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_reportMedia" Label="Media" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@AllMedia">All media</MudSelectItem>
                    <MudSelectItem Value="@MoviesMedia">Movies</MudSelectItem>
                    <MudSelectItem Value="@SeriesMedia">TV series</MudSelectItem>
                    <MudSelectItem Value="@AnimeMedia">Anime</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" @bind-Value="_reportView" Label="Show" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@OpportunityView">Opportunities</MudSelectItem>
                    <MudSelectItem Value="@LegacyView">Known HEVC candidates</MudSelectItem>
                    <MudSelectItem Value="@UnknownView">Needs codec scan</MudSelectItem>
                    <MudSelectItem Value="@EfficientView">Already HEVC / AV1</MudSelectItem>
                    <MudSelectItem Value="@UltraHdView">4K storage</MudSelectItem>
                    <MudSelectItem Value="@AllView">All titles</MudSelectItem>
                </MudSelect>
            </div>

            <div class="efficiency-summary">
                <div><MudIcon Icon="@Icons.Material.Filled.Storage" /><span><small>Measured scope</small><strong>@FormatBytes(ScopedBytes)</strong><em>@ScopedTitles.Count titles · @ScopedFileCount files</em></span></div>
                <div><MudIcon Icon="@Icons.Material.Filled.Compress" /><span><small>Known HEVC candidates</small><strong>@FormatBytes(ScopedLegacyBytes)</strong><em>@ScopedLegacyFiles non-HEVC / AV1 files</em></span></div>
                <div><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /><span><small>HEVC / AV1 now</small><strong>@FormatBytes(ScopedModernBytes)</strong><em>@Percent(ScopedModernBytes, ScopedBytes) of measured storage</em></span></div>
                <div><MudIcon Icon="@Icons.Material.Filled.Help" /><span><small>Needs codec scan</small><strong>@ScopedUnknownFiles files</strong><em>@FormatBytes(ScopedUnknownBytes) cannot be classified yet</em></span></div>
            </div>

            @if (ScopedUnknownFiles > 0 && _report.UsesPlexInventory)
            {
                <div class="metadata-scan-callout">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" />
                    <div>
                        <strong>Plex did not classify every file</strong>
                        <span>The report keeps those files visible as unknown. Refresh Plex availability from Server health after Plex finishes analyzing them.</span>
                    </div>
                </div>
            }
            else if (ScopedUnknownFiles > 0)
            {
                <div class="metadata-scan-callout">
                    <MudIcon Icon="@Icons.Material.Filled.FindInPage" />
                    <div>
                        <strong>Fill missing codec data from the library</strong>
                        <span>MediaInfo reads each audited file in place. It does not download, rename, move, replace, or alter media.</span>
                        @if (ScopedMetadataScanQueuedCount + ScopedMetadataScanInProgressCount > 0)
                        {
                            <small>@ScanScopeStatus</small>
                        }
                        else if (ScopedMetadataScanFailedCount > 0)
                        {
                            <small>@ScopedMetadataScanFailedCount scan@(ScopedMetadataScanFailedCount == 1 ? string.Empty : "s") need attention and can be retried.</small>
                        }
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.DocumentScanner"
                               Disabled="@(_metadataQueueing || ScanScopeFileCount == 0)"
                               OnClick="QueueCodecScansAsync">
                        @(_metadataQueueing ? "Queueing…" : ScanButtonLabel)
                    </MudButton>
                </div>
            }

            @if (ScopedBytes > 0)
            {
                <div class="efficiency-composition" role="img" aria-label="Storage by codec classification">
                    @if (ScopedModernBytes > 0) { <span class="modern" style="width:@WidthPercent(ScopedModernBytes, ScopedBytes)"></span> }
                    @if (ScopedLegacyBytes > 0) { <span class="legacy" style="width:@WidthPercent(ScopedLegacyBytes, ScopedBytes)"></span> }
                    @if (ScopedUnknownBytes > 0) { <span class="unknown" style="width:@WidthPercent(ScopedUnknownBytes, ScopedBytes)"></span> }
                </div>
                <div class="efficiency-legend"><span class="modern">HEVC / AV1</span><span class="legacy">Other known codecs</span><span class="unknown">Unknown</span></div>
            }

            <div class="efficiency-results-heading">
                <span>Showing @ReportRows.Count of @ScopedTitles.Count titles · updated @RelativeTime(_report.InventoryUpdatedAt ?? _report.GeneratedAt)</span>
                <MudSelect T="string" @bind-Value="_reportSort" Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@ReviewSort">Most storage to review</MudSelectItem>
                    <MudSelectItem Value="@LargestSort">Largest title</MudSelectItem>
                    <MudSelectItem Value="@UltraHdSort">Most 4K storage</MudSelectItem>
                    <MudSelectItem Value="@TitleSort">Title A–Z</MudSelectItem>
                </MudSelect>
            </div>

            @if (ReportRows.Count == 0)
            {
                <div class="activity-empty compact"><MudIcon Icon="@Icons.Material.Filled.SearchOff" /><strong>No titles match these filters</strong></div>
            }
            else
            {
                <div class="efficiency-list">
                    @foreach (var item in ReportRows)
                    {
                        <article class="efficiency-row" @key="item.InventoryKey">
                            <div class="efficiency-title">
                                <strong>@item.Title@(item.Year is int year ? $" ({year})" : string.Empty)</strong>
                                <span>@MediaLabel(item) · @string.Join(", ", item.Libraries) · @item.FileCount files</span>
                                <small>@item.ResolutionSummary · @item.CodecSummary</small>
                            </div>
                            <div class="efficiency-storage">
                                <span><small>Total</small><strong>@FormatBytes(item.SizeBytes)</strong></span>
                                <span><small>Review</small><strong>@FormatBytes(item.ReviewBytes)</strong></span>
                                @if (item.UltraHdFileCount > 0)
                                {
                                    <span><small>4K+</small><strong>@FormatBytes(item.UltraHdBytes)</strong></span>
                                }
                            </div>
                            <div class="efficiency-reasons">
                                @if (item.LegacyCodecFileCount > 0)
                                {
                                    <span class="candidate"><MudIcon Icon="@Icons.Material.Filled.Compress" Size="Size.Small" /> @item.LegacyCodecFileCount known HEVC candidate@(item.LegacyCodecFileCount == 1 ? string.Empty : "s")</span>
                                }
                                @if (item.UnknownCodecFileCount > 0)
                                {
                                    <span class="audit"><MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" /> @item.UnknownCodecFileCount need@(item.UnknownCodecFileCount == 1 ? "s" : string.Empty) codec data</span>
                                }
                                @if (item.MetadataScanQueuedCount > 0 || item.MetadataScanInProgressCount > 0)
                                {
                                    <span class="scan-active"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" /> @ScanStatus(item)</span>
                                }
                                @if (item.MetadataScanFailedCount > 0)
                                {
                                    <span class="scan-failed" title="@item.MetadataScanDetail"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" /> @item.MetadataScanFailedCount scan@(item.MetadataScanFailedCount == 1 ? "" : "s") failed · retry available</span>
                                }
                                @if (item.LegacyCodecFileCount == 0 && item.UnknownCodecFileCount == 0)
                                {
                                    <span class="efficient"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> Efficient codec throughout</span>
                                }
                                @if (!item.CanOptimize)
                                {
                                    @if (item.CanAdopt)
                                    {
                                        <span class="scan-active"><MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" /> Ready for admin setup</span>
                                    }
                                    else
                                    {
                                        <span class="audit"><MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /> Report only · @item.AdoptionBlockReason</span>
                                    }
                                }
                            </div>
                            <div class="d-flex gap-2 align-center">
                                @if (item.CanLinkIdentity)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.ManageSearch"
                                               Disabled="@_identityLinking.Contains(item.InventoryKey)"
                                               OnClick="@(() => BeginIdentityLink(item))">Find identity</MudButton>
                                }
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@(item.CanOptimize ? Icons.Material.Filled.Tune : Icons.Material.Filled.Link)"
                                           Disabled="@((!item.CanOptimize && !item.CanAdopt) || item.HasActiveJob || _adopting.Contains(item.InventoryKey))"
                                           title="@OptimizationAvailability(item)"
                                           OnClick="@(() => OpenFromReportAsync(item))">@ReportActionLabel(item)</MudButton>
                            </div>
                            @if (_identityInventoryKey == item.InventoryKey)
                            {
                                <div class="identity-linker">
                                    <MudText Typo="Typo.caption">Choose the matching metadata result. This only links metadata; it does not download or change files.</MudText>
                                    <div class="d-flex gap-2 align-center">
                                        <MudTextField T="string" @bind-Value="_identitySearch" Label="Search metadata"
                                                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary"
                                                   Disabled="@(_identitySearching || string.IsNullOrWhiteSpace(_identitySearch))"
                                                   OnClick="@(() => SearchIdentityAsync(item))">@(_identitySearching ? "Searching…" : "Search")</MudButton>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseIdentityLink" aria-label="Close identity search" />
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(_identitySearchMessage))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">@_identitySearchMessage</MudText>
                                    }
                                    @foreach (var candidate in _identityResults)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   Disabled="@_identityLinking.Contains(item.InventoryKey)"
                                                   OnClick="@(() => ConfirmIdentityLinkAsync(item, candidate))">
                                            Use @candidate.Title@(candidate.Year is int candidateYear ? $" ({candidateYear})" : string.Empty)
                                        </MudButton>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        }
    </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Build a plan" Icon="@Icons.Material.Filled.Tune">
    <div class="optimizer-layout">
        <MudPaper Outlined="true" Class="pa-3 optimizer-browser">
            <MudTextField T="string" @bind-Value="_search" Label="Find a movie or series" Immediate="true"
                          Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <div class="optimizer-title-list">
                @foreach (var title in FilteredTitles)
                {
                    <button type="button" class="optimizer-title @(title.RequestId == _selected?.RequestId ? "selected" : "")"
                            @onclick="() => SelectTitle(title)">
                        <span><b>@title.Title</b><small>@TitleDetail(title)</small></span>
                        @if (title.HasActiveJob)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Busy</MudChip>
                        }
                        else
                        {
                            <span class="optimizer-size">@FormatBytes(title.SizeBytes)</span>
                        }
                    </button>
                }
                @if (FilteredTitles.Count == 0)
                {
                    <div class="activity-empty compact"><MudIcon Icon="@Icons.Material.Filled.SearchOff" /><strong>No imported titles match</strong></div>
                }
            </div>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 optimizer-builder">
            @if (_selected is null)
            {
                <div class="activity-empty"><MudIcon Icon="@Icons.Material.Filled.Tune" /><strong>Choose a title</strong><span>Nothing is queued until you preview and confirm a specific scope.</span></div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <MudText Typo="Typo.h6">@_selected.Title</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">@_selected.FileCount files · @FormatBytes(_selected.SizeBytes) · @_selected.HevcFileCount measured HEVC@(_selected.UnknownCodecCount > 0 ? $" · {_selected.UnknownCodecCount} need a codec scan" : string.Empty)</MudText>
                    </div>
                    @if (_selected.IsAnime) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Anime</MudChip> }
                </div>

                @if (_selected.Seasons.Count > 0)
                {
                    <div class="optimizer-section">
                        <MudText Typo="Typo.subtitle2">1. Choose seasons</MudText>
                        <div class="optimizer-season-grid">
                            @foreach (var season in _selected.Seasons)
                            {
                                <label class="optimizer-season">
                                    <MudCheckBox T="bool" Value="@_seasons.Contains(season.Season)"
                                                 ValueChanged="value => ToggleSeason(season.Season, value)" Color="Color.Primary" />
                                    <span><b>@SeasonLabel(season.Season)</b><small>@season.FileCount files · @FormatBytes(season.SizeBytes)<br />@season.ResolutionSummary · @season.CodecSummary</small></span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="optimizer-section">
                    <MudText Typo="Typo.subtitle2">@(_selected.Seasons.Count > 0 ? "2." : "1.") Combine goals</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">A replacement must satisfy every selected goal.</MudText>
                    <div class="optimizer-goals">
                        <label class="optimizer-goal">
                            <MudSwitch T="bool" Value="_requireHevc" ValueChanged="SetHevcGoal" Color="Color.Primary" />
                            <span><b>Use HEVC (H.265)</b><small>Backfill measured non-HEVC files. Missing codec data is scanned before any replacement search.</small></span>
                        </label>
                        <div class="optimizer-goal field">
                            <span><b>Resolution</b><small>Keep current avoids a downgrade; choose an exact tier for a targeted conversion.</small></span>
                            <MudSelect T="Quality" Value="_quality" ValueChanged="SetQualityGoal"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="Quality.Any">Keep current</MudSelectItem>
                                <MudSelectItem Value="Quality.HD">720p</MudSelectItem>
                                <MudSelectItem Value="Quality.FullHD">1080p</MudSelectItem>
                                <MudSelectItem Value="Quality.UHD4K">4K</MudSelectItem>
                            </MudSelect>
                        </div>
                        <div class="optimizer-goal field">
                            <span><b>Minimum space saved</b><small>Reject releases that cannot prove this saving. Use 0% for a resolution upgrade.</small></span>
                            <MudNumericField T="int" Value="_minimumSavings" ValueChanged="SetSavingsGoal"
                                             Min="0" Max="95" Adornment="Adornment.End"
                                             AdornmentText="%" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                    </div>

                    @if (_formats.Count > 0)
                    {
                        <details class="profile-option mt-3">
                            <summary><span><b>Additional reusable formats</b><small>Optional HDR, release-group, edition, audio, or other rules.</small></span><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_formatIds.Count selected</MudChip></summary>
                            <div class="profile-option-content optimizer-format-grid">
                                @foreach (var format in _formats.Where(item => item.Enabled))
                                {
                                    <MudCheckBox T="bool" Label="@format.Name" Value="@_formatIds.Contains(format.Id)"
                                                 ValueChanged="value => ToggleFormat(format.Id, value)" Color="Color.Primary" />
                                }
                            </div>
                        </details>
                    }

                    <div class="optimizer-future">
                        <MudChip T="string" Size="Size.Small" Disabled="true">AV1 · future</MudChip>
                        <span>AV1 is intentionally not offered until your playback devices can be declared compatible.</span>
                    </div>
                </div>

                <div class="optimizer-actions">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Preview"
                               Disabled="_previewing || _selected.HasActiveJob" OnClick="Preview">
                        @(_previewing ? "Checking…" : "Preview changes")
                    </MudButton>
                </div>

                @if (_preview is not null)
                {
                    <MudAlert Severity="@(_preview.CanQueue ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mt-3">
                        <b>@(_preview.CanQueue ? $"{_preview.SelectedFileCount} file(s) selected" : "Nothing queued")</b><br />
                        @_preview.Message
                        @if (_preview.RequiresCodecScan)
                        {
                            <div class="mt-2">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.DocumentScanner"
                                           Disabled="@(_metadataQueueing || SelectedScanFileCount == 0)"
                                           OnClick="QueueSelectedCodecScansAsync">
                                    @(_metadataQueueing ? "Queueing…" : SelectedScanFileCount == 0 ? "Scan already queued" : "Scan codec metadata")
                                </MudButton>
                            </div>
                        }
                        @if (_preview.CanQueue)
                        {
                            <div class="mt-2">Goals: @string.Join(" + ", _preview.Goals) · Current @FormatBytes(_preview.CurrentBytes)@SavingsPreview(_preview)</div>
                        }
                    </MudAlert>
                    @if (_preview.CanQueue)
                    {
                        <div class="d-flex justify-content-end mt-3">
                            <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                                       Disabled="_queueing" OnClick="Queue">@(_queueing ? "Queueing…" : "Queue these replacements")</MudButton>
                        </div>
                    }
                }
            }
        </MudPaper>
    </div>
    </MudTabPanel>

    <MudTabPanel Text="Activity" Icon="@Icons.Material.Filled.History">
    <MudPaper Outlined="true" Class="pa-4 optimizer-activity-panel">
        <div class="optimizer-activity-heading">
            <div>
                <MudText Typo="Typo.subtitle1"><b>Optimization activity</b></MudText>
                <MudText Typo="Typo.caption" Class="text-muted">Frozen goals, search diagnostics, safe controls, and verified storage results.</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Disabled="_activityLoading"
                           OnClick="LoadActivityAsync" aria-label="Refresh optimization activity" />
        </div>

        @if (_activityLoading && _activity.Count == 0)
        {
            <div class="d-flex justify-content-center py-5"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else if (_activity.Count == 0)
        {
            <div class="activity-empty compact"><MudIcon Icon="@Icons.Material.Filled.History" /><strong>No optimization history yet</strong><span>Preview and queue a title from Build a plan when you are ready.</span></div>
        }
        else
        {
            <div class="optimizer-activity-list">
                @foreach (var item in _activity)
                {
                    <article class="optimizer-activity-card" @key="item.JobId">
                        <div class="optimizer-activity-main">
                            <div class="optimizer-activity-title">
                                <MudChip T="string" Size="Size.Small" Color="@ActivityColor(item.Status)" Variant="Variant.Outlined">@item.Stage</MudChip>
                                <div>
                                    <strong>@item.Title@(item.Year is int year ? $" ({year})" : string.Empty)</strong>
                                    <small>@ActivityScope(item) · queued @RelativeTime(item.CreatedAt)</small>
                                </div>
                            </div>
                            <span class="optimizer-activity-time">Updated @RelativeTime(item.UpdatedAt)</span>
                        </div>

                        <div class="optimizer-activity-goals">
                            @foreach (var goal in item.Goals)
                            {
                                <span>@goal</span>
                            }
                        </div>

                        @if (IsActive(item.Status))
                        {
                            <div class="optimizer-activity-progress" role="progressbar" aria-label="@item.Title optimization progress"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@item.Progress">
                                <span style="width:@($"{item.Progress}%")"></span>
                            </div>
                        }

                        <div class="optimizer-activity-details">
                            <span><small>Original size</small><strong>@FormatBytes(item.OriginalBytes)</strong></span>
                            <span><small>Replacement</small><strong>@(item.ReplacementBytes is long replacement ? FormatBytes(replacement) : "Pending")</strong></span>
                            <span><small>Result</small><strong>@SavingsResult(item)</strong></span>
                            <span><small>Attempts</small><strong>@item.Attempts@(item.DeferCount > 0 ? $" · {item.DeferCount} waits" : string.Empty)</strong></span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.LastError))
                        {
                            <MudAlert Severity="@(item.Status == FulfillmentStatus.Failed ? Severity.Error : Severity.Warning)"
                                      Dense="true" Variant="Variant.Outlined">
                                <b>@(item.Status == FulfillmentStatus.Deferred ? "Last search: " : string.Empty)</b>@item.LastError
                            </MudAlert>
                        }

                        <div class="optimizer-activity-footer">
                            <span>@(item.NextRetryAt is DateTime retry ? $"Automatic retry {RelativeFuture(retry)}" : ActivityFootnote(item))</span>
                            <div>
                                @if (item.CanRetry)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Refresh" Disabled="@_acting.Contains(item.JobId)"
                                               OnClick="() => RetryOptimization(item)">Search now</MudButton>
                                }
                                @if (item.CanCancel)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.Cancel" Disabled="@_acting.Contains(item.JobId)"
                                               OnClick="() => CancelOptimization(item)">Cancel plan</MudButton>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </MudPaper>
    </MudTabPanel>
    </MudTabs>
    </div>
}

@code {
    private bool _loading = true;
    private bool _previewing;
    private bool _queueing;
    private bool _reportLoading;
    private bool _metadataQueueing;
    private readonly HashSet<string> _adopting = new(StringComparer.Ordinal);
    private readonly HashSet<string> _identityLinking = new(StringComparer.Ordinal);
    private int _workspaceTab;
    private string _search = string.Empty;
    private string _reportSearch = string.Empty;
    private string _reportLibrary = AllLibraries;
    private string _reportMedia = AllMedia;
    private string _reportView = OpportunityView;
    private string _reportSort = ReviewSort;
    private string? _identityInventoryKey;
    private string _identitySearch = string.Empty;
    private string? _identitySearchMessage;
    private bool _identitySearching;
    private List<MediaCardDto> _identityResults = new();
    private List<StorageOptimizationTitleDto> _titles = new();
    private LibraryEfficiencyReportDto _report = new();
    private List<CustomFormatDto> _formats = new();
    private StorageOptimizationTitleDto? _selected;
    private HashSet<int> _seasons = new();
    private HashSet<int> _formatIds = new();
    private bool _requireHevc = true;
    private Quality _quality = Quality.Any;
    private int _minimumSavings = 10;
    private StorageOptimizationPreviewDto? _preview;
    private List<StorageOptimizationActivityDto> _activity = new();
    private HashSet<int> _acting = new();
    private bool _activityLoading;
    private PeriodicTimer? _activityTimer;
    private CancellationTokenSource? _activityCts;

    private const string AllLibraries = "all-libraries";
    private const string AllMedia = "all-media";
    private const string MoviesMedia = "movies";
    private const string SeriesMedia = "series";
    private const string AnimeMedia = "anime";
    private const string OpportunityView = "opportunities";
    private const string LegacyView = "legacy";
    private const string UnknownView = "unknown";
    private const string EfficientView = "efficient";
    private const string UltraHdView = "ultra-hd";
    private const string AllView = "all";
    private const string ReviewSort = "review";
    private const string LargestSort = "largest";
    private const string UltraHdSort = "ultra-hd";
    private const string TitleSort = "title";

    private List<string> ReportLibraries => _report.Titles.SelectMany(item => item.Libraries)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToList();

    private List<LibraryEfficiencyTitleDto> ScopedTitles => _report.Titles.Where(item =>
            (_reportLibrary == AllLibraries || item.Libraries.Contains(_reportLibrary, StringComparer.OrdinalIgnoreCase))
            && (_reportMedia switch
            {
                MoviesMedia => item.MediaType == MediaType.Movie,
                SeriesMedia => item.MediaType == MediaType.TvShow && !item.IsAnime,
                AnimeMedia => item.IsAnime,
                _ => true
            })).ToList();

    private List<LibraryEfficiencyTitleDto> ReportRows
    {
        get
        {
            var query = ScopedTitles.Where(item => string.IsNullOrWhiteSpace(_reportSearch)
                || item.Title.Contains(_reportSearch, StringComparison.OrdinalIgnoreCase));
            query = _reportView switch
            {
                LegacyView => query.Where(item => item.LegacyCodecFileCount > 0),
                UnknownView => query.Where(item => item.UnknownCodecFileCount > 0),
                EfficientView => query.Where(item => item.LegacyCodecFileCount == 0 && item.UnknownCodecFileCount == 0),
                UltraHdView => query.Where(item => item.UltraHdFileCount > 0),
                AllView => query,
                _ => query.Where(item => item.LegacyCodecFileCount > 0 || item.UnknownCodecFileCount > 0)
            };
            IOrderedEnumerable<LibraryEfficiencyTitleDto> ordered = _reportSort switch
            {
                LargestSort => query.OrderByDescending(item => item.SizeBytes),
                UltraHdSort => query.OrderByDescending(item => item.UltraHdBytes),
                TitleSort => query.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase),
                _ => query.OrderByDescending(item => item.ReviewBytes)
            };
            return ordered.ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase).Take(80).ToList();
        }
    }

    private long ScopedBytes => ScopedTitles.Sum(item => item.SizeBytes);
    private int ScopedFileCount => ScopedTitles.Sum(item => item.FileCount);
    private long ScopedModernBytes => ScopedTitles.Sum(item => item.ModernCodecBytes);
    private long ScopedLegacyBytes => ScopedTitles.Sum(item => item.LegacyCodecBytes);
    private int ScopedLegacyFiles => ScopedTitles.Sum(item => item.LegacyCodecFileCount);
    private long ScopedUnknownBytes => ScopedTitles.Sum(item => item.UnknownCodecBytes);
    private int ScopedUnknownFiles => ScopedTitles.Sum(item => item.UnknownCodecFileCount);
    private int ScopedMetadataScanQueuedCount => ScopedTitles.Sum(item => item.MetadataScanQueuedCount);
    private int ScopedMetadataScanInProgressCount => ScopedTitles.Sum(item => item.MetadataScanInProgressCount);
    private int ScopedMetadataScanRetryingCount => ScopedTitles.Sum(item => item.MetadataScanRetryingCount);
    private int ScopedMetadataScanFailedCount => ScopedTitles.Sum(item => item.MetadataScanFailedCount);
    private List<LibraryEfficiencyTitleDto> ScanScopeTitles => ScopedTitles
        .Where(item => !_report.UsesPlexInventory && item.UnknownCodecFileCount > 0 && !item.HasActiveJob
                       && (string.IsNullOrWhiteSpace(_reportSearch)
                           || item.Title.Contains(_reportSearch, StringComparison.OrdinalIgnoreCase)))
        .Take(200).ToList();
    private int ScanScopeFileCount => ScanScopeTitles.Sum(item => Math.Max(0,
        item.UnknownCodecFileCount - item.MetadataScanQueuedCount - item.MetadataScanInProgressCount));
    private string ScanButtonLabel => ScanScopeFileCount == 1
        ? "Scan 1 file"
        : $"Scan {ScanScopeFileCount} files";
    private int SelectedScanFileCount => _preview?.CodecScanFileIds.Count
        ?? _selected?.UnknownCodecCount ?? 0;

    private List<StorageOptimizationTitleDto> FilteredTitles => _titles
        .Where(item => string.IsNullOrWhiteSpace(_search)
                       || item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Take(60).ToList();

    protected override async Task OnInitializedAsync()
    {
        _titles = await Optimizer.GetTitlesAsync();
        _report = await Optimizer.GetEfficiencyReportAsync();
        _formats = await Formats.GetAllAsync();
        await LoadActivityAsync();
        _loading = false;
        _activityCts = new CancellationTokenSource();
        _activityTimer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = PollActivityAsync(_activityCts.Token);
    }

    private void SelectTitle(StorageOptimizationTitleDto title)
    {
        _selected = title;
        _seasons = title.Seasons.Select(season => season.Season).ToHashSet();
        _formatIds.Clear();
        _requireHevc = true;
        _quality = Quality.Any;
        _minimumSavings = 10;
        _preview = null;
    }

    private void SelectFromReport(int requestId)
    {
        var title = _titles.FirstOrDefault(item => item.RequestId == requestId);
        if (title is null) return;
        SelectTitle(title);
        _workspaceTab = 1;
    }

    private async Task OpenFromReportAsync(LibraryEfficiencyTitleDto item)
    {
        if (item.CanOptimize)
        {
            SelectFromReport(item.RequestId);
            return;
        }
        if (!item.CanAdopt || !_adopting.Add(item.InventoryKey)) return;
        try
        {
            var confirmed = await Dialogs.ShowMessageBox("Connect Plex library title",
                $"Connect “{item.Title}” to the optimizer? This creates an internal library record only. "
                + "Nothing is downloaded, replaced, moved, or deleted until you separately preview and confirm a plan.",
                yesText: "Connect title", cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await Optimizer.AdoptPlexTitleAsync(item.InventoryKey);
            if (!result.Success)
            {
                await Toasts.ShowErrorAsync(result.Message);
                return;
            }
            await Toasts.ShowSuccessAsync(result.Message);
            _titles = await Optimizer.GetTitlesAsync();
            _report = await Optimizer.GetEfficiencyReportAsync();
            SelectFromReport(result.RequestId);
        }
        catch (Exception ex)
        {
            await Toasts.ShowErrorAsync(ex.Message);
        }
        finally
        {
            _adopting.Remove(item.InventoryKey);
        }
    }

    private void BeginIdentityLink(LibraryEfficiencyTitleDto item)
    {
        _identityInventoryKey = item.InventoryKey;
        _identitySearch = item.Title;
        _identitySearchMessage = null;
        _identityResults = new();
    }

    private void CloseIdentityLink()
    {
        _identityInventoryKey = null;
        _identitySearchMessage = null;
        _identityResults = new();
    }

    private async Task SearchIdentityAsync(LibraryEfficiencyTitleDto item)
    {
        if (string.IsNullOrWhiteSpace(_identitySearch)) return;
        _identitySearching = true;
        _identitySearchMessage = null;
        _identityResults = new();
        try
        {
            var searchType = item.MediaType == MediaType.Anime ? MediaType.TvShow : item.MediaType;
            _identityResults = (await Plex.SearchMediaAsync(_identitySearch.Trim(), searchType))
                .Where(candidate => candidate.ResolveMediaRef().IsValid
                                    && CompatibleIdentityType(candidate.MediaType, item.MediaType))
                .Take(8).ToList();
            if (_identityResults.Count == 0)
                _identitySearchMessage = "No compatible metadata results were found. Try a more specific title.";
        }
        catch (Exception ex)
        {
            _identitySearchMessage = ex.Message;
        }
        finally
        {
            _identitySearching = false;
        }
    }

    private async Task ConfirmIdentityLinkAsync(LibraryEfficiencyTitleDto item, MediaCardDto candidate)
    {
        if (!_identityLinking.Add(item.InventoryKey)) return;
        try
        {
            var label = candidate.Title + (candidate.Year is int year ? $" ({year})" : string.Empty);
            var confirmed = await Dialogs.ShowMessageBox("Link Plex title identity",
                $"Link Plex “{item.Title}” to “{label}”? This stores only the metadata identity. "
                + "It does not create a request, queue a download, move, replace, or delete files.",
                yesText: "Link identity", cancelText: "Cancel");
            if (confirmed != true) return;
            var result = await Optimizer.LinkPlexTitleIdentityAsync(new PlexLibraryIdentityLinkRequestDto
            {
                InventoryKey = item.InventoryKey,
                MediaRef = candidate.ResolveMediaRef(),
                Title = candidate.Title,
                Year = candidate.Year
            });
            if (!result.Success)
            {
                await Toasts.ShowErrorAsync(result.Message);
                return;
            }
            await Toasts.ShowSuccessAsync(result.Message);
            CloseIdentityLink();
            _report = await Optimizer.GetEfficiencyReportAsync();
        }
        catch (Exception ex)
        {
            await Toasts.ShowErrorAsync(ex.Message);
        }
        finally
        {
            _identityLinking.Remove(item.InventoryKey);
        }
    }

    private static bool CompatibleIdentityType(MediaType candidateType, MediaType plexType) => plexType switch
    {
        MediaType.Movie => candidateType == MediaType.Movie,
        MediaType.TvShow or MediaType.Anime => candidateType is MediaType.TvShow or MediaType.Anime,
        _ => false
    };

    private async Task WorkspaceTabChanged(int value)
    {
        _workspaceTab = value;
        if (value == 2) await LoadActivityAsync();
    }

    private void ToggleSeason(int season, bool selected)
    {
        if (selected) _seasons.Add(season); else _seasons.Remove(season);
        _preview = null;
    }

    private void ToggleFormat(int id, bool selected)
    {
        if (selected) _formatIds.Add(id); else _formatIds.Remove(id);
        _preview = null;
    }

    private void SetHevcGoal(bool value)
    {
        _requireHevc = value;
        _preview = null;
    }

    private void SetQualityGoal(Quality value)
    {
        _quality = value;
        _preview = null;
    }

    private void SetSavingsGoal(int value)
    {
        _minimumSavings = Math.Clamp(value, 0, 95);
        _preview = null;
    }

    private StorageOptimizationRequestDto BuildRequest() => new()
    {
        RequestId = _selected?.RequestId ?? 0,
        Seasons = _seasons.Order().ToList(),
        TargetQuality = _quality,
        RequireHevc = _requireHevc,
        RequiredCustomFormatIds = _formatIds.Order().ToList(),
        MinimumSavingsPercent = _minimumSavings
    };

    private async Task Preview()
    {
        _previewing = true;
        try { _preview = await Optimizer.PreviewAsync(BuildRequest()); }
        catch (Exception ex) { _preview = new StorageOptimizationPreviewDto { Message = ex.Message }; }
        finally { _previewing = false; }
    }

    private async Task Queue()
    {
        _queueing = true;
        try
        {
            var result = await Optimizer.QueueAsync(BuildRequest());
            if (result.Success)
            {
                await Toasts.ShowSuccessAsync(result.Message);
                _titles = await Optimizer.GetTitlesAsync();
                _report = await Optimizer.GetEfficiencyReportAsync();
                _selected = _titles.FirstOrDefault(item => item.RequestId == _selected?.RequestId);
                await LoadActivityAsync();
                _preview = null;
            }
            else await Toasts.ShowErrorAsync(result.Message);
        }
        catch (Exception ex) { await Toasts.ShowErrorAsync(ex.Message); }
        finally { _queueing = false; }
    }

    private async Task PollActivityAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _activityTimer!.WaitForNextTickAsync(cancellationToken))
            {
                if (_workspaceTab == 2) await InvokeAsync(LoadActivityAsync);
                else if ((_workspaceTab is 0 or 1)
                         && _report.MetadataScanQueuedCount + _report.MetadataScanInProgressCount > 0)
                    await InvokeAsync(LoadEfficiencyReportAsync);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadActivityAsync()
    {
        if (_activityLoading) return;
        _activityLoading = true;
        try { _activity = await Optimizer.GetActivityAsync(); }
        catch (Exception ex) { await Toasts.ShowErrorAsync($"Could not load optimization activity: {ex.Message}"); }
        finally
        {
            _activityLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadEfficiencyReportAsync()
    {
        if (_reportLoading) return;
        _reportLoading = true;
        try
        {
            _report = await Optimizer.GetEfficiencyReportAsync();
            if (_workspaceTab == 1 && _selected is not null)
            {
                var selectedId = _selected.RequestId;
                _titles = await Optimizer.GetTitlesAsync();
                _selected = _titles.FirstOrDefault(item => item.RequestId == selectedId);
                if (_selected is not null && _preview?.RequiresCodecScan == true)
                    _preview = await Optimizer.PreviewAsync(BuildRequest());
            }
        }
        catch (Exception ex) { await Toasts.ShowErrorAsync($"Could not load the efficiency report: {ex.Message}"); }
        finally
        {
            _reportLoading = false;
            StateHasChanged();
        }
    }

    private Task QueueCodecScansAsync() => QueueCodecScansAsync(new MediaMetadataScanRequestDto
        {
            RequestIds = ScanScopeTitles.Select(item => item.RequestId).Distinct().ToList()
        }, ScanScopeFileCount,
        "the current report scope");

    private Task QueueSelectedCodecScansAsync() => _selected is null
        ? Task.CompletedTask
        : QueueCodecScansAsync(new MediaMetadataScanRequestDto
        {
            ImportedFileIds = _preview?.CodecScanFileIds.ToList() ?? []
        }, SelectedScanFileCount, $"“{_selected.Title}”");

    private async Task QueueCodecScansAsync(MediaMetadataScanRequestDto request, int count, string scope)
    {
        if (_metadataQueueing || count == 0
            || (request.RequestIds.Count == 0 && request.ImportedFileIds.Count == 0)) return;
        var confirmed = await Dialogs.ShowMessageBox(
            "Read missing codec metadata?",
            $"Queue a read-only MediaInfo inspection for {count} file{(count == 1 ? string.Empty : "s")} in {scope}? "
            + "This does not download, rename, move, replace, or alter any media.",
            yesText: "Queue scan", cancelText: "Cancel");
        if (confirmed != true) return;

        _metadataQueueing = true;
        try
        {
            var result = await MetadataScans.QueueAsync(request);
            if (result.Success) await Toasts.ShowSuccessAsync(result.Message);
            else if (result.AlreadyRunningCount > 0) await Toasts.ShowInfoAsync(result.Message);
            else await Toasts.ShowErrorAsync(result.Message);
            await LoadEfficiencyReportAsync();
        }
        catch (Exception ex) { await Toasts.ShowErrorAsync($"Could not queue codec scans: {ex.Message}"); }
        finally
        {
            _metadataQueueing = false;
            StateHasChanged();
        }
    }

    private async Task RetryOptimization(StorageOptimizationActivityDto item)
    {
        if (!_acting.Add(item.JobId)) return;
        try
        {
            var result = await Optimizer.RetryAsync(item.JobId);
            if (result.Success) await Toasts.ShowSuccessAsync(result.Message);
            else await Toasts.ShowErrorAsync(result.Message);
            await RefreshAfterActionAsync();
        }
        catch (Exception ex) { await Toasts.ShowErrorAsync(ex.Message); }
        finally
        {
            _acting.Remove(item.JobId);
            StateHasChanged();
        }
    }

    private async Task CancelOptimization(StorageOptimizationActivityDto item)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Cancel optimization?",
            $"Stop looking for an optimized copy of \"{item.Title}\"? Existing library files will remain available.",
            yesText: "Cancel plan", cancelText: "Keep searching");
        if (confirmed != true || !_acting.Add(item.JobId)) return;
        try
        {
            var result = await Optimizer.CancelAsync(item.JobId);
            if (result.Success) await Toasts.ShowSuccessAsync(result.Message);
            else await Toasts.ShowErrorAsync(result.Message);
            await RefreshAfterActionAsync();
        }
        catch (Exception ex) { await Toasts.ShowErrorAsync(ex.Message); }
        finally
        {
            _acting.Remove(item.JobId);
            StateHasChanged();
        }
    }

    private async Task RefreshAfterActionAsync()
    {
        var selectedRequestId = _selected?.RequestId;
        _titles = await Optimizer.GetTitlesAsync();
        _report = await Optimizer.GetEfficiencyReportAsync();
        _selected = _titles.FirstOrDefault(item => item.RequestId == selectedRequestId);
        await LoadActivityAsync();
    }

    private static string TitleDetail(StorageOptimizationTitleDto title) =>
        $"{(title.MediaType == MediaType.Movie ? "Movie" : title.IsAnime ? "Anime series" : "Series")}" +
        (title.Year is int year ? $" · {year}" : string.Empty) + $" · {title.FileCount} files";
    private static string SeasonLabel(int season) => season == 0 ? "Specials" : $"Season {season}";
    private static string FormatBytes(long bytes) => bytes >= 1_000_000_000
        ? $"{bytes / 1_000_000_000d:0.0} GB" : $"{bytes / 1_000_000d:0} MB";
    private static string SavingsPreview(StorageOptimizationPreviewDto preview) =>
        preview.MaximumReplacementBytes == long.MaxValue ? string.Empty
            : $" · Replacement must be at most {FormatBytes(preview.MaximumReplacementBytes)}";

    private static string MediaLabel(LibraryEfficiencyTitleDto item) => item.IsAnime ? "Anime"
        : item.MediaType == MediaType.Movie ? "Movie" : "TV series";

    private string ReportSourceText => _report.UsesPlexInventory
        ? "Exact physical files reported by Plex across every video library."
        : "Measured Plex Requests import data.";

    private static string OptimizationAvailability(LibraryEfficiencyTitleDto item) => item.CanOptimize
        ? $"Build a safe replacement plan for {item.OptimizableFileCount} managed file{(item.OptimizableFileCount == 1 ? string.Empty : "s")}."
        : item.CanAdopt
            ? "Connect this verified Plex title to the optimizer. This does not queue a download."
            : item.AdoptionBlockReason ?? "This Plex title is report-only.";

    private string ReportActionLabel(LibraryEfficiencyTitleDto item) => item.HasActiveJob
        ? "Work in progress"
        : _adopting.Contains(item.InventoryKey)
            ? "Connecting…"
            : item.CanOptimize
                ? "Build a plan"
                : item.CanAdopt ? "Connect title" : "Report only";

    private static string Percent(long part, long total) => total <= 0 ? "0%"
        : $"{part * 100d / total:0.#}%";

    private static string WidthPercent(long part, long total) => total <= 0 ? "0%"
        : $"{part * 100d / total:0.###}%";

    private static string ActivityScope(StorageOptimizationActivityDto item)
    {
        var files = $"{item.TargetFileCount} file{(item.TargetFileCount == 1 ? string.Empty : "s")}";
        if (item.Seasons.Count == 0) return files;
        return $"{files} · {string.Join(", ", item.Seasons.Select(SeasonLabel))}";
    }

    private static string SavingsResult(StorageOptimizationActivityDto item)
    {
        if (item.BytesSaved is not long saved) return item.Status == FulfillmentStatus.Completed ? "Not recorded" : "Pending";
        return saved >= 0 ? $"{FormatBytes(saved)} saved" : $"{FormatBytes(-saved)} larger";
    }

    private static bool IsActive(FulfillmentStatus status) => status is FulfillmentStatus.Queued
        or FulfillmentStatus.Claimed or FulfillmentStatus.Downloading or FulfillmentStatus.Deferred;

    private static Color ActivityColor(FulfillmentStatus status) => status switch
    {
        FulfillmentStatus.Completed => Color.Success,
        FulfillmentStatus.Failed => Color.Error,
        FulfillmentStatus.Deferred => Color.Warning,
        FulfillmentStatus.Cancelled => Color.Default,
        _ => Color.Info
    };

    private static string ActivityFootnote(StorageOptimizationActivityDto item) => item.Status switch
    {
        FulfillmentStatus.Completed => "Every selected goal was verified before replacement.",
        FulfillmentStatus.Cancelled => "Original media remains available.",
        FulfillmentStatus.Failed => "Review the error, then retry when ready.",
        _ => "Original media remains available while this runs."
    };

    private static string ScanStatus(LibraryEfficiencyTitleDto item)
    {
        var parts = new List<string>();
        var waiting = Math.Max(0, item.MetadataScanQueuedCount - item.MetadataScanRetryingCount);
        if (waiting > 0) parts.Add($"{waiting} queued");
        if (item.MetadataScanRetryingCount > 0)
            parts.Add($"{item.MetadataScanRetryingCount} retrying"
                      + (item.MetadataScanNextAttemptAt is DateTime retry ? $" {RelativeFuture(retry)}" : string.Empty));
        if (item.MetadataScanInProgressCount > 0) parts.Add($"{item.MetadataScanInProgressCount} inspecting");
        return string.Join(" · ", parts);
    }

    private string ScanScopeStatus
    {
        get
        {
            var parts = new List<string>();
            var waiting = Math.Max(0, ScopedMetadataScanQueuedCount - ScopedMetadataScanRetryingCount);
            if (waiting > 0) parts.Add($"{waiting} queued");
            if (ScopedMetadataScanRetryingCount > 0)
                parts.Add($"{ScopedMetadataScanRetryingCount} waiting for an automatic retry");
            if (ScopedMetadataScanInProgressCount > 0)
                parts.Add($"{ScopedMetadataScanInProgressCount} being inspected");
            return string.Join(" · ", parts);
        }
    }

    private static string RelativeTime(DateTime value)
    {
        var elapsed = DateTime.UtcNow - value.ToUniversalTime();
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private static string RelativeFuture(DateTime value)
    {
        var remaining = value.ToUniversalTime() - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) return "now";
        if (remaining.TotalMinutes < 1) return "in less than a minute";
        if (remaining.TotalHours < 1) return $"in {(int)Math.Ceiling(remaining.TotalMinutes)}m";
        if (remaining.TotalDays < 1) return $"in {(int)Math.Ceiling(remaining.TotalHours)}h";
        return $"in {(int)Math.Ceiling(remaining.TotalDays)}d";
    }

    public void Dispose()
    {
        _activityCts?.Cancel();
        _activityTimer?.Dispose();
        _activityCts?.Dispose();
    }
}
