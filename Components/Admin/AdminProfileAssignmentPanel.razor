@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Implementations.IQualityProfileService Profiles
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toasts

@* Condition-based assignment of a quality profile to a title. First enabled rule whose conditions all match
   wins; otherwise the requester's own pick or the default profile applies. A rule with no conditions matches
   everything, so enabling one is rejected — that exact shape (enabled, no conditions, 720p) is what silently
   capped every download in this deployment. Child component — /admin is already admin-gated. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <MudText Typo="Typo.body2" Class="text-muted">
            Use rules only when certain media should automatically receive a different quality profile.
            Rules run from top to bottom, and the first matching rule wins.
        </MudText>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule">New rule</MudButton>
    </div>

    @if (_rules.Count == 0)
    {
        <div class="text-center py-6 text-muted">
            No assignment rules. Every request uses the requester's chosen profile, or the default profile.
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
            All filled-in conditions on a rule must match. Leave a field blank for “any.” A rule needs at least one condition before it can be enabled.
        </MudAlert>

        <MudExpansionPanels Class="assignment-rule-list" MultiExpansion="false" Elevation="0">
            @for (var index = 0; index < _rules.Count; index++)
            {
                var rule = _rules[index];
                var ruleIndex = index;
                <MudExpansionPanel @key="rule.Id"
                                   Expanded="@(_expandedRuleId == rule.Id)"
                                   ExpandedChanged="@(expanded => SetExpanded(rule.Id, expanded))">
                    <TitleContent>
                        <div class="assignment-rule-summary">
                            <span class="assignment-rule-order">@(ruleIndex + 1)</span>
                            <span class="assignment-rule-copy">
                                <b>@rule.Name</b>
                                <small>@RuleSummary(rule)</small>
                            </span>
                            @if (rule.IsUnconditional)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Needs a condition</MudChip>
                            }
                            else if (rule.Enabled)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Enabled</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Disabled</MudChip>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="assignment-rule-editor">
                            <div class="assignment-rule-actions">
                                <div class="d-flex align-items-center gap-1">
                                    <MudText Typo="Typo.caption" Class="text-muted">Priority</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                   Disabled="@(ruleIndex == 0)" aria-label="Move rule earlier"
                                                   OnClick="() => Move(rule, true)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                   Disabled="@(ruleIndex == _rules.Count - 1)" aria-label="Move rule later"
                                                   OnClick="() => Move(rule, false)" />
                                </div>
                                @if (rule.IsUnconditional)
                                {
                                    <MudTooltip Text="Add a condition first so this rule cannot silently apply to every title.">
                                        <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Primary" Label="Enabled" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudSwitch T="bool" Value="rule.Enabled" Color="Color.Primary" Label="Enabled"
                                               ValueChanged="@(v => { rule.Enabled = v; return Save(rule); })" />
                                }
                            </div>

                            <div class="assignment-rule-core">
                                <MudTextField T="string" Label="Rule name" Value="rule.Name" Variant="Variant.Outlined"
                                              ValueChanged="@(v => { rule.Name = v; return Save(rule); })" />
                                <MudSelect T="int" Label="Apply quality profile" Value="rule.QualityProfileId" Variant="Variant.Outlined"
                                           ValueChanged="@(v => { rule.QualityProfileId = v; return Save(rule); })">
                                    @foreach (var p in _profiles)
                                    {
                                        <MudSelectItem Value="p.Id">@p.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Match when all selected conditions are true</MudText>
                            <div class="assignment-rule-conditions">
                                <MudSelect T="MediaType?" Label="Media type" Value="rule.MatchMediaType" Clearable="true" Variant="Variant.Outlined"
                                           ValueChanged="@(v => { rule.MatchMediaType = v; return Save(rule); })">
                                    <MudSelectItem T="MediaType?" Value="@((MediaType?)MediaType.Movie)">Movie</MudSelectItem>
                                    <MudSelectItem T="MediaType?" Value="@((MediaType?)MediaType.TvShow)">TV show</MudSelectItem>
                                    <MudSelectItem T="MediaType?" Value="@((MediaType?)MediaType.Anime)">Anime TV (legacy)</MudSelectItem>
                                </MudSelect>
                                <MudSelect T="bool?" Label="Anime" Value="rule.MatchAnime" Clearable="true" Variant="Variant.Outlined"
                                           ValueChanged="@(v => { rule.MatchAnime = v; return Save(rule); })">
                                    <MudSelectItem T="bool?" Value="@((bool?)true)">Anime only</MudSelectItem>
                                    <MudSelectItem T="bool?" Value="@((bool?)false)">Exclude anime</MudSelectItem>
                                </MudSelect>
                                <MudTextField T="string" Label="Genre contains" Value="rule.MatchGenre" Variant="Variant.Outlined"
                                              Placeholder="e.g. Animation"
                                              ValueChanged="@(v => { rule.MatchGenre = v; return Save(rule); })" />
                                <MudNumericField T="int?" Label="Specific TMDb title ID" Value="rule.MatchTmdbId" Clearable="true" Variant="Variant.Outlined"
                                                 ValueChanged="@(v => { rule.MatchTmdbId = v; return Save(rule); })" />
                            </div>

                            <div class="d-flex justify-content-end mt-4">
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Delete(rule)">Delete rule</MudButton>
                            </div>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
}

@code {
    private bool _loading = true;
    private List<ProfileAssignmentRuleDto> _rules = new();
    private List<QualityProfileDto> _profiles = new();
    private int? _expandedRuleId;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _rules = await Profiles.GetAssignmentRulesAsync();
        var profiles = await Profiles.GetProfilesAsync();
        var assigned = _rules.Select(r => r.QualityProfileId).ToHashSet();
        _profiles = profiles.Where(p => p.IsDefault || p.IsUserSelectable || assigned.Contains(p.Id)
                                        || p.Name is not ("HD-1080p" or "Ultra-HD"))
            .ToList();
        _loading = false;
    }

    private async Task Save(ProfileAssignmentRuleDto rule)
    {
        var (ok, error) = await Profiles.UpdateAssignmentRuleAsync(rule);
        if (!ok) await Toasts.ShowErrorAsync(error ?? "Save failed.");
        await Load();
    }

    private async Task AddRule()
    {
        await Profiles.CreateAssignmentRuleAsync();
        await Toasts.ShowInfoAsync("Rule created disabled — add a condition, then enable it.");
        await Load();
        _expandedRuleId = _rules.LastOrDefault()?.Id;
    }

    private async Task Move(ProfileAssignmentRuleDto rule, bool up)
    {
        await Profiles.MoveAssignmentRuleAsync(rule.Id, up);
        await Load();
    }

    private async Task Delete(ProfileAssignmentRuleDto rule)
    {
        if (await Profiles.DeleteAssignmentRuleAsync(rule.Id)) await Toasts.ShowSuccessAsync($"Deleted '{rule.Name}'.");
        if (_expandedRuleId == rule.Id) _expandedRuleId = null;
        await Load();
    }

    private void SetExpanded(int ruleId, bool expanded) => _expandedRuleId = expanded ? ruleId : null;

    private string RuleSummary(ProfileAssignmentRuleDto rule)
    {
        var conditions = new List<string>();
        if (rule.MatchMediaType.HasValue) conditions.Add(rule.MatchMediaType.Value switch
        {
            MediaType.Movie => "movies",
            MediaType.TvShow => "TV shows",
            MediaType.Anime => "legacy anime TV",
            _ => rule.MatchMediaType.Value.ToString()
        });
        if (rule.MatchAnime.HasValue) conditions.Add(rule.MatchAnime.Value ? "anime" : "non-anime");
        if (!string.IsNullOrWhiteSpace(rule.MatchGenre)) conditions.Add($"genre contains “{rule.MatchGenre.Trim()}”");
        if (rule.MatchTmdbId.HasValue) conditions.Add($"TMDb title {rule.MatchTmdbId.Value}");

        var match = conditions.Count == 0 ? "No conditions yet" : string.Join(" + ", conditions);
        return $"{match} → {ProfileName(rule.QualityProfileId)}";
    }

    private string ProfileName(int profileId) => _profiles.FirstOrDefault(p => p.Id == profileId)?.Name ?? "Missing profile";
}
