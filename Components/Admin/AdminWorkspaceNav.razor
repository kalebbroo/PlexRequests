<nav class="workspace-nav" aria-label="@AriaLabel">
    @foreach (var item in Sections)
    {
        <button type="button"
                class="@ButtonClass(item)"
                aria-current="@(item.Key == ActiveKey ? "page" : null)"
                @onclick="() => Selected.InvokeAsync(item)">
            <MudIcon Icon="@item.Icon" Size="Size.Small" />
            <span class="workspace-nav-copy">
                <span class="workspace-nav-label">@item.Label</span>
                <span class="workspace-nav-description">@item.Description</span>
            </span>
        </button>
    }
</nav>

@code {
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "Workspace section";

    [Parameter, EditorRequired]
    public IReadOnlyList<AdminWorkspaceSection> Sections { get; set; } = [];

    [Parameter, EditorRequired]
    public string ActiveKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<AdminWorkspaceSection> Selected { get; set; }

    private string ButtonClass(AdminWorkspaceSection item) =>
        item.Key == ActiveKey ? "workspace-nav-item active" : "workspace-nav-item";
}
