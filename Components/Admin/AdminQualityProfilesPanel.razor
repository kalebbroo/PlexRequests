@using PlexRequestsHosted.Shared
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Implementations.IQualityProfileService Profiles
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toasts
@inject PlexRequestsHosted.Services.Implementations.ICustomFormatService Formats

@* Admin "Quality profiles" panel. Replaces the old Quality Rules panel, which could only express a single
   target quality per title. A profile is an ordered list of quality tiers with an allowed flag plus a
   cutoff: everything allowed is grabbable, and anything below the cutoff keeps getting upgraded until
   something at or above it appears. Child component — /admin is already admin-gated. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <MudText Typo="Typo.body2" Class="text-muted">
            Most libraries only need the Everyday default. Add a special profile for a strict 4K, language,
            anime, or compatibility exception and let users choose it when requesting.
        </MudText>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddProfile">New profile</MudButton>
    </div>

    @foreach (var p in VisibleProfiles)
    {
        <MudExpansionPanel Class="mb-2">
            <TitleContent>
                <div class="d-flex align-items-center gap-2">
                    <MudText Typo="Typo.subtitle1"><b>@p.Name</b></MudText>
                    @if (p.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Default</MudChip>
                    }
                    @if (!p.IsUserSelectable)
                    {
                        <MudTooltip Text="Users can't pick this profile themselves; only assignment rules apply it.">
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Admin only</MudChip>
                        </MudTooltip>
                    }
                    <MudText Typo="Typo.caption" Class="text-muted">
                        cutoff @CutoffName(p) · @p.Items.Count(i => i.Allowed) of @p.Items.Count tiers allowed
                    </MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.body2" Class="text-muted mb-3">
                    <b>@p.Name</b> accepts @p.Items.Count(i => i.Allowed) quality tiers and stops upgrading at
                    <b>@CutoffName(p)</b>. Changes on this page save automatically.
                </MudText>
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <MudTextField T="string" Label="Name" Value="p.Name" Variant="Variant.Outlined"
                                  Style="min-width:220px;" ValueChanged="@(v => Rename(p, v))" />
                    <MudSelect T="int" Label="Cutoff (stop upgrading at)" Value="p.CutoffQualityDefinitionId"
                               Variant="Variant.Outlined" Style="min-width:240px;"
                               ValueChanged="@(v => SetCutoff(p, v))">
                        @* Only allowed tiers can be a cutoff — an unreachable cutoff means the upgrade scan
                           hunts forever for something the profile would never accept. A persisted cutoff can
                           also be one member of a grouped tier; retain its human label instead of letting the
                           select render the raw definition id. *@
                        @if (!p.Items.Where(i => i.Allowed).Any(i => CutoffIdOf(i) == p.CutoffQualityDefinitionId))
                        {
                            <MudSelectItem Value="@p.CutoffQualityDefinitionId">@CutoffName(p)</MudSelectItem>
                        }
                        @foreach (var item in p.Items.Where(i => i.Allowed).Reverse())
                        {
                            <MudSelectItem Value="@CutoffIdOf(item)">@item.N</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" Label="Allow upgrades" Value="p.UpgradeAllowed" Color="Color.Primary"
                               ValueChanged="@(v => SetUpgrade(p, v))" />
                    <MudSwitch T="bool" Label="Users can select" Value="p.IsUserSelectable" Color="Color.Primary"
                               ValueChanged="@(v => SetSelectable(p, v))" />
                </div>

                <MudPaper Class="pa-3 mb-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2">Language behavior</MudText>
                    <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">
                        Preferences rank the best release but retain fallbacks. Strict custom rules verify actual tracks before import.
                    </MudText>
                    <MudSelect T="string" Label="Language behavior" Value="@LanguagePreset(p)"
                               ValueChanged="@(v => ApplyLanguagePreset(p, v))" Variant="Variant.Outlined"
                               Style="max-width:360px;">
                        <MudSelectItem T="string" Value='@("smart")'>Smart English + anime fallback</MudSelectItem>
                        <MudSelectItem T="string" Value='@("english-preferred")'>Prefer English, allow original</MudSelectItem>
                        <MudSelectItem T="string" Value='@("english-only")'>Require English audio</MudSelectItem>
                        <MudSelectItem T="string" Value='@("original-subs")'>Original audio + English subtitles</MudSelectItem>
                        <MudSelectItem T="string" Value='@("dual-preferred")'>Prefer dual audio</MudSelectItem>
                        <MudSelectItem T="string" Value='@("any")'>No language preference</MudSelectItem>
                        @if (LanguagePreset(p) == "custom")
                        {
                            <MudSelectItem T="string" Value='@("custom")' Disabled="true">Custom language rules</MudSelectItem>
                        }
                    </MudSelect>

                    @if (LanguagePreset(p) is not ("any" or "custom"))
                    {
                        <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
                            <MudTextField T="string" Label="Preferred audio language" Value="p.PreferredAudioLanguage"
                                          Placeholder="en" Variant="Variant.Outlined" Style="max-width:220px;"
                                          ValueChanged="@(v => SetPreferredLanguage(p, true, v))" />
                            <MudTextField T="string" Label="Preferred subtitle language" Value="p.PreferredSubtitleLanguage"
                                          Placeholder="en" Variant="Variant.Outlined" Style="max-width:230px;"
                                          ValueChanged="@(v => SetPreferredLanguage(p, false, v))" />
                            <MudSwitch T="bool" Label="Prefer forced subtitles" Value="p.PreferForcedSubtitles"
                                       Color="Color.Primary" ValueChanged="@(v => SetPreferredForcedSubtitle(p, v))" />
                        </div>
                    }

                    <div class="mt-3">
                        <MudSwitch T="bool" Label="Set preferred playback tracks automatically"
                                   Value="p.SetPreferredTracksAsDefault" Color="Color.Primary"
                                   ValueChanged="@(v => SetPlaybackDefaults(p, v))" />
                        <MudText Typo="Typo.caption" Class="text-muted d-block">
                            Smart mode puts English audio first for ordinary media (and forced English subtitles when present).
                            Anime puts Japanese audio and full embedded English subtitles first on MKV files. Default flags are also set,
                            and the original download remains unchanged.
                        </MudText>
                    </div>

                    <details class="profile-option" open="@(LanguagePreset(p) == "custom")">
                        <summary>
                            <span><b>Custom language rules</b><small>Use only when the presets above do not describe this profile.</small></span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@LanguagePolicySummary(p)</MudChip>
                        </summary>
                        <div class="profile-option-content d-flex flex-wrap gap-3 align-items-center">
                        <MudTextField T="string" Label="Required audio" Value="p.RequiredAudioLanguagesCsv"
                                      Placeholder="en,ja" Variant="Variant.Outlined" Style="min-width:190px;"
                                      ValueChanged="@(v => SetLanguageValue(p, "required-audio", v))" />
                        <MudTextField T="string" Label="Allowed audio (optional)" Value="p.AllowedLanguagesCsv"
                                      Placeholder="en,ja" Variant="Variant.Outlined" Style="min-width:210px;"
                                      ValueChanged="@(v => SetLanguageValue(p, "allowed-audio", v))" />
                        <MudTextField T="string" Label="Required subtitles" Value="p.RequiredSubtitleLanguagesCsv"
                                      Placeholder="en" Variant="Variant.Outlined" Style="min-width:190px;"
                                      ValueChanged="@(v => SetLanguageValue(p, "required-subs", v))" />
                        <MudSwitch T="bool" Label="Require forced subtitle" Value="p.RequireForcedSubtitle"
                                   Color="Color.Primary" ValueChanged="@(v => SetForcedSubtitle(p, v))" />
                        <MudSwitch T="bool" Label="Allow untagged tracks" Value="p.AllowUnknownTrackLanguage"
                                   Color="Color.Primary" ValueChanged="@(v => SetUnknownLanguage(p, v))" />
                        <MudText Typo="Typo.caption" Class="text-muted w-100">
                            Use ISO language codes such as <code>en</code> and <code>ja</code>. Strict policies are verified with MediaInfo, not only filename tags.
                        </MudText>
                        </div>
                    </details>
                </MudPaper>

                <details class="profile-option">
                    <summary>
                        <span><b>Quality tiers</b><small>Choose every quality this profile may download.</small></span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@p.Items.Count(i => i.Allowed) allowed · cutoff @CutoffName(p)</MudChip>
                    </summary>
                    <div class="profile-option-content">
                    <MudTable Items="@p.Items.AsEnumerable().Reverse()" dense="true" Hover="true" Class="elevation-1">
                    <HeaderContent>
                        <MudTh>Quality tier</MudTh>
                        <MudTh Style="width:120px;">Allowed</MudTh>
                        <MudTh Style="width:120px;">Cutoff</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Quality tier">@context.N</MudTd>
                        <MudTd DataLabel="Allowed">
                            <MudSwitch T="bool" Value="context.Allowed" Color="Color.Primary"
                                       ValueChanged="@(v => SetAllowed(p, context, v))" />
                        </MudTd>
                        <MudTd DataLabel="Cutoff">
                            @if (CutoffIdOf(context) == p.CutoffQualityDefinitionId)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">Cutoff</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                    </MudTable>
                    </div>
                </details>

                <details class="profile-option">
                    <summary>
                        <span><b>Profile-specific limits</b><small>Override global size and seeder limits only for this profile.</small></span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@LimitSummary(p)</MudChip>
                    </summary>
                    <div class="profile-option-content d-flex flex-wrap gap-3 align-items-center">
                        <MudNumericField T="double?" Label="Max size (GB)" Value="p.MaxSizeGb" Clearable="true"
                                         Variant="Variant.Outlined" Style="max-width:170px;"
                                         ValueChanged="@(v => SetSize(p, v, season: false))" />
                        <MudNumericField T="double?" Label="Max season pack (GB)" Value="p.MaxSeasonPackSizeGb" Clearable="true"
                                         Variant="Variant.Outlined" Style="max-width:210px;"
                                         ValueChanged="@(v => SetSize(p, v, season: true))" />
                        <MudNumericField T="int?" Label="Minimum seeders" Value="p.MinSeeders" Clearable="true"
                                         Variant="Variant.Outlined" Style="max-width:170px;"
                                         ValueChanged="@(v => SetSeeders(p, v))" />
                        <MudText Typo="Typo.caption" Class="text-muted w-100">Leave blank to use the Everyday defaults.</MudText>
                    </div>
                </details>

                @* Scores live here rather than on the format, so the same rule can be worth having in one
                   profile and disqualifying in another. *@
                @if (_formatsByProfile.TryGetValue(p.Id, out var formats) && formats.Count > 0)
                {
                    <details class="profile-option">
                        <summary>
                            <span><b>Advanced matching scores</b><small>Score reusable custom formats differently for this profile.</small></span>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">minimum @p.MinCustomFormatScore</MudChip>
                        </summary>
                        <div class="profile-option-content">
                        <div class="d-flex flex-wrap gap-2">
                        @foreach (var f in formats.Where(f => f.Enabled))
                        {
                            <MudNumericField T="int" Label="@f.Name" Value="f.Score" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Style="max-width:180px;"
                                             ValueChanged="@(v => SetScore(p, f, v))" />
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        <MudNumericField T="int" Label="Minimum score" Value="p.MinCustomFormatScore"
                                         Variant="Variant.Outlined" Style="max-width:170px;"
                                         ValueChanged="@(v => { p.MinCustomFormatScore = v; return Save(p, "minimum score"); })" />
                        <MudText Typo="Typo.caption" Class="text-muted align-self-center">
                            Releases scoring below this are rejected outright.
                        </MudText>
                    </div>
                        </div>
                    </details>
                }

                <div class="d-flex justify-content-end gap-2 mt-3">
                    @if (!p.IsDefault)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => MakeDefault(p)">Make default</MudButton>
                        <MudTooltip Text="@(p.InUse ? "In use by requests or assignment rules." : "Delete this profile.")">
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                       Disabled="p.InUse" OnClick="() => Delete(p)">Delete</MudButton>
                        </MudTooltip>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
    @if (_profiles.Count - VisibleProfiles.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="text-muted d-block mt-2">
            @(_profiles.Count - VisibleProfiles.Count) retired built-in profile(s) are hidden. Historical requests keep their original assignment.
        </MudText>
    }
}

@code {
    private bool _loading = true;
    private List<QualityProfileDto> _profiles = new();
    private List<QualityDefinitionDto> _definitions = new();
    private Dictionary<int, List<CustomFormatDto>> _formatsByProfile = new();
    private List<QualityProfileDto> VisibleProfiles => _profiles
        .Where(p => p.IsDefault || p.IsUserSelectable || p.Name is not ("HD-1080p" or "Ultra-HD"))
        .ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _definitions = await Profiles.GetDefinitionsAsync();
        _profiles = await Profiles.GetProfilesAsync();
        _formatsByProfile = new();
        foreach (var p in _profiles) _formatsByProfile[p.Id] = await Formats.GetForProfileAsync(p.Id);
        _loading = false;
    }

    // A group's cutoff id is its best member; a single tier's is its own definition id.
    private int CutoffIdOf(QualityProfileItemDto item) =>
        item.Members is { Length: > 0 } m
            ? m.OrderByDescending(id => _definitions.FirstOrDefault(d => d.Id == id)?.SortWeight ?? 0).First()
            : (int.TryParse(item.K.AsSpan(2), out var id) ? id : 0);

    private string CutoffName(QualityProfileDto p) =>
        _definitions.FirstOrDefault(d => d.Id == p.CutoffQualityDefinitionId)?.Name ?? "—";

    private async Task Save(QualityProfileDto p, string what)
    {
        if (await Profiles.UpdateProfileAsync(p)) await Toasts.ShowSuccessAsync($"{p.Name}: {what} saved.");
        else await Toasts.ShowErrorAsync("Save failed.");
        await Load();
    }

    private async Task Rename(QualityProfileDto p, string name) { p.Name = name; await Save(p, "name"); }
    private async Task SetCutoff(QualityProfileDto p, int defId) { p.CutoffQualityDefinitionId = defId; await Save(p, "cutoff"); }
    private async Task SetUpgrade(QualityProfileDto p, bool v) { p.UpgradeAllowed = v; await Save(p, "upgrade setting"); }
    private async Task SetSelectable(QualityProfileDto p, bool v) { p.IsUserSelectable = v; await Save(p, "visibility"); }
    private async Task SetSeeders(QualityProfileDto p, int? v) { p.MinSeeders = v; await Save(p, "min seeders"); }

    private async Task SetSize(QualityProfileDto p, double? v, bool season)
    {
        if (season) p.MaxSeasonPackSizeGb = v; else p.MaxSizeGb = v;
        await Save(p, "size limit");
    }

    private async Task SetAllowed(QualityProfileDto p, QualityProfileItemDto item, bool allowed)
    {
        item.Allowed = allowed;
        // Disallowing the cutoff tier would leave the profile chasing something it won't accept, so move the
        // cutoff down to the best tier that's still allowed.
        if (!allowed && CutoffIdOf(item) == p.CutoffQualityDefinitionId)
        {
            var fallback = p.Items.Where(i => i.Allowed).Select(CutoffIdOf).LastOrDefault();
            if (fallback > 0) p.CutoffQualityDefinitionId = fallback;
        }
        await Save(p, item.N);
    }

    private async Task SetScore(QualityProfileDto profile, CustomFormatDto format, int score)
    {
        await Formats.SetScoreAsync(profile.Id, format.Id, score);
        await Load();
    }

    private async Task ApplyLanguagePreset(QualityProfileDto profile, string preset)
    {
        profile.LanguagePreference = preset switch
        {
            "english-preferred" => ReleaseLanguagePreference.EnglishPreferred,
            "english-only" => ReleaseLanguagePreference.EnglishOnly,
            "original-subs" => ReleaseLanguagePreference.OriginalWithEnglishSubtitles,
            "dual-preferred" => ReleaseLanguagePreference.DualAudioPreferred,
            "any" => ReleaseLanguagePreference.Any,
            "custom" => ReleaseLanguagePreference.Custom,
            _ => ReleaseLanguagePreference.Smart
        };
        profile.PreferredAudioLanguage = "en";
        profile.PreferredSubtitleLanguage = "en";
        if (preset != "custom")
        {
            profile.RequiredAudioLanguagesCsv = null;
            profile.AllowedLanguagesCsv = null;
            profile.RequiredSubtitleLanguagesCsv = null;
            profile.RequireForcedSubtitle = false;
            profile.AllowUnknownTrackLanguage = true;
        }
        await Save(profile, "media language preset");
    }

    private static string LanguagePreset(QualityProfileDto profile)
    {
        if (!string.IsNullOrWhiteSpace(profile.RequiredAudioLanguagesCsv)
            || !string.IsNullOrWhiteSpace(profile.AllowedLanguagesCsv)
            || !string.IsNullOrWhiteSpace(profile.RequiredSubtitleLanguagesCsv)
            || profile.RequireForcedSubtitle || profile.LanguagePreference == ReleaseLanguagePreference.Custom)
            return "custom";
        return profile.LanguagePreference switch
        {
            ReleaseLanguagePreference.EnglishPreferred => "english-preferred",
            ReleaseLanguagePreference.EnglishOnly => "english-only",
            ReleaseLanguagePreference.OriginalWithEnglishSubtitles => "original-subs",
            ReleaseLanguagePreference.DualAudioPreferred => "dual-preferred",
            ReleaseLanguagePreference.Any => "any",
            _ => "smart"
        };
    }

    private static string LanguagePolicySummary(QualityProfileDto profile) => LanguagePreset(profile) switch
    {
        "smart" => "Smart fallback",
        "english-preferred" => "English preferred",
        "english-only" => "English required",
        "original-subs" => "Original + English subs",
        "dual-preferred" => "Dual preferred",
        "any" => "No preference",
        _ => "Custom"
    };

    private static string LimitSummary(QualityProfileDto profile)
    {
        var overrides = new List<string>();
        if (profile.MaxSizeGb.HasValue) overrides.Add($"{profile.MaxSizeGb:g} GB files");
        if (profile.MaxSeasonPackSizeGb.HasValue) overrides.Add($"{profile.MaxSeasonPackSizeGb:g} GB packs");
        if (profile.MinSeeders.HasValue) overrides.Add($"{profile.MinSeeders} seeders");
        return overrides.Count == 0 ? "Use global limits" : string.Join(" · ", overrides);
    }

    private async Task SetLanguageValue(QualityProfileDto profile, string field, string? value)
    {
        profile.LanguagePreference = ReleaseLanguagePreference.Custom;
        if (field == "required-audio") profile.RequiredAudioLanguagesCsv = value;
        else if (field == "allowed-audio") profile.AllowedLanguagesCsv = value;
        else profile.RequiredSubtitleLanguagesCsv = value;
        await Save(profile, "media language policy");
    }

    private async Task SetForcedSubtitle(QualityProfileDto profile, bool value)
    {
        profile.LanguagePreference = ReleaseLanguagePreference.Custom;
        profile.RequireForcedSubtitle = value;
        await Save(profile, "forced subtitle policy");
    }

    private async Task SetUnknownLanguage(QualityProfileDto profile, bool value)
    {
        profile.LanguagePreference = ReleaseLanguagePreference.Custom;
        profile.AllowUnknownTrackLanguage = value;
        await Save(profile, "untagged track policy");
    }

    private async Task SetPreferredForcedSubtitle(QualityProfileDto profile, bool value)
    {
        profile.PreferForcedSubtitles = value;
        await Save(profile, "forced subtitle preference");
    }

    private async Task SetPlaybackDefaults(QualityProfileDto profile, bool value)
    {
        profile.SetPreferredTracksAsDefault = value;
        await Save(profile, "playback defaults");
    }

    private async Task SetPreferredLanguage(QualityProfileDto profile, bool audio, string? value)
    {
        if (audio) profile.PreferredAudioLanguage = value;
        else profile.PreferredSubtitleLanguage = value;
        await Save(profile, audio ? "preferred audio language" : "preferred subtitle language");
    }

    private async Task MakeDefault(QualityProfileDto p)
    {
        if (await Profiles.SetDefaultProfileAsync(p.Id)) await Toasts.ShowSuccessAsync($"{p.Name} is now the default.");
        await Load();
    }

    private async Task AddProfile()
    {
        await Profiles.CreateProfileAsync("New profile");
        await Toasts.ShowInfoAsync("Profile created from the default's tiers — adjust it below.");
        await Load();
    }

    private async Task Delete(QualityProfileDto p)
    {
        var (ok, error) = await Profiles.DeleteProfileAsync(p.Id);
        if (ok) await Toasts.ShowSuccessAsync($"Deleted {p.Name}.");
        else await Toasts.ShowErrorAsync(error ?? "Could not delete this profile.");
        await Load();
    }
}
