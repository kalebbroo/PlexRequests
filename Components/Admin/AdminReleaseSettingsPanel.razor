@inject NavigationManager Navigation

<MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">
    Everyday defaults are enough for most libraries. Special profiles and filename rules are optional overrides.
</MudAlert>

<AdminWorkspaceNav AriaLabel="Release settings view"
                   Sections="Sections"
                   ActiveKey="@ActiveSection"
                   Selected="NavigateTo" />

<div @key="ActiveSection">
    @switch (ActiveSection)
    {
        case "quality":
            <AdminQualityProfilesPanel />
            break;
        case "assignment":
            <AdminProfileAssignmentPanel />
            break;
        case "formats":
            <AdminCustomFormatsPanel />
            break;
        default:
            <AdminDownloadsPanel />
            break;
    }
</div>

@code {
    private static readonly AdminWorkspaceSection[] Sections =
    [
        new("basics", "Everyday defaults", "Quality, language, encoding, season packs, and safe fallbacks.", Icons.Material.Filled.AutoAwesome, "/admin?tab=downloads&sub=preferences"),
        new("quality", "Special profiles", "Optional strict policies for 4K, language, anime, or device exceptions.", Icons.Material.Filled.Tune, "/admin?tab=downloads&sub=quality"),
        new("assignment", "Automatic overrides", "Apply a special profile by media type, genre, or title.", Icons.Material.Filled.CallSplit, "/admin?tab=downloads&sub=assignment"),
        new("formats", "Filename rules", "Advanced scoring or rejection rules for release names.", Icons.Material.Filled.DataObject, "/admin?tab=downloads&sub=formats")
    ];

    [Parameter]
    public string? Section { get; set; }

    private string ActiveSection => Section is "quality" or "assignment" or "formats" ? Section : "basics";

    private void NavigateTo(AdminWorkspaceSection section) => Navigation.NavigateTo(section.Url);
}
