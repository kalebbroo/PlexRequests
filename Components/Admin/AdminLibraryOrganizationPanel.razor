@using System.Text.RegularExpressions
@using PlexRequestsHosted.Shared
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Implementations.ILibraryOrganizationPreferencesService Prefs
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast
@inject MudBlazor.IDialogService DialogService

<div class="d-flex justify-content-end align-items-center mb-2">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="_loading">Save</MudButton>
</div>
<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4">
    Controls how the downloader renames and places finished downloads into the Plex library: where they go,
    what they're named, and how the transfer happens. Applies to new imports going forward only.
</MudText>

@if (_loading || _p is null)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <MudText Typo="Typo.h6">Library destinations</MudText>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDestination">Add destination</MudButton>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-3">
            Add as many Plex libraries as needed. Each destination is restricted to one scanner shape, so a
            movie can never be imported into a TV root. Paths are seen by the downloader; requesters only see
            destinations you explicitly make selectable and never submit filesystem paths.
        </MudText>
        <div class="d-flex gap-3 flex-wrap align-items-center mb-4">
            <MudSelect T="string" @bind-Value="DefaultMovieId" Label="Default movies" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                @foreach (var destination in EnabledDestinations(LibraryContentKind.Movie))
                {
                    <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="DefaultSeriesId" Label="Default TV" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                @foreach (var destination in EnabledDestinations(LibraryContentKind.Series))
                {
                    <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="DefaultMusicId" Label="Default music" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                @foreach (var destination in EnabledDestinations(LibraryContentKind.Music))
                {
                    <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        @for (var i = 0; i < _p.LibraryDestinations.Count; i++)
        {
            var idx = i;
            var destination = _p.LibraryDestinations[idx];
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <MudTextField @bind-Value="destination.Name" Label="Name" dense="true" Variant="Variant.Outlined" Style="min-width:190px;" />
                    <MudSelect T="LibraryContentKind" @bind-Value="destination.ContentKind" Label="Content type" dense="true"
                               Variant="Variant.Outlined" Disabled="destination.IsDefault" Style="min-width:150px;">
                        <MudSelectItem Value="LibraryContentKind.Movie">Movies</MudSelectItem>
                        <MudSelectItem Value="LibraryContentKind.Series">TV / series</MudSelectItem>
                        <MudSelectItem Value="LibraryContentKind.Music">Music</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="destination.RootPath" Label="Root path" dense="true" Variant="Variant.Outlined" Style="min-width:310px;"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="@(() => BrowseDestination(idx))" />
                    <MudTextField @bind-Value="destination.PlexSectionId" Label="Plex section ID (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:190px;" />
                    <MudTextField @bind-Value="destination.TemplateOverride" Label="Naming override (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:260px;" />
                    <MudSwitch T="bool" @bind-Value="destination.Enabled" Color="Color.Primary" Label="Enabled" Disabled="destination.IsDefault" />
                    <MudSwitch T="bool" @bind-Value="destination.AllowUserSelection" Color="Color.Primary" Label="Users may select" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="destination.IsDefault"
                                   OnClick="@(() => RemoveDestination(idx))" />
                </div>
                @if (destination.IsDefault)
                {
                    <MudText Typo="Typo.caption" Color="Color.Primary">Default @ContentKindLabel(destination.ContentKind) destination</MudText>
                }
            </MudPaper>
        }
        <MudText Typo="Typo.caption" Color="Color.Tertiary">
            For a NAS/network drive, configure it under <b>Admin → Library → Network Drives</b> and select a path
            beneath <code>/mnt/nas/&lt;name&gt;</code>. Plex section IDs are carried with jobs for targeted scan and
            verification support; leaving them empty keeps the current media-type refresh behavior.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Naming templates</MudText>
        <div class="d-flex flex-column gap-3">
            <div>
                <MudTextField @bind-Value="_p.MovieTemplate" @bind-Value:after="Refresh" Label="Movie template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewMovie()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.TvEpisodeTemplate" @bind-Value:after="Refresh" Label="TV episode template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewEpisode()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.SeasonPackFolderTemplate" @bind-Value:after="Refresh" Label="Season-pack folder template (used when pack splitting is off)" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewSeasonFolder()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.MusicTrackTemplate" @bind-Value:after="Refresh" Label="Music track template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewMusic()</MudText>
            </div>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-3">
            Available tokens: <code>{Title}</code>/<code>{ShowTitle}</code>, <code>{Year}</code>, <code>{Season}</code>/<code>{Season:00}</code>,
            <code>{Episode}</code>/<code>{Episode:00}</code>, <code>{EpisodeTitle}</code>, <code>{Quality}</code>, <code>{Ext}</code>.
            Music also supports <code>{Artist}</code>, <code>{Album}</code>, <code>{Disc:00}</code>, <code>{Track:00}</code>, and <code>{TrackTitle}</code>.
            <code>:00</code> zero-pads season/episode numbers to 2 digits.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <MudText Typo="Typo.h6">Advanced routing rules</MudText>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule">Add rule</MudButton>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">
            Route content to a named destination (e.g. Anime Movies, Anime TV, Kids TV, or 4K Movies).
            First matching rule wins; unmatched content uses the default destination for its content type.
            Anime is detected automatically (Animation genre + Japanese language/origin) — no manual tagging needed.
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">
            Rules can only target an enabled destination with the same scanner shape. Anime Movies and Anime TV
            therefore need separate Movie and TV destinations. Hardlink transfer falls back to copy when the
            selected destination is on another filesystem.
        </MudText>
        @if (_p.LibraryRootRules.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="py-2">No routing rules — everything uses the default roots/templates.</MudText>
        }
        else
        {
            @for (var i = 0; i < _p.LibraryRootRules.Count; i++)
            {
                var idx = i;
                var rule = _p.LibraryRootRules[idx];
                <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
                    <MudSelect T="MediaType" @bind-Value="rule.MediaType" Label="Media type" dense="true" Variant="Variant.Outlined" Style="min-width:140px;">
                        <MudSelectItem Value="MediaType.Movie">Movie</MudSelectItem>
                        <MudSelectItem Value="MediaType.TvShow">TV Show</MudSelectItem>
                        <MudSelectItem Value="MediaType.Music">Music</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="bool?" @bind-Value="rule.RequireAnime" Label="Content" dense="true" Variant="Variant.Outlined" Style="min-width:160px;">
                        <MudSelectItem T="bool?" Value="null">Any</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">Anime only</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Non-anime only</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="rule.GenreContains" Label="Genre contains (optional)" Placeholder="e.g. Documentary" dense="true" Variant="Variant.Outlined" Style="min-width:200px;" />
                    <MudSelect T="string" @bind-Value="rule.DestinationId" Label="Destination" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                        @foreach (var destination in RuleDestinations(rule))
                        {
                            <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="rule.TemplateOverride" Label="Template override (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:280px;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveRule(idx))" />
                </div>
            }
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Transfer behavior</MudText>
        <div class="d-flex gap-3 flex-wrap align-items-center">
            <MudSelect T="TransferMode" @bind-Value="_p.TransferMode" Label="Transfer mode" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                <MudSelectItem Value="TransferMode.Hardlink">Hardlink (keeps seeding)</MudSelectItem>
                <MudSelectItem Value="TransferMode.Copy">Copy</MudSelectItem>
                <MudSelectItem Value="TransferMode.Move">Move</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_p.ExtractArchives" Color="Color.Primary" Label="Extract RAR/ZIP archives" />
            <MudSwitch T="bool" @bind-Value="_p.SplitSeasonPacks" Color="Color.Primary" Label="Split season packs into per-episode files" />
            <MudSwitch T="bool" @bind-Value="_p.KeepSubtitles" Color="Color.Primary" Label="Keep subtitles" />
            <MudSwitch T="bool" @bind-Value="_p.DeleteSourceAfterImport" Color="Color.Primary" Label="Delete source after import" Disabled="_p.TransferMode == TransferMode.Hardlink" />
        </div>
        @if (_p.TransferMode == TransferMode.Hardlink)
        {
            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
                "Delete source after import" is unavailable in Hardlink mode — the library copy and the seeding torrent's file are the same data on disk.
            </MudText>
        }
        <div class="d-flex gap-3 flex-wrap align-items-center mt-3">
            <MudTextField @bind-Value="_p.VideoExtensionsCsv" Label="Video extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudTextField @bind-Value="_p.SubtitleExtensionsCsv" Label="Subtitle extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudTextField @bind-Value="_p.AudioExtensionsCsv" Label="Audio extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudNumericField T="double" @bind-Value="_p.MinVideoFileSizeMb" Label="Min video file size (MB)" Variant="Variant.Outlined" dense="true" Min="0" Style="max-width:220px;" />
            <MudNumericField T="double" @bind-Value="_p.MinAudioFileSizeMb" Label="Min audio file size (MB)" Variant="Variant.Outlined" dense="true" Min="0" Style="max-width:220px;" />
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
            Files below the minimum size are treated as samples/junk, not real episodes/movies.
        </MudText>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private LibraryOrganizationPreferencesDto? _p;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try { _p = await Prefs.GetAsync(); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        if (_p is null) return;
        if (!LibraryRouting.TryNormalizeAndValidate(_p, out var error))
        {
            await Toast.ShowErrorAsync(error ?? "Library destination settings are invalid.");
            return;
        }
        if (await Prefs.UpdateAsync(_p)) await Toast.ShowSuccessAsync("Library organization settings saved.");
        else await Toast.ShowErrorAsync("Save failed.");
    }

    private void Refresh() => StateHasChanged();

    private async Task BrowseDestination(int index)
    {
        var destination = _p!.LibraryDestinations[index];
        if (await BrowseAsync(destination.RootPath) is { } chosen) destination.RootPath = chosen;
    }

    private async Task<string?> BrowseAsync(string? startPath)
    {
        var parameters = new MudBlazor.DialogParameters<FolderBrowserDialog> { { x => x.StartPath, startPath } };
        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FolderBrowserDialog>("Choose a folder", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false } ? result.Data as string : null;
    }

    private void AddRule()
    {
        _p!.LibraryRootRules.Add(new LibraryRootRuleDto
        {
            MediaType = MediaType.TvShow,
            DestinationId = EnabledDestinations(LibraryContentKind.Series).FirstOrDefault()?.Id
        });
        StateHasChanged();
    }

    private void RemoveRule(int index)
    {
        _p!.LibraryRootRules.RemoveAt(index);
        StateHasChanged();
    }

    private void AddDestination()
    {
        _p!.LibraryDestinations.Add(new LibraryDestinationDto
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = "New TV library",
            ContentKind = LibraryContentKind.Series,
            Enabled = true
        });
        StateHasChanged();
    }

    private async Task RemoveDestination(int index)
    {
        var destination = _p!.LibraryDestinations[index];
        if (destination.IsDefault)
        {
            await Toast.ShowErrorAsync("Choose another default before removing this destination.");
            return;
        }
        if (_p.LibraryRootRules.Any(r => string.Equals(r.DestinationId, destination.Id, StringComparison.OrdinalIgnoreCase)))
        {
            await Toast.ShowErrorAsync("Remove or retarget routing rules that use this destination first.");
            return;
        }
        _p.LibraryDestinations.RemoveAt(index);
        StateHasChanged();
    }

    private IEnumerable<LibraryDestinationDto> EnabledDestinations(LibraryContentKind kind) =>
        _p!.LibraryDestinations.Where(d => d.ContentKind == kind && d.Enabled);

    private IEnumerable<LibraryDestinationDto> RuleDestinations(LibraryRootRuleDto rule) =>
        EnabledDestinations(LibraryRouting.ContentKind(rule.MediaType));

    private string DefaultMovieId
    {
        get => DefaultId(LibraryContentKind.Movie);
        set => SetDefault(LibraryContentKind.Movie, value);
    }

    private string DefaultSeriesId
    {
        get => DefaultId(LibraryContentKind.Series);
        set => SetDefault(LibraryContentKind.Series, value);
    }

    private string DefaultMusicId
    {
        get => DefaultId(LibraryContentKind.Music);
        set => SetDefault(LibraryContentKind.Music, value);
    }

    private string DefaultId(LibraryContentKind kind) =>
        _p?.LibraryDestinations.FirstOrDefault(d => d.ContentKind == kind && d.IsDefault)?.Id ?? string.Empty;

    private void SetDefault(LibraryContentKind kind, string id)
    {
        foreach (var destination in _p!.LibraryDestinations.Where(d => d.ContentKind == kind))
            destination.IsDefault = destination.Id.Equals(id, StringComparison.OrdinalIgnoreCase);
    }

    private static string ContentKindLabel(LibraryContentKind kind) => kind switch
    {
        LibraryContentKind.Movie => "movie",
        LibraryContentKind.Series => "TV",
        _ => "music"
    };

    // Preview-only rendering — a simplified stand-in for the downloader's real NamingTemplateEngine,
    // just to show admins roughly what a sample title would resolve to before saving.
    private static readonly Regex TokenRx = new(@"\{(\w+)(?::(0+))?\}", RegexOptions.Compiled);

    private string PreviewMovie() => Render(_p!.MovieTemplate, "Sample Movie", 2024, null, null, null, "1080p", ".mkv");
    private string PreviewEpisode() => Render(_p!.TvEpisodeTemplate, "Sample Show", 2024, 1, 3, "The Pilot", "1080p", ".mkv");
    private string PreviewSeasonFolder() => Render(_p!.SeasonPackFolderTemplate, "Sample Show", 2024, 1, null, null, null, null);
    private string PreviewMusic() => RenderMusic(_p!.MusicTrackTemplate);

    private static string Render(string template, string title, int? year, int? season, int? episode, string? episodeTitle, string? quality, string? ext)
    {
        if (string.IsNullOrWhiteSpace(template)) return "(empty template)";
        return TokenRx.Replace(template, m =>
        {
            var token = m.Groups[1].Value;
            var pad = m.Groups[2].Success ? m.Groups[2].Value.Length : 0;
            string? value = token switch
            {
                "Title" or "ShowTitle" => title,
                "Year" => year?.ToString(),
                "Season" => pad > 0 ? season?.ToString($"D{pad}") : season?.ToString(),
                "Episode" => pad > 0 ? episode?.ToString($"D{pad}") : episode?.ToString(),
                "EpisodeTitle" => episodeTitle,
                "Quality" => quality,
                "Ext" => ext,
                _ => null
            };
            return value ?? string.Empty;
        });
    }

    private static string RenderMusic(string template) => TokenRx.Replace(template, m => m.Groups[1].Value switch
    {
        "Title" or "TrackTitle" => "Sample Track",
        "Artist" => "Sample Artist",
        "Album" => "Sample Album",
        "Year" => "2026",
        "Disc" => "01",
        "Track" => "03",
        "Ext" => ".flac",
        _ => string.Empty
    });
}
