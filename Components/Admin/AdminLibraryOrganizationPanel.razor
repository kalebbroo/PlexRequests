@using System.Text.RegularExpressions
@using PlexRequestsHosted.Shared
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Implementations.ILibraryOrganizationPreferencesService Prefs
@inject PlexRequestsHosted.Services.Implementations.ITmdbEpisodeGroupImportService EpisodeGroups
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast
@inject MudBlazor.IDialogService DialogService

<div class="d-flex justify-content-end align-items-center mb-2">
    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="_loading">Save changes</MudButton>
</div>
<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4">
    Choose the folders Plex Requests should use for completed media. The defaults below are enough for most
    installations; specialized routing, episode numbering, naming, and import controls are available when needed.
    Changes apply to new imports only.
</MudText>

@if (_loading || _p is null)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <MudText Typo="Typo.h6">Library folders</MudText>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddDestination">Add library folder</MudButton>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-3">
            Add one folder for each Plex library, such as Movies, TV, Anime Movies, Anime TV, or Kids TV.
            Movie and TV folders stay safely separated. Users see only friendly names, never filesystem paths.
        </MudText>
        @if (HasMultipleDestinations)
        {
            <div class="library-defaults mb-4">
                <MudText Typo="Typo.subtitle2">Default folder when no special routing rule matches</MudText>
                <div class="d-flex gap-3 flex-wrap align-items-center mt-2">
                    @if (HasMultipleDestinationsFor(LibraryContentKind.Movie))
                    {
                        <MudSelect T="string" @bind-Value="DefaultMovieId" Label="Movies" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                            @foreach (var destination in EnabledDestinations(LibraryContentKind.Movie))
                            {
                                <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @if (HasMultipleDestinationsFor(LibraryContentKind.Series))
                    {
                        <MudSelect T="string" @bind-Value="DefaultSeriesId" Label="TV / series" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                            @foreach (var destination in EnabledDestinations(LibraryContentKind.Series))
                            {
                                <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @if (HasMultipleDestinationsFor(LibraryContentKind.Music))
                    {
                        <MudSelect T="string" @bind-Value="DefaultMusicId" Label="Music" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                            @foreach (var destination in EnabledDestinations(LibraryContentKind.Music))
                            {
                                <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
            </div>
        }
        @for (var i = 0; i < _p.LibraryDestinations.Count; i++)
        {
            var idx = i;
            var destination = _p.LibraryDestinations[idx];
            <details class="library-destination">
                <summary>
                    <MudIcon Icon="@ContentKindIcon(destination.ContentKind)" Size="Size.Small" />
                    <span>
                        <b>@destination.Name</b>
                        <small>@ContentKindSummary(destination.ContentKind) · @DestinationPathSummary(destination)</small>
                    </span>
                    @if (destination.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Default</MudChip>
                    }
                </summary>
                <div class="library-destination-content">
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <MudTextField @bind-Value="destination.Name" Label="Name" dense="true" Variant="Variant.Outlined" Style="min-width:190px;" />
                    <MudSelect T="LibraryContentKind" @bind-Value="destination.ContentKind" Label="Content type" dense="true"
                               Variant="Variant.Outlined" Disabled="destination.IsDefault" Style="min-width:150px;">
                        <MudSelectItem Value="LibraryContentKind.Movie">Movies</MudSelectItem>
                        <MudSelectItem Value="LibraryContentKind.Series">TV / series</MudSelectItem>
                        <MudSelectItem Value="LibraryContentKind.Music">Music</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="destination.RootPath" Label="Root path" dense="true" Variant="Variant.Outlined" Style="min-width:310px;"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FolderOpen" OnAdornmentClick="@(() => BrowseDestination(idx))" />
                    <MudSwitch T="bool" @bind-Value="destination.Enabled" Color="Color.Primary" Label="Enabled" Disabled="destination.IsDefault" />
                    <MudSwitch T="bool" @bind-Value="destination.AllowUserSelection" Color="Color.Primary" Label="Users may select" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Disabled="destination.IsDefault"
                                   OnClick="@(() => RemoveDestination(idx))" />
                </div>
                @if (destination.IsDefault)
                {
                    <MudText Typo="Typo.caption" Color="Color.Primary">Default @ContentKindLabel(destination.ContentKind) destination</MudText>
                }
                <details class="destination-options">
                    <summary>Advanced destination options</summary>
                    <div class="d-flex gap-2 flex-wrap align-items-center mt-3">
                        <MudTextField @bind-Value="destination.PlexSectionId" Label="Plex section ID (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:210px;" />
                        <MudTextField @bind-Value="destination.TemplateOverride" Label="Naming override (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:300px;" />
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
                        Leave these blank unless this folder needs a targeted Plex scan or a different naming template.
                    </MudText>
                </details>
                </div>
            </details>
        }
        <MudText Typo="Typo.caption" Color="Color.Tertiary">
            For a NAS or network drive, configure it under <b>Libraries &amp; importing → Network storage</b> and select a path
            beneath <code>/mnt/nas/&lt;name&gt;</code>. Plex section IDs are carried with jobs for targeted scan and
            verification support; leaving them empty keeps the current media-type refresh behavior.
        </MudText>
    </MudPaper>

    <div class="library-optional-heading">
        <MudText Typo="Typo.h6">Optional setup</MudText>
        <MudText Typo="Typo.body2" Color="Color.Tertiary">
            Open only the task you need. Existing settings are summarized beside each task.
        </MudText>
    </div>

    <div class="library-task-list">
    <details class="library-task">
        <summary>
            <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" />
            <span><b>Handle alternate episode numbering</b><small>Anime absolute order, DVD order, digital order, or custom mappings.</small></span>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_p.SeriesEpisodeOrderProfiles.Count configured</MudChip>
        </summary>
        <div class="library-task-content">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <MudText Typo="Typo.h6">Series episode ordering</MudText>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddEpisodeOrderProfile">Add series</MudButton>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-3">
            Translate absolute, DVD, digital, or custom release numbering into the aired season/episode numbers
            Plex uses for this series. The mapping is frozen onto each new job. An incomplete mapping rejects
            the release before any library write instead of guessing.
        </MudText>
        @if (_p.SeriesEpisodeOrderProfiles.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary">No series-specific ordering profiles.</MudText>
        }
        @for (var i = 0; i < _p.SeriesEpisodeOrderProfiles.Count; i++)
        {
            var idx = i;
            var profile = _p.SeriesEpisodeOrderProfiles[idx];
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
                    <MudTextField T="string" Value="@SeriesSearch(profile)"
                                  ValueChanged="@(value => SetSeriesSearch(profile, value))"
                                  Label="Find a TMDb series" Placeholder="Search by series title"
                                  Variant="Variant.Outlined" dense="true" Style="min-width:280px;" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@(SeriesSearch(profile).Trim().Length < 2 || IsSearchingSeries(profile))"
                               OnClick="@(() => SearchSeries(profile))">
                        @(IsSearchingSeries(profile) ? "Searching…" : "Search")
                    </MudButton>
                    @if (_seriesResults.TryGetValue(profile, out var seriesResults) && seriesResults.Count > 0)
                    {
                        <MudSelect T="int" Value="@profile.TmdbId"
                                   ValueChanged="@(value => SelectSeriesResult(profile, value))"
                                   Label="Matching series" Variant="Variant.Outlined" dense="true"
                                   Style="min-width:320px;">
                            @foreach (var result in seriesResults)
                            {
                                <MudSelectItem T="int" Value="@result.Id">
                                    @result.Title @(result.Year is int year ? $"({year})" : null) · TMDb @result.Id
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </div>
                <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
                    <MudNumericField T="int" Value="@profile.TmdbId"
                                     ValueChanged="@(value => ChangeSeriesIdentity(profile, value))"
                                     Label="TMDb series ID" Min="1"
                                     Variant="Variant.Outlined" dense="true" Style="max-width:170px;" />
                    <MudTextField @bind-Value="profile.SeriesTitle" Label="Series name" Variant="Variant.Outlined"
                                  dense="true" Style="min-width:240px;" />
                    <MudSelect T="EpisodeOrderType" @bind-Value="profile.SourceOrder"
                               @bind-Value:after="@(() => OrderEdited(profile))" Label="Release order"
                               Variant="Variant.Outlined" dense="true" Style="min-width:180px;">
                        <MudSelectItem Value="EpisodeOrderType.Absolute">Absolute</MudSelectItem>
                        <MudSelectItem Value="EpisodeOrderType.Dvd">DVD</MudSelectItem>
                        <MudSelectItem Value="EpisodeOrderType.Digital">Digital</MudSelectItem>
                        <MudSelectItem Value="EpisodeOrderType.Custom">Custom</MudSelectItem>
                        <MudSelectItem Value="EpisodeOrderType.Aired">Aired (identity)</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="profile.Enabled" Color="Color.Primary" Label="Enabled" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => RemoveEpisodeOrderProfile(idx))" />
                </div>
                @if (profile.SourceOrder != EpisodeOrderType.Aired)
                {
                    <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   Disabled="@(profile.TmdbId <= 0 || IsLoadingGroups(profile))"
                                   OnClick="@(() => LoadEpisodeGroups(profile))">
                            @(IsLoadingGroups(profile) ? "Loading…" : "Load TMDb groups")
                        </MudButton>
                        @if (_episodeGroups.TryGetValue(profile, out var groups))
                        {
                            <MudSelect T="string" Value="@SelectedGroup(profile)"
                                       ValueChanged="@(value => SelectGroup(profile, value))"
                                       Label="TMDb episode group" Variant="Variant.Outlined" dense="true"
                                       Style="min-width:320px;">
                                @foreach (var group in groups)
                                {
                                    <MudSelectItem T="string" Value="@group.Id">
                                        @group.Name · @group.TypeName · @group.EpisodeCount episodes
                                    </MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="@(string.IsNullOrWhiteSpace(SelectedGroup(profile)) || IsImportingGroup(profile))"
                                       OnClick="@(() => PreviewAndImportEpisodeGroup(profile))">
                                @(IsImportingGroup(profile) ? "Importing…" : "Preview & import")
                            </MudButton>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(profile.SourceEpisodeGroupName))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-2">
                            Imported from TMDb group <b>@profile.SourceEpisodeGroupName</b>
                            @if (profile.ImportedAt is DateTime importedAt)
                            {
                                <span> on @importedAt.ToLocalTime().ToString("g")</span>
                            }
                        </MudText>
                    }
                    <MudTextField @bind-Value="profile.MappingsText" @bind-Value:after="@(() => MappingEdited(profile))"
                                  Label="Episode translations" Lines="6"
                                  Variant="Variant.Outlined" FullWidth="true"
                                  Placeholder="A1 -> S01E01&#10;A13 -> S02E01&#10;S01E14 -> S02E02" />
                    <MudText Typo="Typo.caption" Color="Color.Tertiary">
                        One source-to-Plex mapping per line. Use <code>A13</code> for absolute episode 13 or
                        <code>S01E13</code> for a season-based DVD/digital/custom source.
                    </MudText>
                }
            </MudPaper>
        }
        </div>
    </details>

    <details class="library-task">
        <summary>
            <MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Size="Size.Small" />
            <span><b>Customize file names</b><small>Change Plex folder and filename templates with live previews.</small></span>
        </summary>
        <div class="library-task-content">
        <MudText Typo="Typo.h6" Class="mb-3">Naming templates</MudText>
        <div class="d-flex flex-column gap-3">
            <div>
                <MudTextField @bind-Value="_p.MovieTemplate" @bind-Value:after="Refresh" Label="Movie template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewMovie()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.TvEpisodeTemplate" @bind-Value:after="Refresh" Label="TV episode template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewEpisode()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.SeasonPackFolderTemplate" @bind-Value:after="Refresh" Label="Season-pack folder template (used when pack splitting is off)" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewSeasonFolder()</MudText>
            </div>
            <div>
                <MudTextField @bind-Value="_p.MusicTrackTemplate" @bind-Value:after="Refresh" Label="Music track template" Variant="Variant.Outlined" dense="true" FullWidth="true" />
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Preview: @PreviewMusic()</MudText>
            </div>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-3">
            Available tokens: <code>{Title}</code>/<code>{ShowTitle}</code>, <code>{Year}</code>, <code>{Season}</code>/<code>{Season:00}</code>,
            <code>{Episode}</code>/<code>{Episode:00}</code>, <code>{EpisodeTitle}</code>, <code>{Quality}</code>, <code>{Ext}</code>.
            Music also supports <code>{Artist}</code>, <code>{Album}</code>, <code>{Disc:00}</code>, <code>{Track:00}</code>, and <code>{TrackTitle}</code>.
            <code>:00</code> zero-pads season/episode numbers to 2 digits.
        </MudText>
        </div>
    </details>

    <details class="library-task">
        <summary>
            <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Small" />
            <span><b>Route anime, kids, and special libraries</b><small>Send matching content to a different library folder.</small></span>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_p.LibraryRootRules.Count rule@(_p.LibraryRootRules.Count == 1 ? "" : "s")</MudChip>
        </summary>
        <div class="library-task-content">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <MudText Typo="Typo.h6">Library routing rules</MudText>
            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule">Add rule</MudButton>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">
            Route content to a named destination (e.g. Anime Movies, Anime TV, Kids TV, or 4K Movies).
            First matching rule wins; unmatched content uses the default destination for its content type.
            Anime is detected automatically (Animation genre + Japanese language/origin) — no manual tagging needed.
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-2">
            Rules can only target an enabled destination with the same scanner shape. Anime Movies and Anime TV
            therefore need separate Movie and TV destinations. Hardlink transfer falls back to copy when the
            selected destination is on another filesystem.
        </MudText>
        @if (_p.LibraryRootRules.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="py-2">No routing rules — everything uses the default roots/templates.</MudText>
        }
        else
        {
            @for (var i = 0; i < _p.LibraryRootRules.Count; i++)
            {
                var idx = i;
                var rule = _p.LibraryRootRules[idx];
                <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
                    <MudSelect T="MediaType" @bind-Value="rule.MediaType" Label="Media type" dense="true" Variant="Variant.Outlined" Style="min-width:140px;">
                        <MudSelectItem Value="MediaType.Movie">Movie</MudSelectItem>
                        <MudSelectItem Value="MediaType.TvShow">TV Show</MudSelectItem>
                        <MudSelectItem Value="MediaType.Music">Music</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="bool?" @bind-Value="rule.RequireAnime" Label="Content" dense="true" Variant="Variant.Outlined" Style="min-width:160px;">
                        <MudSelectItem T="bool?" Value="null">Any</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">Anime only</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">Non-anime only</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="rule.GenreContains" Label="Genre contains (optional)" Placeholder="e.g. Documentary" dense="true" Variant="Variant.Outlined" Style="min-width:200px;" />
                    <MudSelect T="string" @bind-Value="rule.DestinationId" Label="Destination" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                        @foreach (var destination in RuleDestinations(rule))
                        {
                            <MudSelectItem T="string" Value="@destination.Id">@destination.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="rule.TemplateOverride" Label="Template override (optional)" dense="true" Variant="Variant.Outlined" Style="min-width:280px;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveRule(idx))" />
                </div>
            }
        }
        </div>
    </details>

    <details class="library-task">
        <summary>
            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" />
            <span><b>Change import and file handling</b><small>Transfer mode, archives, season packs, subtitles, and sample detection.</small></span>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@TransferModeLabel(_p.TransferMode)</MudChip>
        </summary>
        <div class="library-task-content">
        <MudText Typo="Typo.h6" Class="mb-3">Import behavior</MudText>
        <div class="d-flex gap-3 flex-wrap align-items-center">
            <MudSelect T="TransferMode" @bind-Value="_p.TransferMode" Label="Transfer mode" dense="true" Variant="Variant.Outlined" Style="min-width:220px;">
                <MudSelectItem Value="TransferMode.Hardlink">Hardlink (keeps seeding)</MudSelectItem>
                <MudSelectItem Value="TransferMode.Copy">Copy</MudSelectItem>
                <MudSelectItem Value="TransferMode.Move">Move</MudSelectItem>
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="_p.ExtractArchives" Color="Color.Primary" Label="Extract RAR/ZIP archives" />
            <MudSwitch T="bool" @bind-Value="_p.SplitSeasonPacks" Color="Color.Primary" Label="Split season packs into per-episode files" />
            <MudSwitch T="bool" @bind-Value="_p.KeepSubtitles" Color="Color.Primary" Label="Keep subtitles" />
            <MudSwitch T="bool" @bind-Value="_p.DeleteSourceAfterImport" Color="Color.Primary" Label="Delete source after import" Disabled="_p.TransferMode == TransferMode.Hardlink" />
        </div>
        @if (_p.TransferMode == TransferMode.Hardlink)
        {
            <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
                "Delete source after import" is unavailable in Hardlink mode — the library copy and the seeding torrent's file are the same data on disk.
            </MudText>
        }
        <div class="d-flex gap-3 flex-wrap align-items-center mt-3">
            <MudTextField @bind-Value="_p.VideoExtensionsCsv" Label="Video extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudTextField @bind-Value="_p.SubtitleExtensionsCsv" Label="Subtitle extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudTextField @bind-Value="_p.AudioExtensionsCsv" Label="Audio extensions (comma-separated)" Variant="Variant.Outlined" dense="true" Style="min-width:320px;" />
            <MudNumericField T="double" @bind-Value="_p.MinVideoFileSizeMb" Label="Min video file size (MB)" Variant="Variant.Outlined" dense="true" Min="0" Style="max-width:220px;" />
            <MudNumericField T="double" @bind-Value="_p.MinAudioFileSizeMb" Label="Min audio file size (MB)" Variant="Variant.Outlined" dense="true" Min="0" Style="max-width:220px;" />
        </div>
        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
            Files below the minimum size are treated as samples/junk, not real episodes/movies.
        </MudText>
        </div>
    </details>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">Save changes</MudButton>
    </div>
}

@code {
    private bool _loading = true;
    private LibraryOrganizationPreferencesDto? _p;
    private readonly Dictionary<SeriesEpisodeOrderProfileDto, List<TmdbEpisodeGroupSummaryDto>> _episodeGroups = new();
    private readonly Dictionary<SeriesEpisodeOrderProfileDto, string> _selectedEpisodeGroups = new();
    private readonly HashSet<SeriesEpisodeOrderProfileDto> _groupsLoading = new();
    private readonly HashSet<SeriesEpisodeOrderProfileDto> _groupsImporting = new();
    private readonly Dictionary<SeriesEpisodeOrderProfileDto, string> _seriesSearches = new();
    private readonly Dictionary<SeriesEpisodeOrderProfileDto, List<MediaCardDto>> _seriesResults = new();
    private readonly HashSet<SeriesEpisodeOrderProfileDto> _seriesSearching = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try { _p = await Prefs.GetAsync(); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task Save()
    {
        if (_p is null) return;
        if (!LibraryRouting.TryNormalizeAndValidate(_p, out var error))
        {
            await Toast.ShowErrorAsync(error ?? "Library destination settings are invalid.");
            return;
        }
        var duplicateTmdb = _p.SeriesEpisodeOrderProfiles.Where(x => x.TmdbId > 0)
            .GroupBy(x => x.TmdbId).FirstOrDefault(x => x.Count() > 1);
        if (duplicateTmdb is not null)
        {
            await Toast.ShowErrorAsync($"TMDb series {duplicateTmdb.Key} has more than one episode-order profile.");
            return;
        }
        foreach (var profile in _p.SeriesEpisodeOrderProfiles.Where(x => x.SourceOrder != EpisodeOrderType.Aired))
        {
            if (profile.TmdbId <= 0)
            {
                await Toast.ShowErrorAsync("Every episode-order profile needs a valid TMDb series ID.");
                return;
            }
            if (!EpisodeOrderMapping.TryParse(profile, out _, out var mappingError))
            {
                var label = string.IsNullOrWhiteSpace(profile.SeriesTitle) ? $"TMDb {profile.TmdbId}" : profile.SeriesTitle.Trim();
                await Toast.ShowErrorAsync($"{label}: {mappingError}");
                return;
            }
        }
        if (await Prefs.UpdateAsync(_p)) await Toast.ShowSuccessAsync("Library organization settings saved.");
        else await Toast.ShowErrorAsync("Save failed.");
    }

    private void Refresh() => StateHasChanged();

    private async Task BrowseDestination(int index)
    {
        var destination = _p!.LibraryDestinations[index];
        if (await BrowseAsync(destination.RootPath) is { } chosen) destination.RootPath = chosen;
    }

    private async Task<string?> BrowseAsync(string? startPath)
    {
        var parameters = new MudBlazor.DialogParameters<FolderBrowserDialog> { { x => x.StartPath, startPath } };
        var options = new MudBlazor.DialogOptions { MaxWidth = MudBlazor.MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<FolderBrowserDialog>("Choose a folder", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false } ? result.Data as string : null;
    }

