    private void RemoveEpisodeOrderProfile(int index)
    {
        var profile = _p!.SeriesEpisodeOrderProfiles[index];
        _episodeGroups.Remove(profile);
        _selectedEpisodeGroups.Remove(profile);
        _groupsLoading.Remove(profile);
        _groupsImporting.Remove(profile);
        _seriesSearches.Remove(profile);
        _seriesResults.Remove(profile);
        _seriesSearching.Remove(profile);
        _p.SeriesEpisodeOrderProfiles.RemoveAt(index);
        StateHasChanged();
