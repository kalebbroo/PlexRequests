    private bool IsLoadingGroups(SeriesEpisodeOrderProfileDto profile) => _groupsLoading.Contains(profile);
    private bool IsImportingGroup(SeriesEpisodeOrderProfileDto profile) => _groupsImporting.Contains(profile);
    private string? SelectedGroup(SeriesEpisodeOrderProfileDto profile) =>
        _selectedEpisodeGroups.GetValueOrDefault(profile);
    private void SelectGroup(SeriesEpisodeOrderProfileDto profile, string value) =>
        _selectedEpisodeGroups[profile] = value;

    private string SeriesSearch(SeriesEpisodeOrderProfileDto profile) =>
        _seriesSearches.GetValueOrDefault(profile) ?? string.Empty;
    private void SetSeriesSearch(SeriesEpisodeOrderProfileDto profile, string value) =>
        _seriesSearches[profile] = value;
    private bool IsSearchingSeries(SeriesEpisodeOrderProfileDto profile) => _seriesSearching.Contains(profile);

    private async Task SearchSeries(SeriesEpisodeOrderProfileDto profile)
    {
        var query = SeriesSearch(profile).Trim();
        if (query.Length < 2) return;
        _seriesSearching.Add(profile);
        StateHasChanged();
        try
        {
            var results = await EpisodeGroups.SearchSeriesAsync(query);
            _seriesResults[profile] = results;
            if (results.Count == 0) await Toast.ShowErrorAsync("No matching TMDb series found.");
        }
        catch (Exception ex)
        {
            await Toast.ShowErrorAsync($"TMDb series search failed: {ex.Message}");
        }
        finally
        {
            _seriesSearching.Remove(profile);
            StateHasChanged();
        }
    }

    private async Task SelectSeriesResult(SeriesEpisodeOrderProfileDto profile, int tmdbId)
    {
        var result = _seriesResults.GetValueOrDefault(profile)?.FirstOrDefault(x => x.Id == tmdbId);
        if (result is null || !await ChangeSeriesIdentity(profile, result.Id, result.Title)) return;
        _seriesSearches[profile] = result.Title;
        await LoadEpisodeGroups(profile);
    }

    private async Task<bool> ChangeSeriesIdentity(SeriesEpisodeOrderProfileDto profile, int tmdbId,
        string? title = null)
    {
        if (profile.TmdbId != tmdbId && !string.IsNullOrWhiteSpace(profile.MappingsText))
        {
            var confirmed = await DialogService.ShowMessageBox("Change episode-order series",
                "Changing the TMDb series clears the current episode mappings so they cannot be applied to the wrong show.",
                yesText: "Change series", cancelText: "Cancel");
            if (confirmed != true) return false;
        }

        EpisodeOrderMapping.AssignSeries(profile, tmdbId, title);
        _episodeGroups.Remove(profile);
        _selectedEpisodeGroups.Remove(profile);
        StateHasChanged();
        return true;
    }

    private async Task LoadEpisodeGroups(SeriesEpisodeOrderProfileDto profile)
    {
        if (profile.TmdbId <= 0) return;
        _groupsLoading.Add(profile);
        StateHasChanged();
        try
        {
            var groups = await EpisodeGroups.GetGroupsAsync(profile.TmdbId);
            _episodeGroups[profile] = groups;
            if (groups.Count == 0)
                await Toast.ShowErrorAsync("TMDb has no episode groups for this series.");
            else
            {
                _selectedEpisodeGroups[profile] = !string.IsNullOrWhiteSpace(profile.SourceEpisodeGroupId)
                    && groups.Any(x => x.Id == profile.SourceEpisodeGroupId)
                    ? profile.SourceEpisodeGroupId
                    : groups.First().Id;
                await Toast.ShowSuccessAsync($"Loaded {groups.Count} TMDb episode group(s).");
            }
        }
        catch (Exception ex)
        {
            await Toast.ShowErrorAsync(ex.Message);
        }
        finally
        {
            _groupsLoading.Remove(profile);
            StateHasChanged();
        }
    }

    private async Task PreviewAndImportEpisodeGroup(SeriesEpisodeOrderProfileDto profile)
    {
        var selectedGroup = SelectedGroup(profile);
        if (string.IsNullOrWhiteSpace(selectedGroup)) return;
        _groupsImporting.Add(profile);
        StateHasChanged();
        try
        {
            var preview = await EpisodeGroups.BuildPreviewAsync(profile.TmdbId, profile.SeriesTitle,
                selectedGroup);
            var message = $"Import {preview.MappedEpisodeCount} validated episode mapping(s) from "
                + $"\"{preview.Profile.SourceEpisodeGroupName}\"?"
                + (preview.Warning is null ? string.Empty : $" {preview.Warning}")
                + (string.IsNullOrWhiteSpace(profile.MappingsText)
                    ? string.Empty
                    : " This replaces the mappings currently in the editor; settings are not persisted until you click Save.");
            var confirmed = await DialogService.ShowMessageBox("Import TMDb episode group", message,
                yesText: "Import", cancelText: "Cancel");
            if (confirmed != true) return;

            profile.SourceOrder = preview.Profile.SourceOrder;
            profile.SourceEpisodeGroupId = preview.Profile.SourceEpisodeGroupId;
            profile.SourceEpisodeGroupName = preview.Profile.SourceEpisodeGroupName;
            profile.ImportedAt = preview.Profile.ImportedAt;
            profile.MappingsText = preview.Profile.MappingsText;
            profile.Enabled = true;
            await Toast.ShowSuccessAsync($"Imported {preview.MappedEpisodeCount} validated episode mapping(s). Click Save to persist them.");
        }
        catch (Exception ex)
        {
            await Toast.ShowErrorAsync(ex.Message);
        }
        finally
        {
            _groupsImporting.Remove(profile);
            StateHasChanged();
        }
    }

    private void MappingEdited(SeriesEpisodeOrderProfileDto profile)
    {
        profile.SourceEpisodeGroupId = null;
        profile.SourceEpisodeGroupName = null;
        profile.ImportedAt = null;
    }

    private void OrderEdited(SeriesEpisodeOrderProfileDto profile) => MappingEdited(profile);

