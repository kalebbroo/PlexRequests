@using PlexRequestsHosted.Services.Abstractions
@using PlexRequestsHosted.Shared.Enums
@inject IDatabaseAdminService DbAdmin
@inject IToastService Toast
@inject IDialogService Dialog

<div class="maintenance-toolbar">
    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
        Maintenance changes application records only. Movies, episodes, music, and other files in your Plex libraries are never deleted here.
    </MudAlert>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_busy" aria-label="Refresh maintenance status" />
</div>

@if (_overview is null)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <section class="maintenance-section" aria-labelledby="protect-data-heading">
        <MudText Typo="Typo.h6" HtmlTag="h3" id="protect-data-heading">Protect your data</MudText>
        <MudText Typo="Typo.body2" Class="text-muted mb-2">Download a backup before major configuration changes or cleanup.</MudText>
        <article class="backup-card">
            <span class="maintenance-icon"><MudIcon Icon="@Icons.Material.Filled.Storage" /></span>
            <div class="backup-copy">
                <MudText Typo="Typo.subtitle1"><b>Plex Requests data</b></MudText>
                <MudText Typo="Typo.body2" Class="text-muted">One database file · @FormatSize(_overview.SizeBytes)</MudText>
            </div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Download"
                       Href="/api/admin/db/backup" Target="_blank">Download backup</MudButton>
        </article>

        <details class="maintenance-details">
            <summary><span><b>Database details</b><small>File location, table counts, and compaction.</small></span></summary>
            <div class="maintenance-details-content">
                <div class="database-file-row">
                    <MudText Typo="Typo.body2"><b>File:</b> <code>@_overview.Path</code></MudText>
                    <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Compress"
                               OnClick="Compact" Disabled="_busy">Compact database</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">
                    Compaction reclaims unused database space. It does not remove active records.
                </MudText>
                <MudTable T="DbTableCountDto" Items="_overview.Tables" dense="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent><MudTh>Stored data</MudTh><MudTh>Records</MudTh></HeaderContent>
                    <RowTemplate><MudTd DataLabel="Stored data">@FriendlyTableName(context.Table)</MudTd><MudTd DataLabel="Records">@context.Rows</MudTd></RowTemplate>
                </MudTable>
            </div>
        </details>
    </section>

    <section class="maintenance-section" aria-labelledby="common-repairs-heading">
        <MudText Typo="Typo.h6" HtmlTag="h3" id="common-repairs-heading">Fix common problems</MudText>
        <MudText Typo="Typo.body2" Class="text-muted mb-2">These rebuildable caches are the safest place to start.</MudText>
        <div class="repair-grid">
            <article class="repair-card">
                <MudIcon Icon="@Icons.Material.Filled.ImageSearch" Color="Color.Primary" />
                <div><b>Wrong title, poster, or episode count</b><span>Clear metadata so it is fetched again when needed.</span></div>
                <MudButton Variant="Variant.Outlined" Disabled="_busy"
                           OnClick="@(() => Run("Clear metadata caches?", "Cached TMDB metadata and episode lists are deleted and re-fetched on demand. Fixes stale titles, posters, and episode counts.", DbAdmin.ClearMetadataCachesAsync))">Refresh metadata</MudButton>
            </article>
            <article class="repair-card">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary" />
                <div><b>Wrong available or missing status</b><span>Rebuild the index from your live Plex libraries.</span></div>
                <MudButton Variant="Variant.Outlined" Disabled="_busy"
                           OnClick="@(() => Run("Rebuild the availability index?", "The Plex availability index is rebuilt from your live Plex library. Fixes titles wrongly shown as available or missing.", DbAdmin.ClearAndRebuildAvailabilityIndexAsync))">Rebuild availability</MudButton>
            </article>
        </div>
    </section>

    <details class="maintenance-details maintenance-section">
        <summary><span><b>Clear old app records</b><small>History, notifications, resolved issues, and bridge events.</small></span></summary>
        <div class="cleanup-list">
            <div><span><b>Job history</b><small>Recent runs only; schedules and active jobs stay.</small></span><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => Run("Clear job run history?", "Activity → Automation → Recent job history is emptied. Schedules and live jobs are untouched.", DbAdmin.ClearJobHistoryAsync))">Clear</MudButton></div>
            <div><span><b>Notifications</b><small>Every user's in-app notifications.</small></span><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => Run("Clear all notifications?", "Every user's in-app notifications are deleted.", DbAdmin.ClearNotificationsAsync))">Clear</MudButton></div>
            <div><span><b>Closed issues</b><small>Resolved and dismissed reports; open reports stay.</small></span><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => Run("Clear closed issues?", "Resolved and dismissed issue reports are deleted; open ones are kept.", DbAdmin.ClearClosedIssuesAsync))">Clear</MudButton></div>
            <div><span><b>Discord bridge events</b><small>Queued and delivered outbox records.</small></span><MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy" OnClick="@(() => Run("Clear the Discord outbox?", "Queued and delivered Discord bridge events are deleted.", DbAdmin.ClearBridgeOutboxAsync))">Clear</MudButton></div>
        </div>
    </details>

    <section class="danger-zone" aria-labelledby="danger-zone-heading">
        <div class="danger-heading">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
            <div><MudText Typo="Typo.h6" HtmlTag="h3" id="danger-zone-heading" Color="Color.Error">Danger zone</MudText><MudText Typo="Typo.body2" Class="text-muted">Permanent record deletion. Download a backup first.</MudText></div>
        </div>

        <details class="danger-action">
            <summary><span><b>Delete request records</b><small>Remove requests in one status and their download/import history.</small></span></summary>
            <div class="danger-action-content">
                <MudText Typo="Typo.body2" Class="text-muted">Library files are not touched. The default removes only failed requests.</MudText>
                <div class="danger-controls">
                    <MudSelect T="RequestStatus?" @bind-Value="_deleteStatus" Label="Requests to delete" Dense="true" Variant="Variant.Outlined">
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Failed)">Failed</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Cancelled)">Cancelled</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Rejected)">Rejected</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Searching)">Searching</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Pending)">Pending</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.Available)">Available</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)RequestStatus.PartiallyAvailable)">Partially available</MudSelectItem>
                        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)null)">All requests</MudSelectItem>
                    </MudSelect>
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" Disabled="_busy" OnClick="DeleteRequests">Delete selected requests</MudButton>
                </div>
            </div>
        </details>

        <details class="danger-action critical">
            <summary><span><b>Factory reset Plex Requests</b><small>Erase requests, jobs, caches, and settings; keep library files.</small></span></summary>
            <div class="danger-action-content">
                <MudText Typo="Typo.body2" Class="text-muted">
                    The database is emptied and compacted. Default settings, schedules, and built-in indexers reappear after restart.
                </MudText>
                <div class="danger-controls">
                    <MudSwitch T="bool" @bind-Value="_keepUsers" Color="Color.Primary" Label="Keep user accounts" />
                    <MudTextField T="string" @bind-Value="_resetConfirm" Immediate="true" Label="Type RESET" Variant="Variant.Outlined" />
                    <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.DeleteForever"
                               Disabled="@(_busy || _resetConfirm != "RESET")" OnClick="FactoryReset">Factory reset</MudButton>
                </div>
            </div>
        </details>
    </section>
}

@code {
    private DbOverviewDto? _overview;
    private bool _busy;
    private RequestStatus? _deleteStatus = RequestStatus.Failed;
    private bool _keepUsers = true;
    private string _resetConfirm = string.Empty;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        try { _overview = await DbAdmin.GetOverviewAsync(); }
        catch (Exception ex) { await Toast.ShowErrorAsync($"Could not load database overview: {ex.Message}"); }
        StateHasChanged();
    }

    // Confirm → run → report rows removed → refresh counts. Shared by every targeted-cleanup button.
    private async Task Run(string title, string message, Func<Task<int>> action)
    {
        var ok = await Dialog.ShowMessageBox(title, message, yesText: "Do it", cancelText: "Cancel");
        if (ok != true) return;
        _busy = true; StateHasChanged();
        try
        {
            var rows = await action();
            await Toast.ShowSuccessAsync($"Done — {rows} row(s) removed.");
        }
        catch (Exception ex) { await Toast.ShowErrorAsync($"Failed: {ex.Message}"); }
        finally { _busy = false; await Load(); }
    }

    private async Task Compact()
    {
        _busy = true; StateHasChanged();
        try { await DbAdmin.CompactAsync(); await Toast.ShowSuccessAsync("Database compacted."); }
        catch (Exception ex) { await Toast.ShowErrorAsync($"Compact failed: {ex.Message}"); }
        finally { _busy = false; await Load(); }
    }

    private async Task DeleteRequests()
    {
        var scope = _deleteStatus is null ? "ALL requests" : $"all {_deleteStatus} requests";
        var ok = await Dialog.ShowMessageBox("Delete requests?",
            $"This permanently deletes {scope} plus their download jobs and import history from the database. Library files on disk are not touched.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        _busy = true; StateHasChanged();
        try
        {
            var rows = await DbAdmin.DeleteRequestsAsync(_deleteStatus);
            await Toast.ShowSuccessAsync($"Deleted {rows} request(s).");
        }
        catch (Exception ex) { await Toast.ShowErrorAsync($"Delete failed: {ex.Message}"); }
        finally { _busy = false; await Load(); }
    }

    private async Task FactoryReset()
    {
        var ok = await Dialog.ShowMessageBox("Factory reset the database?",
            $"Every table is emptied{(_keepUsers ? " except user accounts" : ", including user accounts")}. This cannot be undone without a backup.",
            yesText: "Reset everything", cancelText: "Cancel");
        if (ok != true) return;
        _busy = true; StateHasChanged();
        try
        {
            await DbAdmin.FactoryResetAsync(_keepUsers);
            _resetConfirm = string.Empty;
            await Toast.ShowSuccessAsync("Database reset. Restart the containers to re-seed background schedules.");
        }
        catch (Exception ex) { await Toast.ShowErrorAsync($"Reset failed: {ex.Message}"); }
        finally { _busy = false; await Load(); }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 * 1024 => $"{bytes / 1024.0 / 1024 / 1024:0.##} GB",
        >= 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.##} MB",
        >= 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes} B"
    };

    private static string FriendlyTableName(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
}
