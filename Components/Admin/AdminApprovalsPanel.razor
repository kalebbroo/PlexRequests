@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Abstractions.IMediaRequestService MediaRequestService
@inject PlexRequestsHosted.Services.Abstractions.IToastService ToastService
@inject PlexRequestsHosted.Services.Abstractions.INotificationBroker Broker
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthProvider
@implements IDisposable

<div class="triage-heading">
    <div>
        <MudText Typo="Typo.h6" HtmlTag="h3">Requests needing a decision</MudText>
        <MudText Typo="Typo.body2" Class="text-secondary">
            New requests appear here first. Approve one to start searching, or deny it with a reason the requester can understand.
        </MudText>
    </div>
    <MudTooltip Text="Refresh requests">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Disabled="@_loading"
                       OnClick="Refresh" aria-label="Refresh requests" />
    </MudTooltip>
</div>

<div class="triage-filters">
    <MudSelect T="RequestStatus?" Value="_statusFilter" ValueChanged="OnStatusChanged"
               Label="Show" Variant="Variant.Outlined">
        <MudSelectItem T="RequestStatus?" Value="@((RequestStatus?)null)">All requests</MudSelectItem>
        <MudSelectItem T="RequestStatus?" Value="@(RequestStatus.Pending)">Needs approval</MudSelectItem>
        <MudSelectItem T="RequestStatus?" Value="@(RequestStatus.Approved)">Approved</MudSelectItem>
        <MudSelectItem T="RequestStatus?" Value="@(RequestStatus.Available)">Available</MudSelectItem>
        <MudSelectItem T="RequestStatus?" Value="@(RequestStatus.Rejected)">Denied</MudSelectItem>
        <MudSelectItem T="RequestStatus?" Value="@(RequestStatus.Cancelled)">Cancelled</MudSelectItem>
    </MudSelect>
    <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Find a request"
                  Placeholder="Title" Variant="Variant.Outlined" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                  DebounceInterval="250" />
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_items.Count == 0)
{
    <div class="triage-empty">
        <MudIcon Icon="@(_statusFilter == RequestStatus.Pending ? Icons.Material.Filled.TaskAlt : Icons.Material.Filled.SearchOff)"
                 Color="@(_statusFilter == RequestStatus.Pending ? Color.Success : Color.Default)" />
        <strong>@EmptyTitle</strong>
        <span>@EmptyDescription</span>
    </div>
}
else
{
    <MudTable Items="_items" Hover="true" Breakpoint="Breakpoint.Md" Class="request-table">
        <HeaderContent>
            <MudTh>Request</MudTh>
            <MudTh>Requested by</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Requested</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Request">
                <div class="request-identity">
                    <img src="@(context.PosterUrl ?? "/img/poster-placeholder.svg")" alt="" loading="lazy"
                         onerror="this.onerror=null;this.src='/img/poster-placeholder.svg'" />
                    <div>
                        <strong>@context.Title</strong>
                        <span>@MediaTypeLabel(context.MediaType)@RequestScope(context)</span>
                        @if (!string.IsNullOrWhiteSpace(context.QualityProfileName))
                        {
                            <small>@context.QualityProfileName</small>
                        }
                    </div>
                </div>
            </MudTd>
            <MudTd DataLabel="Requested by">
                <strong>@context.RequestedByUsername</strong>
                @if (!string.IsNullOrWhiteSpace(context.RequestNote))
                {
                    <MudTooltip Text="@context.RequestNote">
                        <span class="request-note"><MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" /> Note</span>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                @RenderStatusChip(context.Status)
            </MudTd>
            <MudTd DataLabel="Requested">@context.RequestedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Actions">
                <div class="request-actions">
                    @if (context.Status is not RequestStatus.Approved and not RequestStatus.Available)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Check" OnClick="() => Approve(context)">Approve</MudButton>
                    }
                    @if (context.Status is not RequestStatus.Rejected and not RequestStatus.Available)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                   OnClick="() => Deny(context)">Deny</MudButton>
                    }
                    @if (context.Status != RequestStatus.Available)
                    {
                        <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                   OnClick="() => MarkAvailable(context)">Already in Plex</MudButton>
                    }
                    else
                    {
                        <span class="no-action">No action needed</span>
                    }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
    @if (_pageCount > 1)
    {
        <div class="triage-pagination">
            <MudPagination Count="@_pageCount" Selected="@_page" SelectedChanged="OnPageChanged" />
        </div>
    }
}

@if (_denyOpen)
{
    <div class="deny-backdrop" role="presentation" @onclick="CloseDeny">
        <section class="deny-dialog" role="dialog" aria-modal="true" aria-labelledby="deny-title" @onclick:stopPropagation>
            <div class="deny-heading">
                <div class="deny-icon"><MudIcon Icon="@Icons.Material.Filled.Block" /></div>
                <div>
                    <MudText Typo="Typo.h6" HtmlTag="h3" id="deny-title">Deny @_denyTarget?.Title</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">The requester will see this explanation.</MudText>
                </div>
            </div>
            <MudTextField @bind-Value="_denyReason" Label="Reason for denying" Placeholder="For example: Already available in Plex"
                          Variant="Variant.Outlined" Lines="3" FullWidth="true" AutoFocus="true" />
            <div class="deny-actions">
                <MudButton Variant="Variant.Text" OnClick="CloseDeny">Cancel</MudButton>
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmDeny">Deny request</MudButton>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private List<MediaRequestDto> _items = new();
    private int _page = 1;
    private int _pageSize = 25;
    private int _pageCount = 1;
    private RequestStatus? _statusFilter = RequestStatus.Pending;
    private string _search = string.Empty;
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private bool _denyOpen = false;
    private MediaRequestDto? _denyTarget;
    private string _denyReason = string.Empty;

    private int _userId;

    private string EmptyTitle => !string.IsNullOrWhiteSpace(_search)
        ? "No matching requests"
        : _statusFilter switch
        {
            RequestStatus.Pending => "Approval queue is clear",
            null => "No requests yet",
            _ => $"No {StatusLabel(_statusFilter).ToLowerInvariant()} requests"
        };

    private string EmptyDescription => _statusFilter == RequestStatus.Pending
        ? "There are no new requests waiting for you."
        : string.IsNullOrWhiteSpace(_search) ? "Try another status to review older requests." : "Try a different title or clear the search.";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst("user_id")?.Value, out _userId);
        // Live updates: new requests are persisted as notifications to admins; refresh on those.
        Broker.Notified += OnNotified;
        await Load();
    }

    private async void OnNotified(PlexRequestsHosted.Shared.DTOs.NotificationDto n)
    {
        if (n.UserId != _userId) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (n.Type == NotificationType.RequestCreated)
                    await ToastService.ShowInfoAsync(n.Message);
                await Load();
            });
        }
        catch { /* component may be disposing */ }
    }

    private async Task Load()
    {
        await _loadGate.WaitAsync();
        try
        {
            _loading = true;
            StateHasChanged();
            var result = await MediaRequestService.GetAdminRequestsAsync(new MediaFilterDto
            {
                RequestStatus = _statusFilter,
                SearchTerm = _search,
                PageNumber = _page,
                PageSize = _pageSize
            });
            _items = result.Items;
            _pageCount = Math.Max(1, result.TotalPages);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            _loadGate.Release();
        }
    }

    private async Task OnPageChanged(int p)
    {
        _page = p;
        await Load();
    }

    private Task Refresh() => Load();

    private async Task OnStatusChanged(RequestStatus? value)
    {
        _statusFilter = value;
        _page = 1;
        await Load();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        _page = 1;
        await Load();
    }

    private async Task Approve(MediaRequestDto r)
    {
        var ok = await MediaRequestService.ApproveRequestAsync(r.Id);
        if (ok)
        {
            await ToastService.ShowSuccessAsync($"Approved: {r.Title}");
            _page = 1;
            await Load();
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to approve");
        }
    }

    private void Deny(MediaRequestDto r)
    {
        _denyTarget = r;
        _denyReason = string.Empty;
        _denyOpen = true;
    }

    private void CloseDeny()
    {
        _denyOpen = false;
        _denyTarget = null;
        _denyReason = string.Empty;
    }

    private async Task ConfirmDeny()
    {
        if (_denyTarget is null) return;
        var ok = await MediaRequestService.DenyRequestAsync(_denyTarget.Id, _denyReason);
        if (ok)
        {
            await ToastService.ShowInfoAsync($"Denied: {_denyTarget.Title}");
            _denyOpen = false;
            _page = 1;
            await Load();
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to deny");
        }
    }

    private async Task MarkAvailable(MediaRequestDto r)
    {
        var ok = await MediaRequestService.MarkAvailableAsync(r.Id);
        if (ok)
        {
            await ToastService.ShowSuccessAsync($"Marked available: {r.Title}");
            _page = 1;
            await Load();
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to mark available");
        }
    }

    private RenderFragment RenderStatusChip(RequestStatus s) => __builder =>
    {
        var (txt, color) = s switch
        {
            RequestStatus.Pending => ("Pending", Color.Warning),
            RequestStatus.Approved => ("Approved", Color.Success),
            RequestStatus.Available => ("Available", Color.Info),
            RequestStatus.Rejected => ("Rejected", Color.Error),
            RequestStatus.Cancelled => ("Cancelled", Color.Secondary),
            _ => (s.ToString(), Color.Default)
        };
        __builder.OpenComponent<MudChip<string>>(0);
        __builder.AddAttribute(1, "Color", color);
        __builder.AddAttribute(2, "Variant", Variant.Outlined);
        __builder.AddAttribute(3, "ChildContent", (RenderFragment)((b2) => b2.AddContent(0, txt)));
        __builder.CloseComponent();
    };

    private static string MediaTypeLabel(MediaType type) => type switch
    {
        MediaType.Movie => "Movie",
        MediaType.TvShow => "TV show",
        _ => type.ToString()
    };

    private static string RequestScope(MediaRequestDto request)
    {
        if (request.MediaType != MediaType.TvShow) return string.Empty;
        if (request.RequestAllSeasons) return " · All seasons";
        if (request.RequestedSeasons.Count > 0)
            return $" · Season{(request.RequestedSeasons.Count == 1 ? "" : "s")} {string.Join(", ", request.RequestedSeasons)}";
        if (!string.IsNullOrWhiteSpace(request.RequestedEpisodesCsv)) return $" · {request.RequestedEpisodesCsv}";
        return string.Empty;
    }

    private static string StatusLabel(RequestStatus? status) => status switch
    {
        null => "All",
        RequestStatus.Pending => "Pending",
        RequestStatus.Rejected => "Denied",
        _ => status.Value.ToString()
    };

    public void Dispose() => Broker.Notified -= OnNotified;
}
