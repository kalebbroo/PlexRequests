@using PlexRequestsHosted.Shared.DTOs
@inject PlexRequestsHosted.Services.Abstractions.IIndexerAdminService Indexers
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast
@inject IDialogService Dialogs

<div class="d-flex justify-content-end align-items-center mb-2">
    <div class="d-flex gap-2">
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => OpenDialog(null)">Add indexer</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Load" Disabled="_loading">Refresh</MudButton>
    </div>
</div>
<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4">
    The sources the downloader searches. Add a Torznab endpoint (Jackett or Prowlarr) to search every
    tracker configured there — that is the practical way to get coverage the built-in public sources can't
    match. Toggle a source off to skip it; priority (1 = highest) gives its releases a small ranking edge
    when candidates are otherwise comparable. Health columns update each time the downloader searches —
    a failure streak usually means the site is down or blocking.
</MudText>

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <MudTable T="IndexerSettingDto" Items="_items" dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Indexer</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Enabled</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>Last search</MudTh>
                <MudTh>Last results</MudTh>
                <MudTh>Fail streak</MudTh>
                <MudTh>Latency</MudTh>
                <MudTh>Totals</MudTh>
                <MudTh>Status</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Indexer">
                    <b>@context.Name</b>
                    @if (!string.IsNullOrWhiteSpace(context.Url))
                    {
                        <div class="text-muted small">@context.Url</div>
                    }
                </MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsBuiltIn ? Color.Default : Color.Info)">
                        @(context.IsBuiltIn ? "Built-in" : context.Implementation)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Enabled">
                    <MudSwitch T="bool" Color="Color.Primary" Value="@context.Enabled"
                               ValueChanged="@(v => SetEnabled(context, v))" />
                </MudTd>
                <MudTd DataLabel="Priority">
                    <MudNumericField T="int" Value="@context.Priority" Min="1" Max="50" dense="true"
                                     Variant="Variant.Outlined" Style="max-width:90px;"
                                     ValueChanged="@(v => SetPriority(context, v))" />
                </MudTd>
                <MudTd DataLabel="Last search">@Relative(context.LastSearchAt)</MudTd>
                <MudTd DataLabel="Last results">@(context.LastSearchAt is null ? "—" : context.LastResultCount.ToString())</MudTd>
                <MudTd DataLabel="Fail streak">
                    @if (context.ConsecutiveFailures > 0)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">@context.ConsecutiveFailures</MudChip>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </MudTd>
                <MudTd DataLabel="Latency">@(context.LastSearchAt is null ? "—" : $"{context.LastLatencyMs} ms")</MudTd>
                <MudTd DataLabel="Totals">@context.TotalResults results / @context.TotalSearches searches</MudTd>
                <MudTd DataLabel="Status">
                    @if (!context.Enabled)
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">disabled</MudChip>
                    }
                    else if (context.LastSearchAt is null)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">no searches yet</MudChip>
                    }
                    @* A block gets its own state ahead of the generic failure. It used to be invisible: the
                       provider swallowed the 403 and reported "success, 0 results", so 1337x and ext.to sat
                       green through 13 searches apiece while contributing nothing. Blocked is not quiet. *@
                    else if (context.LastBlockReason != IndexerBlockReason.None)
                    {
                        <MudTooltip Text="@BlockHelp(context)">
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Block">
                                @BlockLabel(context.LastBlockReason)
                            </MudChip>
                        </MudTooltip>
                    }
                    else if (context.ConsecutiveFailures > 0 && !string.IsNullOrWhiteSpace(context.LastError))
                    {
                        <MudTooltip Text="@context.LastError">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">failing</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">ok</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => OpenDialog(context)" />
                        <MudTooltip Text="@(context.IsBuiltIn ? "Built-in indexers can only be disabled." : "Delete this indexer.")">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="context.IsBuiltIn" OnClick="() => Delete(context)" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
    <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2">
        Torznab endpoints are managed here — add as many as you like, each with its own categories, priority
        and health. Any left configured in the downloader's environment are imported automatically on its next
        start; you can remove the <code>Indexer__Torznab__*</code> variables afterwards. Built-in public
        sources can be disabled or re-prioritised but not deleted.
    </MudText>
}

@code {
    private static string BlockLabel(IndexerBlockReason reason) => reason switch
    {
        IndexerBlockReason.CloudflareChallenge => "Cloudflare",
        IndexerBlockReason.IpBanned => "IP banned",
        IndexerBlockReason.RateLimited => "rate limited",
        IndexerBlockReason.Forbidden => "forbidden",
        _ => "blocked"
    };

    /// <summary>Each block has a different remedy — say which, rather than just naming the symptom.</summary>
    private static string BlockHelp(IndexerSettingDto i) => i.LastBlockReason switch
    {
        IndexerBlockReason.CloudflareChallenge =>
            "The site served a Cloudflare interstitial instead of results, so this indexer is contributing nothing. "
            + (i.Implementation.Equals("1337x", StringComparison.OrdinalIgnoreCase)
                ? "Edit 1337x and open its persistent downloader browser to complete the check."
                : "Edit the indexer to refresh its browser clearance."),
        IndexerBlockReason.IpBanned =>
            "The site has banned this exit IP outright (Cloudflare error 1020). A clearance cookie won't help — "
            + "this needs a different egress.",
        IndexerBlockReason.RateLimited =>
            "The site is asking us to slow down. Lower this indexer's requests/min.",
        IndexerBlockReason.Forbidden =>
            "The site returned 403 with no challenge — usually missing or rejected credentials.",
        _ => i.LastError ?? "Blocked."
    };

    private bool _loading = true;
    private List<IndexerSettingDto> _items = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try { _items = await Indexers.GetAllAsync(); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task SetEnabled(IndexerSettingDto row, bool enabled)
    {
        row.Enabled = enabled;
        if (await Indexers.SetEnabledAsync(row.Name, enabled))
            await Toast.ShowSuccessAsync($"{row.Name} {(enabled ? "enabled" : "disabled")}.");
        else
            await Toast.ShowErrorAsync("Update failed.");
    }

    private async Task SetPriority(IndexerSettingDto row, int priority)
    {
        row.Priority = priority;
        if (!await Indexers.SetPriorityAsync(row.Name, priority))
            await Toast.ShowErrorAsync("Update failed.");
    }

    private static string Relative(DateTime? utc)
    {
        if (utc is null) return "never";
        var span = DateTime.UtcNow - utc.Value;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
    private async Task OpenDialog(IndexerSettingDto? existing)
    {
        var parameters = new DialogParameters<IndexerDialog> { { x => x.Existing, existing } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await Dialogs.ShowAsync<IndexerDialog>(existing is null ? "Add indexer" : $"Edit {existing.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task Delete(IndexerSettingDto item)
    {
        var (ok, error) = await Indexers.DeleteAsync(item.Id);
        if (ok) await Toast.ShowSuccessAsync($"Deleted {item.Name}.");
        else await Toast.ShowErrorAsync(error ?? "Could not delete this indexer.");
        await Load();
    }

}
