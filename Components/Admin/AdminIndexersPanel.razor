@using PlexRequestsHosted.Shared.DTOs
@inject PlexRequestsHosted.Services.Abstractions.IIndexerAdminService Indexers
@inject PlexRequestsHosted.Services.Abstractions.IReleaseCatalogService Catalog
@inject PlexRequestsHosted.Services.Abstractions.IFirefoxCaptureService FirefoxCapture
@inject PlexRequestsHosted.Services.Implementations.IDownloadPreferencesService DownloadPreferences
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast
@inject IDialogService Dialogs

<MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-4">
    Built-in release sources need no API keys. Leave at least one enabled, then add a private or Torznab-compatible
    indexer only if you already use one through an app such as Prowlarr or Jackett.
</MudAlert>

<AdminDirectAcquisitionSourcesPanel />

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <div class="source-section-heading">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <MudText Typo="Typo.h6">Release indexers</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@EnabledCount of @_items.Count enabled</MudChip>
            </div>
            <MudText Typo="Typo.body2" Class="text-muted">
                Sites that provide torrent or Usenet candidates. Turn off any source you do not want searched.
            </MudText>
        </div>
        <div class="source-section-actions">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenDialog(null)">Add indexer</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="Load" Disabled="_loading"
                           aria-label="Refresh source status" />
        </div>
    </div>

    <div class="source-table-shell">
      <MudPaper Class="pa-2" Elevation="1">
        <MudTable T="IndexerSettingDto" Items="_items" dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Source</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Use source</MudTh>
                <MudTh>Setup</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var coverage = Coverage(context); }
                <MudTd DataLabel="Source">
                    <b>@context.Name</b>
                    @if (!context.IsBuiltIn && !string.IsNullOrWhiteSpace(context.Url))
                    {
                        <div class="text-muted small">@context.Url</div>
                    }
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsBuiltIn ? Color.Default : Color.Info)">
                            @(context.IsBuiltIn ? "Public source" : "Connected API")
                        </MudChip>
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (!context.Enabled)
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Off</MudChip>
                    }
                    else if (IsFirefoxIndexer(context))
                    {
                        <MudTooltip Text="@FirefoxHealthHelp(context, coverage)">
                            <MudChip T="string" Color="@FirefoxHealthColor(context)" Size="Size.Small"
                                     Icon="@FirefoxHealthIcon(context)">
                                @FirefoxStatusLabel(context)
                            </MudChip>
                        </MudTooltip>
                        <div class="text-muted small mt-1">
                            Last capture @Relative(LastFirefoxCapture(context) ?? coverage.LastSeenAt) · @FirefoxActivity(context)
                        </div>
                    }
                    else if (context.LastSearchAt is null)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">Awaiting first search</MudChip>
                        <div class="text-muted small mt-1">Health is checked when this source is first used.</div>
                    }
                    else if (context.LastBlockReason != IndexerBlockReason.None)
                    {
                        <MudTooltip Text="@BlockHelp(context)">
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Block">
                                @BlockLabel(context.LastBlockReason)
                            </MudChip>
                        </MudTooltip>
                    }
                    else if (context.ConsecutiveFailures > 0 && !string.IsNullOrWhiteSpace(context.LastError))
                    {
                        <MudTooltip Text="@context.LastError">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">failing</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Healthy</MudChip>
                        <div class="text-muted small mt-1">
                            Searched @Relative(context.LastSearchAt) · @context.LastResultCount results last time
                        </div>
                    }
                    @if (_catalog is { Enabled: true } && coverage.Sightings > 0)
                    {
                        <div class="text-muted small mt-1">
                            @coverage.Sightings catalog @(coverage.BrowserCapture ? "captures" : "sightings")
                            @if (coverage.Pending > 0) { <span> · @coverage.Pending awaiting detail</span> }
                        </div>
                    }
                </MudTd>
                <MudTd DataLabel="Use source">
                    <MudSwitch T="bool" Color="Color.Primary" Value="@context.Enabled"
                               ValueChanged="@(v => SetEnabled(context, v))"
                               aria-label="@($"Use {context.Name}")" />
                </MudTd>
                <MudTd DataLabel="Setup">
                    <div class="source-row-actions">
                        @if (IsFirefoxIndexer(context))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Extension"
                                       OnClick="() => OpenFirefoxCapture(context)">
                                @(FirefoxHealthState(context) == FirefoxCaptureHealthState.NotPaired ? "Pair Firefox" : "Firefox")
                            </MudButton>
                        }
                        <MudTooltip Text="Review categories, search behavior, and advanced limits.">
                            <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small"
                                           aria-label="@($"Settings for {context.Name}")" OnClick="() => OpenDialog(context)" />
                        </MudTooltip>
                        @if (!context.IsBuiltIn)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           aria-label="@($"Delete {context.Name}")" OnClick="() => Delete(context)" />
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
      </MudPaper>
    </div>
    <MudText Typo="Typo.caption" Class="text-muted mt-2 d-block">
        Source settings contain media categories, search behavior, priority, and rate limits. Built-in sources can be
        adjusted or turned off but cannot be deleted.
    </MudText>

    <div class="optional-source-tools">
        <MudText Typo="Typo.subtitle2">Optional tools</MudText>
        @if (_catalog is { Enabled: true })
        {
            <MudExpansionPanel Text="@($"Local release catalog · {CatalogMode(_catalog)}")" Class="mt-2">
                <MudText Typo="Typo.body2" Class="text-muted mb-3">@CatalogModeHelp(_catalog)</MudText>
                <div class="catalog-summary">
                    <div class="d-flex flex-wrap gap-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_catalog.Releases releases</MudChip>
                        <MudChip T="string" Size="Size.Small">@_catalog.Sightings sightings</MudChip>
                        @if (_catalog.UnresolvedSightings > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_catalog.UnresolvedSightings awaiting detail</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small">@FormatBytes(_catalog.DatabaseSizeBytes)</MudChip>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="@(_catalog.Releases == 0)"
                               OnClick="OpenCatalogExplorer">Browse catalog</MudButton>
                </div>
                <div class="d-flex flex-wrap gap-4 align-items-center mt-3">
                    <MudSwitch T="bool" Value="@(_preferences?.UseCatalogForSearch ?? false)"
                               ValueChanged="SetCatalogSearch" Color="Color.Primary"
                               Disabled="@(_savingCatalog || _catalog.Releases == 0)"
                               Label="Help fulfillment searches" />
                    <MudSwitch T="bool" Value="@(_preferences?.UseCatalogForMonitoring ?? false)"
                               ValueChanged="SetCatalogMonitoring" Color="Color.Primary"
                               Disabled="@(_savingCatalog || _catalog.Releases == 0)"
                               Label="Help new-episode monitoring" />
                </div>
                <MudText Typo="Typo.caption" Class="text-muted">
                    The local catalog supplements live sources and falls back to them if unavailable. Changes reach the downloader within two minutes.
                </MudText>
                @if (_catalog.Sources.Any(source => source.Sightings > 0))
                {
                    <MudStack Row="true" Spacing="1" Class="mt-3 flex-wrap">
                        @foreach (var source in _catalog.Sources.Where(source => source.Sightings > 0))
                        {
                            <MudTooltip Text="@CatalogSourceHelp(source)">
                                <MudChip T="string" Size="Size.Small" Color="@CatalogSourceColor(source)">
                                    @source.Source · @source.Sightings
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudExpansionPanel>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="text-muted d-block mt-1">
                The local release catalog is not enabled on this server. Nothing needs attention; live searches work normally.
            </MudText>
        }
    </div>
}

@code {
    private static string BlockLabel(IndexerBlockReason reason) => reason switch
    {
        IndexerBlockReason.CloudflareChallenge => "Cloudflare",
        IndexerBlockReason.IpBanned => "IP banned",
        IndexerBlockReason.RateLimited => "rate limited",
        IndexerBlockReason.Forbidden => "forbidden",
        _ => "blocked"
    };

    /// <summary>Each block has a different remedy — say which, rather than just naming the symptom.</summary>
    private static string BlockHelp(IndexerSettingDto i) => i.LastBlockReason switch
    {
        IndexerBlockReason.CloudflareChallenge =>
            "The site served a Cloudflare interstitial instead of results. Plex Requests records the block and "
            + $"backs off until {i.SearchCircuitOpenUntil?.ToLocalTime():g}; use another enabled provider or a Torznab-compatible source while it is unavailable.",
        IndexerBlockReason.IpBanned =>
            "The site has banned this exit IP outright (Cloudflare error 1020). A clearance cookie won't help — "
            + "this needs a different egress.",
        IndexerBlockReason.RateLimited =>
            "The site is asking us to slow down. Lower this indexer's requests/min.",
        IndexerBlockReason.Forbidden =>
            "The site returned 403 with no challenge — usually missing or rejected credentials.",
        _ => i.LastError ?? "Blocked."
    };

    private bool _loading = true;
    private List<IndexerSettingDto> _items = new();
    private CatalogStatsDto? _catalog;
    private DownloadPreferencesDto? _preferences;
    private bool _savingCatalog;
    private Dictionary<int, FirefoxCaptureAdminStatusDto> _firefoxStatuses = new();
    private int EnabledCount => _items.Count(item => item.Enabled);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true; StateHasChanged();
        try
        {
            _items = await Indexers.GetAllAsync();
            _catalog = await Catalog.GetStatsAsync(CancellationToken.None);
            _preferences = await DownloadPreferences.GetAsync();
            _catalog.UseForSearch = _preferences.UseCatalogForSearch;
            _catalog.UseForMonitoring = _preferences.UseCatalogForMonitoring;
            _firefoxStatuses = new();
            foreach (var firefoxIndexer in _items.Where(IsFirefoxIndexer))
                _firefoxStatuses[firefoxIndexer.Id] = await FirefoxCapture.GetAdminStatusAsync(
                    firefoxIndexer.Id, CancellationToken.None);
        }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task SetEnabled(IndexerSettingDto row, bool enabled)
    {
        row.Enabled = enabled;
        if (await Indexers.SetEnabledAsync(row.Name, enabled))
            await Toast.ShowSuccessAsync($"{row.Name} {(enabled ? "enabled" : "disabled")}.");
        else
            await Toast.ShowErrorAsync("Update failed.");
    }

    private Task SetCatalogSearch(bool enabled) => SaveCatalogMode(enabled, null);
    private Task SetCatalogMonitoring(bool enabled) => SaveCatalogMode(null, enabled);

    private async Task SaveCatalogMode(bool? search, bool? monitoring)
    {
        if (_preferences is null || _catalog is null) return;
        var oldSearch = _preferences.UseCatalogForSearch;
        var oldMonitoring = _preferences.UseCatalogForMonitoring;
        if (search is bool searchValue) _preferences.UseCatalogForSearch = searchValue;
        if (monitoring is bool monitoringValue) _preferences.UseCatalogForMonitoring = monitoringValue;
        _savingCatalog = true;
        try
        {
            if (await DownloadPreferences.UpdateAsync(_preferences))
            {
                _catalog.UseForSearch = _preferences.UseCatalogForSearch;
                _catalog.UseForMonitoring = _preferences.UseCatalogForMonitoring;
                await Toast.ShowSuccessAsync("Catalog rollout mode updated.");
            }
            else
            {
                _preferences.UseCatalogForSearch = oldSearch;
                _preferences.UseCatalogForMonitoring = oldMonitoring;
                await Toast.ShowErrorAsync("Catalog mode update failed.");
            }
        }
        finally { _savingCatalog = false; StateHasChanged(); }
    }

    private static string Relative(DateTime? utc)
    {
        if (utc is null) return "never";
        var span = DateTime.UtcNow - utc.Value;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private static Color CatalogSourceColor(CatalogSourceStatsDto source) => source.CircuitState switch
    {
        "Open" => Color.Warning,
        "Disabled" => Color.Default,
        _ => Color.Success
    };

    private static string CatalogSourceHelp(CatalogSourceStatsDto source)
    {
        if (source.CircuitState == "Open")
            return $"Circuit open until {source.NextAttemptAt?.ToLocalTime():g}. {source.LastError}";
        return $"Last successful ingestion: {Relative(source.LastSuccessAt)}. "
             + $"Resolved {source.TotalItemsResolved} of {source.TotalItemsSeen} distinct releases.";
    }

    private sealed record IndexerCoverage(long Sightings, long Resolved, DateTime? LastSeenAt, bool BrowserCapture)
    {
        public long Pending => Math.Max(0, Sightings - Resolved);
    }

    private IndexerCoverage Coverage(IndexerSettingDto indexer)
    {
        var sources = (_catalog?.Sources ?? [])
            .Where(source => source.IndexerId == indexer.Id);
        if (IsFirefoxIndexer(indexer))
            sources = sources.Where(source => source.Source.Contains("Firefox", StringComparison.OrdinalIgnoreCase));
        var list = sources.ToList();
        return new IndexerCoverage(
            list.Sum(source => source.Sightings),
            list.Sum(source => source.TotalItemsResolved),
            list.Select(source => source.LastSuccessAt).OrderByDescending(value => value).FirstOrDefault(),
            IsFirefoxIndexer(indexer));
    }

    private static bool IsFirefoxIndexer(IndexerSettingDto indexer) =>
        indexer.Implementation.Equals("1337x", StringComparison.OrdinalIgnoreCase)
        || indexer.Implementation.Equals("ext.to", StringComparison.OrdinalIgnoreCase);

    private FirefoxCaptureAdminStatusDto? FirefoxStatus(IndexerSettingDto indexer) =>
        _firefoxStatuses.GetValueOrDefault(indexer.Id);
    private FirefoxCaptureDeviceDto? FirefoxDevice(IndexerSettingDto indexer) => FirefoxStatus(indexer)?.Devices
        .Where(device => device.IsActive)
        .OrderByDescending(device => device.LastHeartbeatAt ?? device.LastSeenAt ?? device.CreatedAt)
        .FirstOrDefault();
    private DateTime? LastFirefoxCapture(IndexerSettingDto indexer) => FirefoxStatus(indexer)?.Devices
        .OrderByDescending(device => device.LastCaptureAt)
        .FirstOrDefault()?.LastCaptureAt;
    private long FirefoxItems(IndexerSettingDto indexer) => FirefoxStatus(indexer)?.Devices.Sum(device => device.ItemsReceived) ?? 0;
    private long FirefoxBatches(IndexerSettingDto indexer) => FirefoxStatus(indexer)?.Devices.Sum(device => device.BatchesReceived) ?? 0;
    private string FirefoxActivity(IndexerSettingDto indexer)
    {
        var device = FirefoxDevice(indexer);
        if (device?.LastHeartbeatAt is null)
            return $"{FirefoxItems(indexer)} items in {FirefoxBatches(indexer)} batches";
        var queued = device.QueuedUploads + device.PendingDetails;
        var attention = device.FailedUploads + device.AttentionDetails;
        if (attention > 0) return $"{attention} need attention · {queued} queued";
        if (queued > 0) return $"{queued} queued · {FirefoxItems(indexer)} items captured";
        return $"Queue clear · {FirefoxItems(indexer)} items captured";
    }

    private FirefoxCaptureHealthState FirefoxHealthState(IndexerSettingDto indexer) =>
        FirefoxCaptureHealth.State(FirefoxDevice(indexer), DateTime.UtcNow);
    private Color FirefoxHealthColor(IndexerSettingDto indexer) => FirefoxCaptureHealth.Color(FirefoxHealthState(indexer));
    private string FirefoxHealthIcon(IndexerSettingDto indexer) => FirefoxCaptureHealth.Icon(FirefoxHealthState(indexer));
    private string FirefoxHealthLabel(IndexerSettingDto indexer) =>
        FirefoxCaptureHealth.Label(FirefoxHealthState(indexer));
    private string FirefoxStatusLabel(IndexerSettingDto indexer) =>
        FirefoxHealthState(indexer) == FirefoxCaptureHealthState.NotPaired ? "Needs setup" : FirefoxHealthLabel(indexer);
    private string FirefoxHealthHelp(IndexerSettingDto indexer, IndexerCoverage coverage)
    {
        var device = FirefoxDevice(indexer);
        if (device is null)
            return $"No active Firefox profile is paired. Open Firefox capture and pair the browser used for {indexer.Name}.";
        if (device.LastHeartbeatAt is null)
            return $"Firefox {device.ExtensionVersion} predates queue health reporting; the server is distributing "
                 + $"{FirefoxStatus(indexer)?.CurrentExtensionVersion}. Update it in place to preserve pairing data.";
        if (device.UpdateAvailable)
            return $"Firefox {device.ExtensionVersion} is outdated; the server is distributing "
                 + $"{FirefoxStatus(indexer)?.CurrentExtensionVersion}. Update it in place to preserve pairings and queued work.";
        return $"Last queue report {Relative(device.LastHeartbeatAt)}. {device.QueuedUploads} uploads and "
             + $"{device.PendingDetails} details queued; {device.FailedUploads + device.AttentionDetails} need attention. "
             + $"Firefox has stored {coverage.Sightings} {indexer.Name} sightings.";
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824d:F1} GB",
        >= 1_048_576 => $"{bytes / 1_048_576d:F1} MB",
        >= 1024 => $"{bytes / 1024d:F1} KB",
        _ => $"{bytes} B"
    };

    private static string CatalogMode(CatalogStatsDto catalog) => catalog switch
    {
        { UseForMonitoring: true, UseForSearch: true } => "search + monitoring active",
        { UseForMonitoring: true } => "monitoring active",
        { UseForSearch: true } => "search assist active",
        _ => "shadow mode"
    };

    private static string CatalogModeHelp(CatalogStatsDto catalog) => catalog switch
    {
        { UseForMonitoring: true } => "New-episode monitoring matches this local catalog instead of repeatedly searching every upstream source.",
        { UseForSearch: true } => "Catalog candidates supplement live fulfillment; upstream sources remain the fallback.",
        _ => "Stores each feed item once for comparison; live fulfillment remains authoritative."
    };
    private async Task OpenDialog(IndexerSettingDto? existing)
    {
        var parameters = new DialogParameters<IndexerDialog> { { x => x.Existing, existing } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await Dialogs.ShowAsync<IndexerDialog>(existing is null ? "Add indexer" : $"Edit {existing.Name}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task OpenFirefoxCapture(IndexerSettingDto indexer)
    {
        var parameters = new DialogParameters<FirefoxCaptureDialog> { { x => x.IndexerId, indexer.Id } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await Dialogs.ShowAsync<FirefoxCaptureDialog>($"Firefox capture · {indexer.Name}", parameters, options);
        await dialog.Result;
        await Load();
    }

    private async Task OpenCatalogExplorer()
    {
        var parameters = new DialogParameters<CatalogExplorerDialog> { { x => x.Indexers, _items } };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        await Dialogs.ShowAsync<CatalogExplorerDialog>("Captured release catalog", parameters, options);
    }

    private async Task Delete(IndexerSettingDto item)
    {
        var (ok, error) = await Indexers.DeleteAsync(item.Id);
        if (ok) await Toast.ShowSuccessAsync($"Deleted {item.Name}.");
        else await Toast.ShowErrorAsync(error ?? "Could not delete this indexer.");
        await Load();
    }

}
