@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Implementations.IMediaIssueService IssueService
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toast

<div class="issues-heading">
    <div>
        <MudText Typo="Typo.h6" HtmlTag="h3">Problems reported by users</MudText>
        <MudText Typo="Typo.body2" Class="text-secondary">
            Each report identifies the affected title, episode, and file when available. Replace only when a new copy is needed.
        </MudText>
    </div>
    <div class="issues-controls">
        <MudSwitch T="bool" Value="_openOnly" Label="Open only" Color="Color.Primary" ValueChanged="OnOpenOnlyChanged" />
        <MudTooltip Text="Refresh reported issues">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Disabled="@_loading"
                           OnClick="Load" aria-label="Refresh reported issues" />
        </MudTooltip>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_issues.Count == 0)
{
    <div class="issues-empty">
        <MudIcon Icon="@(_openOnly ? Icons.Material.Filled.TaskAlt : Icons.Material.Filled.SearchOff)"
                 Color="@(_openOnly ? Color.Success : Color.Default)" />
        <strong>@(_openOnly ? "No open problems" : "No reported problems")</strong>
        <span>@(_openOnly ? "Users have not reported anything that still needs attention." : "Issue reports will appear here when a user reports a playback, quality, or episode problem.")</span>
    </div>
}
else
{
    <div class="issue-list">
        @foreach (var issue in _issues)
        {
            <article class="issue-card">
                <div class="issue-media">
                    <img src="@(issue.PosterUrl ?? "/img/poster-placeholder.svg")" alt="" loading="lazy"
                         onerror="this.onerror=null;this.src='/img/poster-placeholder.svg'" />
                    <div class="issue-title">
                        <MudText Typo="Typo.subtitle1" HtmlTag="h4">@issue.Title</MudText>
                        <span>@MediaLabel(issue)</span>
                        @if (!string.IsNullOrWhiteSpace(issue.EpisodeTitle))
                        {
                            <strong>@issue.EpisodeTitle</strong>
                        }
                    </div>
                </div>

                <div class="issue-status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(issue)">@StatusText(issue)</MudChip>
                    @if (issue.Status == IssueStatus.ReplacementQueued && issue.ReplacementJobStatus.HasValue)
                    {
                        <span>@ReplacementProgress(issue)</span>
                    }
                </div>

                <div class="issue-report">
                    <div class="issue-reason"><MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" /><strong>@issue.Reason</strong></div>
                    @if (!string.IsNullOrWhiteSpace(issue.Detail))
                    {
                        <p>@issue.Detail</p>
                    }
                    else
                    {
                        <p class="text-secondary">No additional details were provided.</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(issue.AffectedReleaseName) || !string.IsNullOrWhiteSpace(issue.AffectedFilePath))
                {
                    <details class="issue-file">
                        <summary>Reported file details</summary>
                        @if (!string.IsNullOrWhiteSpace(issue.AffectedReleaseName))
                        {
                            <div><span>Release</span><strong>@issue.AffectedReleaseName@(issue.AffectedResolution > 0 ? $" · {issue.AffectedResolution}p" : "")</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(issue.AffectedFilePath))
                        {
                            <div><span>Path</span><code>@issue.AffectedFilePath</code></div>
                        }
                    </details>
                }

                <div class="issue-footer">
                    <span><MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Small" />@(issue.ReportedBy ?? "Unknown user")</span>
                    <span><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />@issue.CreatedAt.ToLocalTime().ToString("g")</span>
                    @if (issue.ReplacementRequested && issue.Status == IssueStatus.Open)
                    {
                        <span class="replacement-request"><MudIcon Icon="@Icons.Material.Filled.FindReplace" Size="Size.Small" />User requested a replacement</span>
                    }
                </div>

                @if (issue.Status == IssueStatus.Open)
                {
                    <div class="issue-actions">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.FindReplace" OnClick="() => Redownload(issue)">
                            @(issue.ReplacementRequested ? "Approve replacement" : "Replace file")
                        </MudButton>
                        <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Check" OnClick="() => Resolve(issue)">Mark resolved</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                   OnClick="() => Dismiss(issue)">Dismiss report</MudButton>
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    private bool _loading = true;
    private bool _openOnly = true;
    private List<MediaIssueDto> _issues = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        StateHasChanged();
        try { _issues = await IssueService.GetIssuesAsync(_openOnly); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task OnOpenOnlyChanged(bool v) { _openOnly = v; await Load(); }

    private async Task Redownload(MediaIssueDto i)
    {
        var result = await IssueService.RequestRedownloadAsync(i.Id);
        if (result.Success && result.ReplacementQueued)
        {
            await Toast.ShowSuccessAsync($"Safe replacement queued for {i.Title}.");
            await Load();
        }
        else await Toast.ShowErrorAsync(result.ErrorMessage ?? "Failed to queue replacement.");
    }

    private async Task Resolve(MediaIssueDto i)
    {
        if (await IssueService.ResolveIssueAsync(i.Id)) { await Toast.ShowInfoAsync("Marked resolved."); await Load(); }
    }

    private async Task Dismiss(MediaIssueDto i)
    {
        if (await IssueService.DismissIssueAsync(i.Id)) { await Toast.ShowInfoAsync("Dismissed."); await Load(); }
    }

    private static string StatusText(MediaIssueDto issue) => issue.Status == IssueStatus.ReplacementQueued
        ? issue.ReplacementJobStatus == FulfillmentStatus.Deferred ? "Searching again"
        : issue.ReplacementJobStatus == FulfillmentStatus.Downloading ? "Replacing"
        : "Replacement queued"
        : issue.Status.ToString();

    private static Color StatusColor(MediaIssueDto issue) => issue.Status switch
    {
        IssueStatus.Open => Color.Warning,
        IssueStatus.ReplacementQueued => Color.Info,
        IssueStatus.Resolved => Color.Success,
        _ => Color.Default
    };

    private static string MediaLabel(MediaIssueDto issue)
    {
        var mediaType = issue.MediaType == MediaType.Movie ? "Movie" : issue.MediaType == MediaType.TvShow ? "TV show" : issue.MediaType.ToString();
        if (issue.SeasonNumber is not int season) return mediaType;
        return $"{mediaType} · S{season:D2}{(issue.EpisodeNumber is int episode ? $"E{episode:D2}" : string.Empty)}";
    }

    private static string ReplacementProgress(MediaIssueDto issue) => issue.ReplacementJobStatus switch
    {
        FulfillmentStatus.Downloading => $"{issue.ReplacementProgress}% downloaded",
        FulfillmentStatus.Deferred => issue.ReplacementNextRetryAt is DateTime retry
            ? $"Searching again {retry.ToLocalTime():g}"
            : "Searching again soon",
        _ => issue.ReplacementJobStatus?.ToString() ?? string.Empty
    };
}
