@using PlexRequestsHosted.Services.Abstractions
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@implements IDisposable
@inject IDownloadMonitorService DownloadMonitor

<section class="downloads-section" aria-labelledby="downloads-heading">
    <div class="downloads-heading">
        <div>
            <MudText Typo="Typo.h5" HtmlTag="h3" id="downloads-heading">Downloads</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">From release selection through import, with live transfer health.</MudText>
        </div>
        <div class="downloads-live">
            @if (!_loading) { <span><i></i>Live · @PollSeconds s</span> }
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadAsync" aria-label="Refresh downloads" />
        </div>
    </div>

    @if (_storage is null || DateTime.UtcNow - _storage.ObservedAt.ToUniversalTime() > TimeSpan.FromMinutes(3))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            Waiting for a current storage heartbeat from the downloader. New downloads should not be assumed safe until it reconnects.
        </MudAlert>
    }
    else
    {
        <section class="storage-card @StorageClass(_storage.State)" aria-labelledby="storage-heading">
            <div class="storage-summary">
                <span class="storage-icon"><MudIcon Icon="@StorageIcon(_storage.State)" /></span>
                <div>
                    <MudText Typo="Typo.subtitle1" HtmlTag="h4" id="storage-heading">Storage · @StorageLabel(_storage.State)</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">@_storage.Message</MudText>
                </div>
                <span class="storage-time">Checked @RelativeTime(_storage.ObservedAt)</span>
            </div>
            <div class="storage-volumes">
                @foreach (var volume in _storage.Volumes)
                {
                    var usable = Math.Max(0, volume.FreeBytes - volume.ReservedBytes - volume.MinimumFreeBytes);
                    <div class="storage-volume">
                        <div><strong>@volume.Label</strong><span>@volume.Path</span></div>
                        @if (volume.IsReady)
                        {
                            <div class="storage-meter" role="progressbar" aria-label="@($"{volume.Label} disk usage")"
                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@UsedPercent(volume)">
                                <span style="width:@($"{UsedPercent(volume)}%")"></span>
                            </div>
                            <small>@FmtSize(volume.FreeBytes) free · @FmtSize(volume.ReservedBytes) reserved · @FmtSize(usable) safely available</small>
                        }
                        else
                        {
                            <small class="storage-error">@volume.Error</small>
                        }
                    </div>
                }
            </div>
            <div class="cleanup-summary">
                <span><MudIcon Icon="@Icons.Material.Filled.CleaningServices" Size="Size.Small" /> @_storage.CleanupPendingCount transfer cleanups pending</span>
                <span>@_storage.StaleArtifactCount stale temporary items (@FmtSize(_storage.StaleArtifactBytes))</span>
                @if (_playbackPreparation.InProgressCount > 0 || _playbackPreparation.PendingCount > 0)
                {
                    <span><MudIcon Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" />
                        @_playbackPreparation.InProgressCount preparing · @_playbackPreparation.PendingCount legacy playback files queued</span>
                }
                @if (_playbackPreparation.FailedCount > 0)
                {
                    <span class="playback-repair-error">@_playbackPreparation.FailedCount playback files need attention</span>
                }
                @if (_storage.RemovedArtifactCount > 0)
                {
                    <span>@_storage.RemovedArtifactCount removed on the last pass (@FmtSize(_storage.RemovedArtifactBytes))</span>
                }
            </div>
            @if (_storage.CleanupCandidates.Count > 0)
            {
                <details class="cleanup-candidates">
                    <summary>Cleanup requiring attention</summary>
                    @foreach (var candidate in _storage.CleanupCandidates)
                    {
                        <div><strong>@candidate.Kind · @FmtSize(candidate.SizeBytes)</strong><span>@candidate.Reason</span><code>@candidate.Path</code></div>
                    }
                </details>
            }
        </section>
    }

    @if (_loading && _jobs.Count == 0)
    {
        <div class="downloads-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="downloads-empty"><MudIcon Icon="@Icons.Material.Filled.DownloadDone" /><strong>Nothing transferring</strong><span>Active and recently completed downloads will appear here.</span></div>
    }
    else
    {
        <div class="download-list">
            @foreach (var job in _jobs)
            {
                <article @key="job.JobId" class="download-card">
                    <div class="download-poster">
                        <img src="@(string.IsNullOrWhiteSpace(job.PosterUrl) ? "/img/poster-placeholder.svg" : job.PosterUrl)" alt="" loading="lazy" onerror="this.src='/img/poster-placeholder.svg'" />
                        <span><MudIcon Icon="@(job.MediaType == MediaType.TvShow ? Icons.Material.Filled.Tv : Icons.Material.Filled.Movie)" Size="Size.Small" /></span>
                    </div>
                    <div class="download-body">
                        <div class="download-title-row">
                            <div>
                                <span class="stage-pill @StageClass(job)">@job.Stage</span>
                                @if (job.IsStorageOptimization)
                                {
                                    <span class="optimization-pill"><MudIcon Icon="@Icons.Material.Filled.Compress" Size="Size.Small" /> Storage optimization</span>
                                }
                                <MudText Typo="Typo.subtitle1" HtmlTag="h4">@job.Title@(job.Year is int y ? $" ({y})" : "")</MudText>
                                <div class="download-requester">
                                    @if (!string.IsNullOrWhiteSpace(job.RequestedBy)) { <span>Requested by @job.RequestedBy</span> }
                                    @if (job.Attempts > 1) { <span>Attempt @job.Attempts</span> }
                                    @if (job.UpdatedAt is DateTime updated) { <span>Updated @RelativeTime(updated)</span> }
                                </div>
                            </div>
                            <strong class="download-percent">@job.Progress%</strong>
                        </div>

                        <div class="download-progress" role="progressbar" aria-label="@job.Title download progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@job.Progress">
                            <span class="@StageClass(job)" style="width:@($"{job.Progress}%")"></span>
                        </div>

                        @if (job.IsStorageOptimization)
                        {
                            <div class="optimization-summary">
                                <div>
                                    <span>Scope</span>
                                    <strong>@OptimizationScope(job)</strong>
                                </div>
                                <div class="optimization-goals">
                                    <span>Required result</span>
                                    <p>@string.Join(" + ", job.OptimizationGoals)</p>
                                </div>
                                @if (job.OptimizationOriginalBytes is long original)
                                {
                                    <div>
                                        <span>Storage</span>
                                        <strong>@OptimizationStorage(job, original)</strong>
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(job.LastError)
                            && job.Status is FulfillmentStatus.Failed or FulfillmentStatus.PartiallyCompleted
                                or FulfillmentStatus.Deferred or FulfillmentStatus.Cancelled)
                        {
                            <MudAlert Severity="@(job.Status == FulfillmentStatus.Failed ? Severity.Error : Severity.Warning)" dense="true" Class="download-alert">
                                <b>@(job.Status == FulfillmentStatus.Deferred ? "Last search: " : string.Empty)</b>@job.LastError
                            </MudAlert>
                        }

                        @if (job.Transfers.Count > 0)
                        {
                            <div class="transfer-stats">
                                <div><MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" /><span>Speed</span><strong>@Rate(job.Transfers.Sum(t => t.DownloadRateBytesPerSec))</strong></div>
                                <div><MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" /><span>Size</span><strong>@FmtSize(job.Transfers.Sum(t => t.TotalSizeBytes))</strong></div>
                                <div><MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Small" /><span>Peers</span><strong>@job.Transfers.Where(t => t.Protocol == AcquisitionProtocol.Torrent).Sum(t => t.Seeds) / @job.Transfers.Where(t => t.Protocol == AcquisitionProtocol.Torrent).Sum(t => t.Peers)</strong></div>
                                <div><MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" /><span>ETA</span><strong>@Eta(JobEta(job))</strong></div>
                            </div>

                            <details class="release-details">
                                <summary><span><MudIcon Icon="@Icons.Material.Filled.Subject" Size="Size.Small" />Release details</span><span>@job.Transfers.Count @Plural(job.Transfers.Count, "transfer", "transfers")</span></summary>
                                <div class="release-table-wrap">
                                    <table>
                                        <thead><tr><th>Release</th><th>Source</th><th>Stage</th><th>Progress</th><th>Transfer</th><th>Health</th></tr></thead>
                                        <tbody>
                                            @foreach (var transfer in job.Transfers)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (transfer.Season is int season && transfer.Episode is int episode) { <span class="episode-tag">S@(season.ToString("00"))E@(episode.ToString("00"))</span> }
                                                        <span class="release-name">@transfer.Name</span>
                                                    </td>
                                                    <td>@(string.IsNullOrWhiteSpace(transfer.Source) ? transfer.Protocol.ToString() : transfer.Source)<small>@transfer.Protocol</small></td>
                                                    <td><span class="torrent-stage @TransferStageClass(transfer.Stage)">@TransferStageLabel(transfer.Stage)</span></td>
                                                    <td>@transfer.ProgressPercent.ToString("0.0")%</td>
                                                    <td>@Rate(transfer.DownloadRateBytesPerSec)<small>@Eta(transfer.EtaSeconds)</small></td>
                                                    <td>@if (transfer.Protocol == AcquisitionProtocol.Torrent) { <text>@transfer.Seeds seeds<small>@transfer.Peers peers</small></text> } else { <text>—</text> }</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private const int PollSeconds = 5;
    private List<DownloadJobView> _jobs = new();
    private StorageStatusDto? _storage;
    private PlaybackPreparationStatusDto _playbackPreparation = new();
    private bool _loading = true;
    private bool _loadInProgress;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(PollSeconds));
        _ = PollLoopAsync(_cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(LoadAsync);
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        if (_loadInProgress) return;
        _loadInProgress = true;
        try
        {
            _jobs = await DownloadMonitor.GetActiveAndRecentAsync();
            _playbackPreparation = await DownloadMonitor.GetPlaybackPreparationStatusAsync();
            _storage = DownloadMonitor.GetStorageStatus();
        }
        catch { }
        finally
        {
            _loadInProgress = false;
            _loading = false;
            StateHasChanged();
        }
    }

    private static string StageClass(DownloadJobView job) => job.Status switch
    {
        FulfillmentStatus.Completed => "success",
        FulfillmentStatus.Failed => "error",
        FulfillmentStatus.PartiallyCompleted => "warning",
        FulfillmentStatus.Downloading when job.Transfers.Any(t => t.Stage == DownloadTransferStage.Importing) => "warning",
        FulfillmentStatus.Downloading => "active",
        FulfillmentStatus.Deferred => "waiting",
        _ => "queued"
    };

    private static string TransferStageClass(DownloadTransferStage stage) => stage switch
    {
        DownloadTransferStage.Imported => "success",
        DownloadTransferStage.Importing => "warning",
        DownloadTransferStage.Failed or DownloadTransferStage.Missing => "error",
        DownloadTransferStage.Downloading => "active",
        _ => "queued"
    };

    private static string TransferStageLabel(DownloadTransferStage stage) => stage switch
    {
        DownloadTransferStage.Finishing => "Finishing",
        DownloadTransferStage.Importing => "Moving",
        DownloadTransferStage.Imported => "Imported",
        DownloadTransferStage.Failed => "Failed",
        DownloadTransferStage.Missing => "Missing",
        _ => "Downloading"
    };

    private static long? JobEta(DownloadJobView job)
    {
        var known = job.Transfers.Where(t => t.Stage == DownloadTransferStage.Downloading && t.EtaSeconds is > 0).Select(t => t.EtaSeconds!.Value).ToList();
        return known.Count == 0 ? null : known.Max();
    }

    private static string Rate(double bytesPerSec)
    {
        if (bytesPerSec < 1) return "—";
        string[] units = { "B/s", "KB/s", "MB/s", "GB/s" };
        double value = bytesPerSec;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; }
        return $"{value:0.0} {units[unit]}";
    }

    private static string FmtSize(long bytes)
    {
        if (bytes < 0) return "—";
        if (bytes == 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double value = bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; }
        return $"{value:0.#} {units[unit]}";
    }

    private static int UsedPercent(StorageVolumeStatusDto volume) => volume.TotalBytes <= 0
        ? 0
        : (int)Math.Clamp(Math.Round(100d * (volume.TotalBytes - volume.FreeBytes) / volume.TotalBytes), 0, 100);

    private static string StorageClass(StorageHealthState state) => state.ToString().ToLowerInvariant();
    private static string StorageLabel(StorageHealthState state) => state switch
    {
        StorageHealthState.Healthy => "Ready",
        StorageHealthState.Warning => "Low headroom",
        StorageHealthState.Paused => "New downloads paused",
        _ => "Unavailable"
    };
    private static string StorageIcon(StorageHealthState state) => state switch
    {
        StorageHealthState.Healthy => Icons.Material.Filled.Storage,
        StorageHealthState.Warning => Icons.Material.Filled.WarningAmber,
        StorageHealthState.Paused => Icons.Material.Filled.PauseCircle,
        _ => Icons.Material.Filled.CloudOff
    };

    private static string Eta(long? seconds)
    {
        if (seconds is not > 0) return "—";
        var time = TimeSpan.FromSeconds(seconds.Value);
        if (time.TotalHours >= 1) return $"{(int)time.TotalHours}h {time.Minutes}m";
        if (time.TotalMinutes >= 1) return $"{time.Minutes}m {time.Seconds}s";
        return $"{time.Seconds}s";
    }

    private static string RelativeTime(DateTime value)
    {
        var elapsed = DateTime.UtcNow - value.ToUniversalTime();
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private static string Plural(int count, string singular, string plural) => count == 1 ? singular : plural;

    private static string OptimizationScope(DownloadJobView job)
    {
        var files = $"{job.OptimizationTargetFileCount} {Plural(job.OptimizationTargetFileCount, "file", "files")}";
        if (job.OptimizationSeasons.Count == 0) return files;
        var seasons = string.Join(", ", job.OptimizationSeasons.Select(season => season == 0 ? "Specials" : $"S{season:00}"));
        return $"{files} · {seasons}";
    }

    private static string OptimizationStorage(DownloadJobView job, long original)
    {
        if (job.OptimizationReplacementBytes is not long replacement) return $"{FmtSize(original)} original";
        var difference = original - replacement;
        return difference >= 0
            ? $"{FmtSize(original)} → {FmtSize(replacement)} · {FmtSize(difference)} saved"
            : $"{FmtSize(original)} → {FmtSize(replacement)} · {FmtSize(-difference)} larger";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
