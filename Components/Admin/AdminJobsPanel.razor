@using PlexRequestsHosted.Shared
@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Enums
@inject PlexRequestsHosted.Services.Abstractions.IJobAdminService Jobs
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toasts
@inject IDialogService Dialogs

@* Admin "Jobs" panel: recurring-job schedule, run history, the still-searching "Missing" list, and the
   "Cutoff Unmet" upgrade list. This is a child component — the parent /admin page is already admin-gated,
   so there is no @page or [Authorize] here. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <div class="activity-toolbar">
        <MudText Typo="Typo.body2" Class="text-muted">
            Start with the search queue. Calendar and automation are reference tools unless something needs attention.
        </MudText>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="Reload">Refresh</MudButton>
    </div>

    <div class="activity-tabs-shell">
    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
             SliderColor="Color.Primary" Class="custom-tabs custom-subtabs">

        @* Missing required releases and optional upgrades are one search queue. *@
        <MudTabPanel Text="Search queue" BadgeData="@(QueueCount == 0 ? null : QueueCount)" BadgeColor="Color.Warning">
            <div class="queue-summary">
                <div>
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" />
                    <span><strong>@_missing.Count</strong><small>still missing</small></span>
                </div>
                <div>
                    <MudIcon Icon="@Icons.Material.Filled.HighQuality" />
                    <span><strong>@_cutoff.Count</strong><small>optional upgrades</small></span>
                </div>
            </div>

            @if (QueueCount == 0)
            {
                <div class="activity-empty">
                    <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" />
                    <strong>Search queue is clear</strong>
                    <span>Every request has a release and nothing is waiting for a quality upgrade.</span>
                </div>
            }
            else
            {
                @if (_missing.Count > 0)
                {
                    <div class="activity-section-heading">
                        <div>
                            <MudText Typo="Typo.subtitle1"><b>Still searching</b></MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Approved requests that have not found an acceptable release yet.</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@_missing.Count</MudChip>
                    </div>
                    <MudTable Items="_missing" dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="elevation-1">
                        <HeaderContent>
                            <MudTh>Title</MudTh>
                            <MudTh>Requested by</MudTh>
                            <MudTh>Target</MudTh>
                            <MudTh>Attempts</MudTh>
                            <MudTh>Next search</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Title"><div class="fw-bold">@context.Title @(context.Year is int y ? $"({y})" : "")</div></MudTd>
                            <MudTd DataLabel="Requested by">@context.RequestedBy</MudTd>
                            <MudTd DataLabel="Target">@context.TargetQuality.Label()</MudTd>
                            <MudTd DataLabel="Attempts">@context.DeferCount</MudTd>
                            <MudTd DataLabel="Next search">@FormatWhen(context.NextRetryAt)</MudTd>
                            <MudTd DataLabel="Status">
                                @if (context.Escalated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Needs attention</MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(context.LastError))
                                {
                                    <MudTooltip Text="@context.LastError"><MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" /></MudTooltip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <div class="queue-actions">
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                               OnClick="() => SearchMissing(context)">Search now</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.ManageSearch"
                                               OnClick="() => BrowseReleases(context)">Review results</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                               OnClick="() => GiveUp(context)">Stop searching</MudButton>
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                @if (_cutoff.Count > 0)
                {
                    <div class="activity-section-heading @(_missing.Count > 0 ? "with-divider" : "")">
                        <div>
                            <MudText Typo="Typo.subtitle1"><b>Optional quality upgrades</b></MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Playable media that can still be replaced by a preferred-quality release.</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@_cutoff.Count</MudChip>
                    </div>
                    <MudTable Items="_cutoff" dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="elevation-1">
                        <HeaderContent>
                            <MudTh>Title</MudTh>
                            <MudTh>Requested by</MudTh>
                            <MudTh>Quality</MudTh>
                            <MudTh>Attempts</MudTh>
                            <MudTh>Last searched</MudTh>
                            <MudTh>Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Title"><div class="fw-bold">@context.Title @(context.Year is int y ? $"({y})" : "")</div></MudTd>
                            <MudTd DataLabel="Requested by">@context.RequestedBy</MudTd>
                            <MudTd DataLabel="Quality">@context.HaveQuality.Label() → @context.WantQuality.Label()</MudTd>
                            <MudTd DataLabel="Attempts">@context.UpgradeAttempts</MudTd>
                            <MudTd DataLabel="Last searched">@FormatWhen(context.LastUpgradeSearchAt)</MudTd>
                            <MudTd DataLabel="Action">
                                @if (context.UpgradeInProgress)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.HourglassTop">In progress</MudChip>
                                }
                                else
                                {
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                               OnClick="() => UpgradeNow(context)">Search now</MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            }
        </MudTabPanel>

        @* ---------------- CALENDAR ---------------- *@
        <MudTabPanel Text="Calendar">
            <AdminCalendarPanel />
        </MudTabPanel>

        @* ---------------- BLOCKLIST ---------------- *@
        <MudTabPanel Text="Blocked releases">
            <AdminBlocklistPanel />
        </MudTabPanel>

        @* Schedule and run history are two views of the same background automation. *@
        <MudTabPanel Text="Automation">
            <div class="activity-section-heading">
                <div>
                    <MudText Typo="Typo.subtitle1"><b>Recurring work</b></MudText>
                    <MudText Typo="Typo.caption" Class="text-muted">Background tasks Plex Requests runs automatically.</MudText>
                </div>
            </div>
            @if (_scheduled.Count == 0)
            {
                <div class="activity-empty"><MudIcon Icon="@Icons.Material.Filled.Schedule" /><strong>No recurring work</strong><span>No background tasks are configured.</span></div>
            }
            else
            {
                <div class="automation-table-shell">
                <MudTable Items="_scheduled" dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="elevation-1">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Enabled</MudTh>
                        <MudTh>Runs every</MudTh>
                        <MudTh>Last run</MudTh>
                        <MudTh>Message</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Enabled">
                            <MudSwitch T="bool" Value="context.Enabled" Color="Color.Primary"
                                       ValueChanged="@(v => ToggleEnabled(context, v))"
                                       aria-label="@($"Enable {context.Name}")" />
                        </MudTd>
                        <MudTd DataLabel="Runs every">
                            @* Editable friendly interval picker; common presets mapped to seconds. *@
                            <MudSelect T="int" Value="context.IntervalSeconds" dense="true" Variant="Variant.Outlined"
                                       Style="min-width:140px;" ValueChanged="@(v => ChangeInterval(context, v))">
                                @foreach (var opt in _intervalOptions)
                                {
                                    <MudSelectItem Value="opt.Seconds">@opt.Label</MudSelectItem>
                                }
                                @* Preserve a non-preset saved value so it still displays correctly. *@
                                @if (_intervalOptions.All(o => o.Seconds != context.IntervalSeconds))
                                {
                                    <MudSelectItem Value="context.IntervalSeconds">@($"{context.IntervalSeconds}s")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd DataLabel="Last run">
                            <div class="d-flex align-items-center gap-2">
                                <span>@(context.LastRunAt is DateTime lr ? lr.ToLocalTime().ToString("g") : "—")</span>
                                @if (context.LastStatus is JobRunStatus st)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="StatusColor(st)">@FriendlyStatus(st)</MudChip>
                                }
                                @if (context.LastRunDurationMs > 0)
                                {
                                    <span class="text-muted small">@FormatMs(context.LastRunDurationMs)</span>
                                }
                                @if (context.ConsecutiveFailures > 1)
                                {
                                    <MudTooltip Text="@($"{context.ConsecutiveFailures} consecutive failures")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@($"×{context.ConsecutiveFailures}")</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Message">
                            @if (!string.IsNullOrWhiteSpace(context.LastMessage))
                            {
                                <MudTooltip Text="@context.LastMessage">
                                    <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" />
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Actions">
                            @* A set "running" flag blocks this job type from ever being dispatched again, so
                               when it has outlived the job's own timeout we offer a way out rather than
                               leaving the admin with a permanently spinning row and no recourse. *@
                            @if (context.LooksStuck)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <MudTooltip Text="@($"Marked running since {context.RunningSince?.ToLocalTime():g}, longer than its {context.TimeoutSeconds}s limit. Usually means the app restarted mid-run.")">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">Stuck</MudChip>
                                    </MudTooltip>
                                    <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.LockOpen"
                                               OnClick="() => ClearStuck(context)">Clear</MudButton>
                                </div>
                            }
                            else if (context.IsRunning)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="() => RunNow(context)">Run now</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                </div>
            }

            <MudExpansionPanel Text="@($"Recent job history · {_runs.Count} runs")" Class="job-history">
                @if (_runs.Count == 0)
                {
                    <div class="activity-empty compact"><MudIcon Icon="@Icons.Material.Filled.History" /><strong>No runs yet</strong></div>
                }
                else
                {
                    <MudTable Items="_runs" dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="elevation-0">
                        <HeaderContent>
                            <MudTh>Job</MudTh>
                            <MudTh>Started</MudTh>
                            <MudTh>Duration</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Items</MudTh>
                            <MudTh>Message</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Job">@FriendlyJobName(context.JobType)</MudTd>
                            <MudTd DataLabel="Started">@context.StartedAt.ToLocalTime().ToString("g")</MudTd>
                            <MudTd DataLabel="Duration">@FormatDuration(context)</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="StatusColor(context.Status)">@FriendlyStatus(context.Status)</MudChip></MudTd>
                            <MudTd DataLabel="Items">@context.ItemsProcessed</MudTd>
                            <MudTd DataLabel="Message" Style="max-width:280px;white-space:normal;">@context.Message</MudTd>
                            <MudTd DataLabel="">@if (context.TriggeredManually) { <MudChip T="string" Size="Size.Small" Color="Color.Default">manual</MudChip> }</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudExpansionPanel>
        </MudTabPanel>

    </MudTabs>
    </div>
}

@code {
    private bool _loading = true;

    private List<WantedItemDto> _missing = new();
    private List<CutoffUnmetItemDto> _cutoff = new();
    private List<ScheduledJobDto> _scheduled = new();
    private List<JobRunDto> _runs = new();
    private int QueueCount => _missing.Count + _cutoff.Count;

    // Friendly interval presets shown in the Schedule picker, mapped to seconds.
    private readonly (string Label, int Seconds)[] _intervalOptions =
    {
        ("15 minutes", 900),
        ("30 minutes", 1800),
        ("1 hour", 3600),
        ("2 hours", 7200),
        ("6 hours", 21600),
        ("12 hours", 43200),
        ("1 day", 86400),
        ("2 days", 172800),
    };

    protected override async Task OnInitializedAsync() => await Reload();

    // Reloads every dataset; called on init and after every action so the tables stay in sync.
    private async Task Reload()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _missing = await Jobs.GetMissingAsync();
            _cutoff = await Jobs.GetCutoffUnmetAsync();
            _scheduled = await Jobs.GetScheduledJobsAsync();
            _runs = await Jobs.GetRecentRunsAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // --- Missing actions ---
    private async Task SearchMissing(WantedItemDto item)
    {
        if (await Jobs.SearchMissingNowAsync(item.JobId)) await Toasts.ShowSuccessAsync($"Searching for {item.Title}…");
        else await Toasts.ShowErrorAsync("Failed to start search.");
        await Reload();
    }

    private async Task GiveUp(WantedItemDto item)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Stop searching?",
            $"Plex Requests will permanently stop looking for \"{item.Title}\". The request will need to be submitted again if it is still wanted.",
            yesText: "Stop searching", cancelText: "Keep searching");
        if (confirmed != true) return;

        if (await Jobs.CancelMissingAsync(item.JobId)) await Toasts.ShowSuccessAsync($"Stopped searching for {item.Title}.");
        else await Toasts.ShowErrorAsync("Failed to cancel.");
        await Reload();
    }

    // --- Cutoff Unmet actions ---
    private async Task UpgradeNow(CutoffUnmetItemDto item)
    {
        if (await Jobs.UpgradeNowAsync(item.RequestId)) await Toasts.ShowSuccessAsync($"Upgrade search queued for {item.Title}.");
        else await Toasts.ShowErrorAsync("Failed to queue upgrade.");
        await Reload();
    }

    // --- Schedule actions ---
    private async Task ToggleEnabled(ScheduledJobDto job, bool enabled)
    {
        if (await Jobs.SetJobEnabledAsync(job.JobType, enabled)) await Toasts.ShowSuccessAsync($"{job.Name} {(enabled ? "enabled" : "disabled")}.");
        else await Toasts.ShowErrorAsync("Failed to update job.");
        await Reload();
    }

    private async Task ChangeInterval(ScheduledJobDto job, int seconds)
    {
        if (await Jobs.SetJobIntervalAsync(job.JobType, seconds)) await Toasts.ShowSuccessAsync($"{job.Name} interval updated.");
        else await Toasts.ShowErrorAsync("Failed to update interval.");
        await Reload();
    }

    private async Task RunNow(ScheduledJobDto job)
    {
        if (await Jobs.RunJobNowAsync(job.JobType)) await Toasts.ShowSuccessAsync($"{job.Name} will run shortly.");
        else await Toasts.ShowErrorAsync("Failed to trigger job.");
        await Reload();
    }

    private async Task BrowseReleases(WantedItemDto item)
    {
        var parameters = new DialogParameters<InteractiveSearchDialog>
        {
            { x => x.MediaRequestId, item.RequestId },
            { x => x.MediaType, item.MediaType },
            { x => x.MediaId, item.MediaId },
            { x => x.Title, item.Title },
            { x => x.Year, item.Year }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        var dialog = await Dialogs.ShowAsync<InteractiveSearchDialog>($"Releases for {item.Title}", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Reload();
    }

    private async Task ClearStuck(ScheduledJobDto job)
    {
        if (await Jobs.ClearRunningFlagAsync(job.JobType))
            await Toasts.ShowSuccessAsync($"{job.Name} unblocked; it will run shortly.");
        else
            await Toasts.ShowErrorAsync("Could not clear the running flag.");
        await Reload();
    }

    // --- Formatting helpers ---
    private static string FormatWhen(DateTime? when) => when is DateTime d ? d.ToLocalTime().ToString("g") : "—";

    private static string FormatMs(int ms) => ms switch
    {
        < 1000 => $"{ms}ms",
        < 60_000 => $"{ms / 1000.0:0.#}s",
        _ => $"{ms / 60000}m {ms % 60000 / 1000}s"
    };

    private static string FormatDuration(JobRunDto run)
        => run.FinishedAt is DateTime f
            ? (f - run.StartedAt).ToString(@"hh\:mm\:ss")
            : "running…";

    private static Color StatusColor(JobRunStatus status) => status switch
    {
        JobRunStatus.Succeeded => Color.Success,
        JobRunStatus.Failed => Color.Error,
        JobRunStatus.Running => Color.Info,
        _ => Color.Default, // Skipped
    };

    private static string FriendlyStatus(JobRunStatus status) => status switch
    {
        JobRunStatus.Succeeded => "Completed",
        JobRunStatus.Failed => "Failed",
        JobRunStatus.Running => "Running",
        _ => "Nothing due"
    };

    private static string FriendlyJobName(JobType type) => type switch
    {
        JobType.MissingSearch => "Retry missing requests",
        JobType.QualityUpgradeScan => "Find quality upgrades",
        JobType.SeriesMonitor => "Check monitored series",
        JobType.AvailabilityRefresh => "Refresh Plex availability",
        JobType.AvailabilityReconcile => "Match requests to Plex",
        JobType.StaleClaimReaper => "Recover interrupted downloads",
        JobType.SearchTaskCleanup => "Clean old search tasks",
        JobType.CalendarRefresh => "Refresh release calendar",
        JobType.AirDateMonitor => "Find newly aired episodes",
        JobType.RecomputeFormatScores => "Recalculate release scores",
        JobType.ApprovedRequestRepair => "Repair approved requests",
        _ => type.ToString()
    };
}
