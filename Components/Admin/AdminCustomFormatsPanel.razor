@using PlexRequestsHosted.Shared.DTOs
@using PlexRequestsHosted.Shared.Releases
@inject PlexRequestsHosted.Services.Implementations.ICustomFormatService Formats
@inject PlexRequestsHosted.Services.Abstractions.IToastService Toasts

@* User-defined scoring rules. A format matches when every REQUIRED condition matches and at least one
   optional one does; scores live per quality profile, so the same rule can be desirable in one profile and
   disqualifying in another. The test box at the top runs the identical matcher the downloader uses — it's
   pure, so there's no round-trip and no second implementation to disagree with. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-6"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Release name tester</MudText>
        <MudText Typo="Typo.caption" Class="text-muted d-block mb-2">
            Paste a real release name to see what Plex Requests recognizes and which enabled formats match it.
        </MudText>
        <div class="d-flex gap-2 align-items-start">
            <MudTextField T="string" @bind-Value="_testName" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="Severance.S02E07.2160p.WEB-DL.DV.HDR10+.TrueHD.Atmos.7.1.x265-NTb"
                          Immediate="true" DebounceInterval="300" Style="flex:1;" />
        </div>
        @if (!string.IsNullOrWhiteSpace(_testName))
        {
            var parsed = _parser.Parse(_testName);
            <div class="mt-2">
                <MudText Typo="Typo.caption" Class="text-muted">
                    parsed: title "@parsed.Title" · @(parsed.Resolution > 0 ? parsed.Resolution + "p" : "no resolution")
                    · @parsed.Source
                    @if (parsed.AudioCodec is not null) { <span> · @parsed.AudioCodec</span> }
                    @if (parsed.AudioChannels is not null) { <span> @parsed.AudioChannels</span> }
                    @if (parsed.HdrFormat != PlexRequestsHosted.Shared.Enums.HdrFormat.None) { <span> · @parsed.HdrFormat</span> }
                    @if (parsed.Edition is not null) { <span> · @parsed.Edition</span> }
                    @if (parsed.Languages.Count > 0) { <span> · @string.Join("/", parsed.Languages)</span> }
                    @if (parsed.Group is not null) { <span> · -@parsed.Group</span> }
                </MudText>
                <div class="d-flex flex-wrap gap-1 mt-2">
                    @foreach (var f in _formats.Where(f => f.Enabled && MatchesTest(f)))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">@f.Name</MudChip>
                    }
                    @if (!_formats.Any(f => f.Enabled && MatchesTest(f)))
                    {
                        <MudText Typo="Typo.caption" Class="text-muted">No format matches this release.</MudText>
                    }
                </div>
            </div>
        }
    </MudPaper>

    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
        Formats describe a release; Quality profiles decide whether that description is preferred or rejected.
        A format with no score is inactive.
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/admin?tab=downloads&sub=quality">Manage profile scores</MudButton>
    </MudAlert>

    <div class="format-section-heading">
        <div>
            <MudText Typo="Typo.h6">Your matching rules</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Create a rule only when the built-in formats do not describe what you need.</MudText>
        </div>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddFormat">New format</MudButton>
    </div>

    @if (CustomFormats.Count == 0)
    {
        <MudPaper Class="pa-4 text-center text-muted mb-4" Outlined="true">
            No custom matching rules. The built-in formats below cover common codecs, HDR, audio, repacks, and release traits.
        </MudPaper>
    }
    else
    {
        @foreach (var format in CustomFormats)
        {
            <AdminCustomFormatEditor @key="format.Id" Format="format"
                                     Expanded="@(_expandedFormatId == format.Id)"
                                     ExpandedChanged="@(expanded => SetExpanded(format.Id, expanded))"
                                     Changed="Save" Deleted="Delete" />
        }
    }

    <div class="format-builtins-heading">
        <div>
            <MudText Typo="Typo.h6">Built-in formats</MudText>
            <MudText Typo="Typo.body2" Class="text-muted">Ready-made matching rules maintained by Plex Requests.</MudText>
        </div>
        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                   StartIcon="@(_showBuiltIns ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="ToggleBuiltIns">
            @(_showBuiltIns ? "Hide built-ins" : $"Show {BuiltInFormats.Count} built-ins")
        </MudButton>
    </div>

    @if (_showBuiltIns)
    {
        @foreach (var format in BuiltInFormats)
        {
            <AdminCustomFormatEditor @key="format.Id" Format="format"
                                     Expanded="@(_expandedFormatId == format.Id)"
                                     ExpandedChanged="@(expanded => SetExpanded(format.Id, expanded))"
                                     Changed="Save" Deleted="Delete" />
        }
    }
}

@code {
    private bool _loading = true;
    private List<CustomFormatDto> _formats = new();
    private string _testName = string.Empty;
    private bool _showBuiltIns;
    private int? _expandedFormatId;
    private readonly ReleaseParser _parser = new();

    private List<CustomFormatDto> CustomFormats => _formats.Where(f => !f.IsSystem).ToList();
    private List<CustomFormatDto> BuiltInFormats => _formats.Where(f => f.IsSystem).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load(bool showSpinner = true)
    {
        if (showSpinner) _loading = true;
        _formats = await Formats.GetAllAsync();
        _loading = false;
    }

    /// <summary>Runs the shared matcher directly — it's pure, so the UI needs no round-trip.</summary>
    private bool MatchesTest(CustomFormatDto f)
    {
        if (string.IsNullOrWhiteSpace(_testName)) return false;
        var parsed = _parser.Parse(_testName);
        var candidate = new ReleaseCandidate
        {
            ReleaseName = _testName,
            Acquisition = AcquisitionResource.Torrent(string.Empty)
        };
        try { return CustomFormatMatcher.Matches(f, parsed, candidate); }
        catch { return false; }
    }

    private async Task Save(CustomFormatDto f)
    {
        var (ok, error) = await Formats.SaveAsync(f);
        if (!ok) await Toasts.ShowErrorAsync(error ?? "Save failed.");
        await Load(showSpinner: false);
    }

    private async Task AddFormat()
    {
        var existingIds = CustomFormats.Select(f => f.Id).ToHashSet();
        var (ok, error) = await Formats.SaveAsync(new CustomFormatDto
        {
            Name = $"New format {CustomFormats.Count + 1}",
            Enabled = false,   // nothing takes effect until it's been given conditions and a score
            Specifications = { new FormatSpecificationDto { Field = FormatField.ReleaseTitle, Op = FormatOp.Regex, Value = ".*" } }
        });
        if (!ok)
        {
            await Toasts.ShowErrorAsync(error ?? "Could not create the format.");
            return;
        }
        await Toasts.ShowInfoAsync("Format created disabled — add conditions, then enable it and give it a score in a profile.");
        await Load(showSpinner: false);
        _expandedFormatId = CustomFormats.FirstOrDefault(f => !existingIds.Contains(f.Id))?.Id;
    }

    private async Task Delete(CustomFormatDto f)
    {
        var (ok, error) = await Formats.DeleteAsync(f.Id);
        if (!ok) await Toasts.ShowErrorAsync(error ?? "Could not delete.");
        if (_expandedFormatId == f.Id) _expandedFormatId = null;
        await Load(showSpinner: false);
    }

    private void SetExpanded(int formatId, bool expanded) => _expandedFormatId = expanded ? formatId : null;
    private void ToggleBuiltIns() => _showBuiltIns = !_showBuiltIns;
}
