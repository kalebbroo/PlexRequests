@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined" dense="true" Class="mb-3">
            @_message
        </MudAlert>

        <div class="browser-frame">
            @if (_state is "connecting")
            {
                <div class="browser-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">Starting Chrome inside the downloader VPN…</MudText>
                </div>
            }
            <canvas id="@CanvasId" class="browser-canvas" tabindex="0"
                    aria-label="Interactive 1337x browser running in the downloader container"></canvas>
        </div>

        <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mt-2 d-block">
            This is the persistent Chrome profile used by scheduled 1337x searches. Click directly in the
            image to complete the human check. Closing this window disconnects the viewer but keeps the
            verified browser profile and session.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="Reload" Disabled="@(!_connected)">Reload 1337x</MudButton>
        <MudSpacer />
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.VerifiedUser"
                   OnClick="Verify" Disabled="@(!_connected)">Verify session</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string CanvasId = "indexer-browser-canvas";
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private DotNetObjectReference<IndexerBrowserDialog>? _reference;
    private string _state = "connecting";
    private string _message = "Connecting to Chrome inside the downloader VPN…";
    private bool _connected;

    private Severity StatusSeverity => _state switch
    {
        "verified" => Severity.Success,
        "challenge" or "busy" => Severity.Warning,
        "error" or "disconnected" => Severity.Error,
        _ => Severity.Info
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("plexBrowser.start", CanvasId, _reference);
    }

    [JSInvokable]
    public Task OnBrowserStatus(string state, string message)
    {
        _state = state;
        _message = string.IsNullOrWhiteSpace(message) ? "Browser status updated." : message;
        _connected = state is "connected" or "challenge" or "verified";
        return InvokeAsync(StateHasChanged);
    }

    private Task Verify() => JS.InvokeVoidAsync("plexBrowser.command", CanvasId, "verify").AsTask();
    private Task Reload() => JS.InvokeVoidAsync("plexBrowser.command", CanvasId, "reload").AsTask();

    private async Task Close()
    {
        await StopAsync();
        MudDialog.Close(DialogResult.Ok(_state == "verified"));
    }

    private async Task StopAsync()
    {
        try { await JS.InvokeVoidAsync("plexBrowser.stop", CanvasId); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
        _reference?.Dispose();
    }
}
