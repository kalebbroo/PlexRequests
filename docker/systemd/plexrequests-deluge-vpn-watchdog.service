[Unit]
Description=Plex Requests Deluge VPN rebind watchdog
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/plexrequests-deluge-vpn-watchdog
Environment=STATE_DIR=/var/lib/plexrequests-deluge-vpn
ExecStart=/bin/sh /usr/local/sbin/plexrequests-deluge-vpn-watchdog
TimeoutStartSec=30
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=plexrequests-deluge-vpn
StateDirectoryMode=0700
